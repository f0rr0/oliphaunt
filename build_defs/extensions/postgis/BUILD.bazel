load("//build_defs/foundation:bun.bzl", "bun_binary")
load(":sqlite.bzl", "postgis_sqlite")
load(":libraries.bzl", "postgis_geos", "postgis_iconv", "postgis_json_c", "postgis_libxml2", "postgis_proj")
load(":proj_db.bzl", "proj_database")
load(":modules.bzl", "postgis_dependency_module", "postgis_standalone")
load(":sql.bzl", "postgis_sql")

package(default_visibility = ["//visibility:public"])

exports_files(glob(["*.bzl", "*.mts"]))
bun_binary(name = "sqlite_generate", entry_point = "sqlite_generate.mts")
bun_binary(name = "configure_headers", entry_point = "configure_headers.mts")
bun_binary(name = "proj_db", entry_point = "proj_db.mts")
bun_binary(name = "sql", entry_point = "sql.mts")
postgis_sqlite(name = "sqlite")
postgis_geos(name = "geos")
postgis_json_c(name = "json_c")
postgis_proj(name = "proj", sqlite = ":sqlite")
postgis_iconv(name = "iconv")
postgis_libxml2(name = "libxml2", iconv = ":iconv")
proj_database(name = "database")
postgis_standalone(name = "postgis")
postgis_dependency_module(name = "dependency_module")
postgis_sql(name = "sql_resources", configuration = ":postgis_config", headers = ":postgis_headers")
filegroup(name = "extension_sql", srcs = [":sql_resources"], output_group = "extension_sql")
filegroup(name = "data_sql", srcs = [":sql_resources"], output_group = "data_sql")
filegroup(name = "control", srcs = [":postgis_config"], output_group = "control")
