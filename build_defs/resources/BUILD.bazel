load("//build_defs/quality:sources.bzl", "source_quality_files")
load("//build_defs/foundation:bun.bzl", "bun_binary", "bun_test")
load("@rules_cc//cc:defs.bzl", "cc_binary")
load("//build_defs/native:platform_config.bzl", "NATIVE_COMPATIBLE")
load("//build_defs/native/carriers:defs.bzl", "native_carrier_legal_inputs")

package(default_visibility = ["//visibility:public"])

exports_files(glob(["*.bzl", "*.mts"]))

filegroup(name = "helpers", srcs = [
    "shared.mts",
    "seed_construction.mts",
    "wasix_inputs.mts",
    "//build_defs/native:host-runtime-test-helpers.mts",
    "//src/database-resources:contracts/contract.json",
    "//src/database-resources:contracts/icu-data.mts",
    "//src/database-resources:contracts/native-manifest.mts",
    "//src/database-resources:seeds/carrier-identities.mts",
    "//src/database-resources:seeds/native/tools/stage-native-cluster-seed.mts",
    "//src/database-resources:seeds/package-carriers.mts",
    "//src/database-resources:seeds/package-mobile-carriers.mts",
    "//src/database-resources:seeds/package.mts",
    "//src/database-resources/icu:tools/icu-npm-carrier-contract.mts",
    "//src/database-resources/icu:tools/package-cargo.mts",
    "//src/database-resources/icu:tools/package-npm.mts",
    "//src/database-resources/icu:tools/write-icu-package-size-report.mts",
    "//:src/extensions/artifacts/packages/tools/contrib-carriers.mts",
    "//:src/extensions/artifacts/packages/tools/extension-registry-packages.mts",
    "//src/extensions/contracts:extension-target-profiles.mts",
    "//src/extensions/tools:extension-upstream-licenses.mts",
    "//src/native/mobile-bindings:tools/dependency-license-contract.mts",
    "//src/native/runtime:tools/native-mobile-abi-contract.mts",
    "//src/wasix/runtime:tools/wasix-cargo-artifact-contract.mts",
    "//src/wasix/runtime:tools/wasix-runtime-npm-contract.mts",
    "//src/wasix/runtime:tools/wasix-runtime-npm-descriptor.mts",
    "//src/wasix/runtime:tools/wasix-runtime-npm-payload.mts",
    "//:tools/packaging/archive-directory.mts",
    "//:tools/packaging/platform-binary-contract.mts",
    "//:tools/packaging/atomic-directory.mts",
    "//:tools/packaging/build-maven-artifact-manifest.mts",
    "//:tools/packaging/cargo-source-package.mts",
    "//:tools/packaging/cargo-manifest.mts",
    "//:tools/packaging/maven-artifact-manifest.mts",
    "//:tools/packaging/maven-artifact-staging.mts",
    "//:tools/packaging/maven-central-contract.mts",
    "//:tools/packaging/npm-package.mts",
    "//:tools/packaging/npm-trusted-publishing.mts",
    "//:tools/packaging/package-archive.mts",
    "//:tools/packaging/portable-archive.mts",
    "//:tools/packaging/release-carrier.mts",
    "//:tools/packaging/sdk-runtime-payload.mts",
    "//:tools/packaging/release-directory-safety.mts",
    "//:tools/packaging/release-notices.mts",
    "//:tools/packaging/rust-dependency-license-contract.mts",
    "//:tools/packaging/wasix-cargo-payload.mts",
    "//:tools/packaging/windows-vc-runtime-closure.mts",
    "//:tools/packaging/windows-vc-runtime-policy.json",
    "//tools/release:compatibility-version-parser.mts",
    "//tools/release:compatibility-version-policy.mts",
    "//tools/release:extension-release-metadata.mts",
    "//tools/release:platform-compatibility-policy.mts",
    "//tools/release:product-version.mts",
    "//tools/release:native-file-identity.mts",
    "//tools/release:release-artifact-targets.mts",
    "//tools/release:release-graph.mts",
    "//tools/release:release-history.mts",
])

BOOTSTRAP_HELPERS = [
    "shared.mts", "seed_construction.mts", "//build_defs/native:host-runtime-test-helpers.mts",
    "//tools/release:native-file-identity.mts", "//:tools/packaging/release-directory-safety.mts",
    "//:tools/packaging/portable-archive.mts",
    "//:tools/packaging/archive-directory.mts",
    "//:tools/packaging/platform-binary-contract.mts",
    "//:tools/packaging/windows-vc-runtime-closure.mts",
    "//:tools/packaging/windows-vc-runtime-policy.json",
    "//tools/release:platform-compatibility-policy.mts",
    "//src/native/runtime:tools/native-mobile-abi-contract.mts",
    "//src/database-resources:seeds/native/tools/stage-native-cluster-seed.mts",
    "//src/database-resources:contracts/native-manifest.mts",
    "//src/database-resources:contracts/icu-data.mts",
    "//src/database-resources:contracts/contract.json",
]

bun_binary(name = "native_seed", entry_point = "native_seed.mts", data = BOOTSTRAP_HELPERS)
bun_binary(name = "wasix_seed", entry_point = "wasix_seed.mts", data = [":helpers"])
bun_binary(name = "seed_domain", entry_point = "seed_domain.mts", data = BOOTSTRAP_HELPERS)
bun_binary(name = "abi_receipt", entry_point = "abi_receipt.mts", data = [
    "shared.mts", "//build_defs/native:host-runtime-test-helpers.mts",
    "//:tools/packaging/portable-archive.mts",
    "//src/native/runtime:tools/native-mobile-abi-contract.mts",
    "//:tools/packaging/platform-binary-contract.mts", "//:tools/packaging/windows-vc-runtime-closure.mts",
    "//:tools/packaging/windows-vc-runtime-policy.json", "//tools/release:platform-compatibility-policy.mts",
])
[bun_binary(name = name, entry_point = name + ".mts", data = [":helpers"])
 for name in ["icu_payload", "seed_assets", "carriers"]]

cc_binary(
    name = "seed_consumer",
    srcs = ["seed_consumer.c"],
    deps = ["//src/native/runtime:liboliphaunt", "@postgres//:server_headers", "@postgres//:port_frontend"],
    copts = select({"//build_defs/native:windows_x64": ["/std:c11", "/W4", "/WX"], "//conditions:default": ["-std=c11", "-Wall", "-Wextra", "-Werror"]}),
    target_compatible_with = NATIVE_COMPATIBLE,
)

bun_test(name = "resource_contract_test", entry_point = "resource_contract.test.mts", data = [
    ":helpers", "seed_domain.mts", "seed_assets.mts", "seed-construction-fixture.mts", "//src/database-resources:cluster_seed_contract_fixtures",
    "//:LICENSE", "//src/third-party/icu:LICENSE", "//src/third-party/icu:source.toml",
], size = "small")

bun_test(name = "seed_construction_test", entry_point = "seed_construction.test.mts", data = [":helpers", "seed-construction-fixture.mts"], size = "small")
bun_test(name = "seed_domain_test", entry_point = "seed_domain.test.mts", data = [":helpers", "seed_domain.mts"], size = "small")

bun_test(name = "mobile_resource_contract_test", entry_point = "mobile_resource_contract.test.mts", data = [
    ":helpers", "mobile_resource_contract.mts", "//:tools/packaging/testdata/tar-fixture.mts",
] + native_carrier_legal_inputs().keys(), size = "small")

source_quality_files()

# Source-only inputs for the existing SDK package policy tests.
exports_files([
    "seed_construction.mts",
], visibility = ["//visibility:public"])
