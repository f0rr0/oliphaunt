+def compiler_plugin_search_path_configurator(default_directory, developer_search_only = False):
+    """Adds the default plugin path unless the toolchain supplies its own."""
+    return lambda prerequisites, args: _add_compiler_plugin_search_path(
+        prerequisites,
+        args,
+        default_directory,
+        developer_search_only,
+    )
+
+def _add_compiler_plugin_search_path(prerequisites, args, default_directory, developer_search_only):
+    if getattr(prerequisites, "compiler_plugin_directory", None) != None:
+        return
+    if developer_search_only and not prerequisites.include_dev_srch_paths:
+        return
+    args.add("-plugin-path", default_directory)
 
