+def _windows_dependency_files(ctx, toolchain, crate_info, dep_info):
+    """Consolidates static crate search paths on Windows compiler hosts."""
+    if toolchain.exec_triple.system != "windows":
+        return None
+
+    # https://github.com/bazelbuild/rules_rust/issues/3767: rustc extends PATH with -L directories.
+    # Remove after upgrading to upstream Windows dependency path consolidation that preserves configured artifacts.
+    use_metadata = _depend_on_metadata(crate_info, False)
+    dependency_files = []
+    for index, crate in enumerate(dep_info.transitive_crates.to_list()):
+        artifact = crate.metadata if use_metadata else crate.output
+        if not artifact or (use_metadata and not crate.metadata_supports_pipelining):
+            artifact = crate.output
+        if artifact.extension in ("rlib", "rmeta"):
+            # Keep the crate prefix; the ordinal preserves same-basename configured artifacts.
+            stem = artifact.basename[:-len(artifact.extension) - 1]
+            alias = ctx.actions.declare_file("_rust_deps/{}/{}-{}.{}".format(
+                crate_info.output.basename,
+                stem,
+                index,
+                artifact.extension,
+            ))
+            ctx.actions.symlink(output = alias, target_file = artifact)
+            dependency_files.append(alias)
+        else:
+            # DLLs retain their original directories for native dependency lookup.
+            dependency_files.append(artifact)
+    return dependency_files
+
