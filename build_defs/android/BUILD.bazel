load("//build_defs/quality:sources.bzl", "source_quality_files")
load("@rules_cc//cc:defs.bzl", "cc_binary")
load("//build_defs/foundation:bun.bzl", "bun_test")
load(":toolchain.bzl", "android_artifact")

package(default_visibility = ["//visibility:public"])

exports_files(glob(["*.bzl", "*.mts", "*.bazel"]))

constraint_setting(name = "ndk_profile")
constraint_value(name = "ndk_runtime", constraint_setting = ":ndk_profile")

platform(name = "android_arm64", constraint_values = ["@platforms//os:android", "@platforms//cpu:aarch64", ":ndk_runtime"])
platform(name = "android_x86_64", constraint_values = ["@platforms//os:android", "@platforms//cpu:x86_64", ":ndk_runtime"])

# Registration metadata is local and small: unrelated target/platform analysis
# does not acquire the NDK just to discover its execution constraints.
[toolchain(
    name = "toolchain_" + name,
    toolchain = "@android_ndk//:cc_" + name,
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
    exec_compatible_with = ["@platforms//os:linux", "@platforms//cpu:x86_64"],
    target_compatible_with = ["@platforms//os:android", "@platforms//cpu:" + cpu, ":ndk_runtime"],
) for name, cpu in [("arm64", "aarch64"), ("x86_64", "x86_64")]]

[cc_binary(
    name = "libabi_smoke_" + name + ".so",
    srcs = ["abi-smoke.cc"],
    additional_linker_inputs = ["//src/native/runtime:bin/android-cxx-runtime.map"],
    linkopts = ["-Wl,--exclude-libs,libc++_static.a:libc++abi.a:libunwind.a", "-Wl,--version-script,$(location //src/native/runtime:bin/android-cxx-runtime.map)"],
    linkshared = True,
    linkstatic = True,
    target_compatible_with = ["@platforms//os:android", "@platforms//cpu:" + cpu, ":ndk_runtime"],
) for name, cpu in [("arm64", "aarch64"), ("x86_64", "x86_64")]]

[android_artifact(
    name = "abi_" + name,
    artifact = ":libabi_smoke_" + name + ".so",
    platform = ":android_" + name,
) for name in ["arm64", "x86_64"]]

bun_test(
    name = "metadata_test",
    size = "small",
    entry_point = "metadata.test.mts",
    data = ["metadata.mts", "native-metadata.mts", "//tools/release:platform-compatibility-policy.mts"],
)

bun_test(
    name = "abi_test",
    size = "small",
    entry_point = "abi.test.mts",
    data = [":abi_arm64", ":abi_x86_64", "//:tools/packaging/platform-binary-contract.mts", "//:tools/packaging/windows-vc-runtime-closure.mts", "//:tools/packaging/windows-vc-runtime-policy.json", "//tools/release:platform-compatibility-policy.mts"],
)

source_quality_files()

# Add to the existing Android support package after root source barrier.
exports_files(["expo_maven_install.json", "expo_jna_maven_install.json", "rules-jvm-external-android-gradle.patch"])
alias(name = "resolver_junit", actual = "@oliphaunt_kotlin_maven//:junit_junit", testonly = True)
bun_test(
    name = "app_action_test",
    entry_point = "app.test.mts",
    data = ["app.mts", "//:tools/packaging/archive-directory.mts", "//:tools/packaging/portable-archive.mts"],
    size = "small",
)
