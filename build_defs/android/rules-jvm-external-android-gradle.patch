+// Exact matching policy from KotlinPlatformType in the pinned Kotlin 2.2.21 API:
+// https://github.com/JetBrains/kotlin/blob/v2.2.21/libraries/tools/kotlin-gradle-plugin-api/src/common/kotlin/org/jetbrains/kotlin/gradle/plugin/KotlinPlatformType.kt
+class KotlinPlatformCompatibility implements org.gradle.api.attributes.AttributeCompatibilityRule<String> {
+    void execute(org.gradle.api.attributes.CompatibilityCheckDetails<String> details) {
+        if (details.producerValue == 'jvm' && details.consumerValue == 'androidJvm') details.compatible()
+        if (details.consumerValue == 'common') details.compatible()
+    }
+}
+class KotlinPlatformDisambiguation implements org.gradle.api.attributes.AttributeDisambiguationRule<String> {
+    void execute(org.gradle.api.attributes.MultipleCandidatesDetails<String> details) {
+        if (details.candidateValues.contains(details.consumerValue)) {
+            details.closestMatch(details.consumerValue)
+        } else if (details.consumerValue == null && details.candidateValues.containsAll(['androidJvm', 'jvm'])) {
+            details.closestMatch('jvm')
+        } else if (details.candidateValues.contains('common') && !details.candidateValues.contains('jvm') &&
+                !details.candidateValues.contains('androidJvm')) {
+            details.closestMatch('common')
+        }
+    }
+}
+def kotlinPlatform = org.gradle.api.attributes.Attribute.of('org.jetbrains.kotlin.platform.type', String)
+dependencies.attributesSchema.attribute(kotlinPlatform) {
+    compatibilityRules.add(KotlinPlatformCompatibility)
+    disambiguationRules.add(KotlinPlatformDisambiguation)
+}
+configurations.create('bazelAndroidRuntimeClasspath') {
+    canBeResolved = true
+    canBeConsumed = false
+    extendsFrom(configurations.implementation)
+    attributes {
+        attribute(kotlinPlatform, 'androidJvm')
+        attribute(org.gradle.api.attributes.Usage.USAGE_ATTRIBUTE,
+            objects.named(org.gradle.api.attributes.Usage,
+                org.gradle.api.attributes.Usage.JAVA_RUNTIME))
+        attribute(org.gradle.api.attributes.Category.CATEGORY_ATTRIBUTE,
+            objects.named(org.gradle.api.attributes.Category,
+                org.gradle.api.attributes.Category.LIBRARY))
+        attribute(org.gradle.api.attributes.java.TargetJvmEnvironment.TARGET_JVM_ENVIRONMENT_ATTRIBUTE,
+            objects.named(org.gradle.api.attributes.java.TargetJvmEnvironment,
+                org.gradle.api.attributes.java.TargetJvmEnvironment.ANDROID))
+    }
+}
+{{~/if}}
