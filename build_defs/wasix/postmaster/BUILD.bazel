load("//build_defs/foundation:bun.bzl", "bun_script_test", "bun_test")
load(":postgres-overlay-test.bzl", "postgres_overlay_tests")
load("@postmaster_compile_metadata//:cargo.bzl", "POSTMASTER_CARGO")

package(default_visibility = ["//visibility:public"])

exports_files(glob(["*.bzl", "*.mts", "*.patch"]))

exports_files(["postgres.BUILD.bazel", "libc.BUILD.bazel"])

postgres_overlay_tests()

bun_test(
    name = "libc_metadata_test",
    entry_point = "libc-metadata.test.mts",
    data = ["libc-metadata.mts"],
    size = "small",
)

bun_test(
    name = "libc_headers_test",
    entry_point = "libc-headers.test.mts",
    data = ["libc-headers.mts", "testdata/mkalltypes.sed"],
    size = "small",
)

bun_test(
    name = "source_modes_test",
    entry_point = "source-modes.test.mts",
    data = ["source-modes.mts"],
    size = "small",
    target_compatible_with = ["@platforms//os:linux"],
)

alias(name = "llvm_zstd", actual = POSTMASTER_CARGO["compiler_zstd"])

bun_test(
    name = "compile_metadata_test",
    entry_point = "compile-metadata.test.mts",
    data = ["compile-metadata.mts"],
    size = "small",
)

bun_test(
    name = "runtime_abi_test",
    entry_point = "runtime-abi.test.mts",
    data = ["runtime-abi.mts", "compile-metadata.mts"],
    size = "small",
)

bun_test(
    name = "metadata_test",
    entry_point = "metadata.test.mts",
    data = ["metadata.mts", "//:tools/packaging/cargo-manifest.mts"],
    size = "small",
)

bun_script_test(
    name = "cargo_source_projection_test",
    entry_point = "cargo-source-projection-test.mts",
    data = [
        "@postmaster_cargo//:cargo-sources.json",
        "@postmaster_cargo//:executor/Cargo.toml",
        "@postmaster_cargo//:executor/Cargo.lock",
        "@postmaster_cargo//:compiler/Cargo.toml",
        "@postmaster_cargo//:compiler/Cargo.lock",
        "@postmaster_executor_crates//:cargo-bazel.json",
        "@postmaster_executor_crates//:crates.bzl",
        "@postmaster_compiler_crates//:cargo-bazel.json",
        "@postmaster_compiler_crates//:crates.bzl",
        "//src/wasix/postmaster:executor/Cargo.toml",
        "//src/wasix/postmaster:executor/Cargo.lock",
    ],
    size = "small",
)
