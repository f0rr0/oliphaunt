load("@oliphaunt//build_defs/wasix/postmaster:postgres.bzl", "postgres_postmaster_targets")
load(":version.bzl", "POSTGRES_VERSION")

package(default_visibility = ["//visibility:public"])

exports_files(["SOURCE_VERSION", "version.bzl", "patches.bzl"] + glob(["src/**"]))

# Immutable source acquisition is proved independently before compilation.
filegroup(
    name = "source_tree",
    srcs = glob(["**"], exclude = ["BUILD.bazel", "SOURCE_VERSION", "version.bzl", "patches.bzl"]),
)

postgres_postmaster_targets(POSTGRES_VERSION)
