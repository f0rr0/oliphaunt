load("@rules_cc//cc:defs.bzl", "cc_library")
load("@oliphaunt//build_defs/wasix:postgres.bzl", "postgres_wasix_targets")
load(":version.bzl", "POSTGRES_VERSION")

package(default_visibility = ["//visibility:public"])

exports_files(glob(["contrib/**", "src/include/**/*.h"]))

# These real patched headers supply the SysV declarations used by the bridge
# and by PostgreSQL's wasm32 port; they are absent from the WASIX libc sysroot.
cc_library(
    name = "port_headers",
    linkstatic = True,
    hdrs = glob(["src/include/port/wasix-dl/**/*.h"]),
    includes = ["src/include/port/wasix-dl"],
    target_compatible_with = ["@platforms//cpu:wasm32", "@platforms//os:wasi"],
)

postgres_wasix_targets(version = POSTGRES_VERSION)
