load("@rules_cc//cc:defs.bzl", "cc_toolchain")
load("@oliphaunt//build_defs/wasix:toolchain.bzl", "wasix_cc_toolchain_config")

package(default_visibility = ["//visibility:public"])

exports_files(["ASSETS.tsv"] + glob(["bin/*", "llvm/bin/*", "binaryen/bin/*"]))

filegroup(name = "empty")
filegroup(name = "compiler_files", srcs = glob(["bin/*", "driver/*", "llvm/**", "sysroot/**"]))
filegroup(name = "llvm_files", srcs = glob(["llvm/**"]))
filegroup(name = "linker_files", srcs = [":llvm_files"] + glob(["sysroot/sysroot-exnref-ehpic/**"]))
filegroup(name = "binaryen_files", srcs = glob(["binaryen/**"]))
# ASSETS.tsv records all supported source pins for inspection. Unused sysroot
# identities and the separate optimizer are not C compiler action inputs.
filegroup(name = "all_files", srcs = [":compiler_files"])

wasix_cc_toolchain_config(
    name = "config",
    compiler = "bin/wasixcc",
    llvm_compiler = "llvm/bin/clang",
    optimizer = "binaryen/bin/wasm-opt",
    sysroot_header = "sysroot/sysroot-exnref-ehpic/include/stdio.h",
)

cc_toolchain(
    name = "compiler",
    toolchain_identifier = "oliphaunt-wasix-linux-x86_64",
    toolchain_config = ":config",
    all_files = ":all_files",
    ar_files = ":compiler_files",
    as_files = ":compiler_files",
    compiler_files = ":compiler_files",
    dwp_files = ":empty",
    linker_files = ":compiler_files",
    objcopy_files = ":empty",
    strip_files = ":empty",
    supports_param_files = 0,
)
