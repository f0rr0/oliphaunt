+def _project_configured_target_features(metadata, supported_platform_triples):
+    # cargo tree already resolved configured target features; translate only
+    # predicates the platform-only generator cannot evaluate.
+    packages = {package["id"]: package for package in metadata["packages"]}
+    tree = metadata["metadata"]["cargo-bazel"]["tree_metadata"]
+    for node in metadata["resolve"]["nodes"]:
+        parent = packages[node["id"]]
+        dependencies = []
+        for dependency in node["deps"]:
+            unsupported = [
+                kind
+                for kind in dependency["dep_kinds"]
+                if kind["target"] and "target_feature" in kind["target"]
+            ]
+            if not unsupported:
+                dependencies.append(dependency)
+                continue
+            declarations = [
+                declared
+                for declared in parent["dependencies"]
+                if (declared["rename"] or declared["name"]).replace("-", "_") == dependency["name"] and
+                   declared["kind"] == unsupported[0]["kind"] and
+                   declared["target"] == unsupported[0]["target"]
+            ]
+            if len(unsupported) != 1 or len(declarations) != 1:
+                fail("Ambiguous configured target-feature dependency in " + parent["id"])
+            # The maintained generator already uses cargo tree for optional deps.
+            if declarations[0]["optional"]:
+                dependencies.append(dependency)
+                continue
+            if len(dependency["dep_kinds"]) != 1 or unsupported[0]["kind"] != None:
+                fail("Configured target-feature projection requires one normal dependency kind in " + parent["id"])
+            child = packages[dependency["pkg"]]
+            child_id = child["name"] + " " + child["version"]
+            resolved = tree.get(parent["name"] + " " + parent["version"])
+            if resolved == None:
+                fail("Missing standard Cargo tree for configured target-feature dependency in " + parent["id"])
+            common = (resolved["common"] or {}).get("deps", [])
+            selected = [
+                triple
+                for triple in supported_platform_triples
+                if child_id in common or child_id in resolved["selects"].get(triple, {}).get("deps", [])
+            ]
+            if selected:
+                dependencies.append(dict(dependency, dep_kinds = [{"kind": None, "target": triple} for triple in selected]))
+        node["deps"] = dependencies
+
