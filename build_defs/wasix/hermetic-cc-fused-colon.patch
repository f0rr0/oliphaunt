+test "zig-wrapper:colon-libraries" {
+    var arena = std.heap.ArenaAllocator.init(testing.allocator);
+    defer arena.deinit();
+    const allocator = arena.allocator();
+    var tmp = testing.tmpDir(.{});
+    defer tmp.cleanup();
+    try tmp.dir.makeDir("sdk");
+    try tmp.dir.writeFile(.{ .sub_path = "sdk/libpresent.so.1", .data = "" });
+
+    var args = ArrayListUnmanaged([]const u8){};
+    try args.appendSlice(allocator, &[_][]const u8{
+        "zig",                "-L", "missing",          "-Lsdk",              "-l", ":libpresent.so.1",
+        "-l:libpresent.so.1", "-l", ":libmissing.so.1", "-l:libmissing.so.1",
+    });
+    try resolveColonLibraries(allocator, tmp.dir, &args);
+    const present = try fs.path.join(allocator, &[_][]const u8{ "sdk", "libpresent.so.1" });
+    const expected = [_][]const u8{
+        "zig", "-L",               "missing",            "-Lsdk", present, present,
+        "-l",  ":libmissing.so.1", "-l:libmissing.so.1",
+    };
+    try testing.expectEqual(expected.len, args.items.len);
+    for (expected, args.items) |want, got| try testing.expectEqualStrings(want, got);
+
+    // The fused form also works when it is the last argument and -L is split.
+    args.clearRetainingCapacity();
+    try args.appendSlice(allocator, &[_][]const u8{ "zig", "-L", "sdk", "-l:libpresent.so.1" });
+    try resolveColonLibraries(allocator, tmp.dir, &args);
+    try testing.expectEqualStrings(present, args.items[3]);
+}
