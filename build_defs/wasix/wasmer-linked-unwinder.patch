+    // Native ELF toolchains can link LLVM libunwind with hidden symbols,
+    // making the existing dlsym probe miss the actual linked implementation.
+    #[cfg(all(target_os = "linux", oliphaunt_linked_libunwind))]
+    {
+        unsafe extern "C" {
+            fn oliphaunt_wasmer_has_linked_libunwind() -> libc::c_int;
+        }
+        if unsafe { oliphaunt_wasmer_has_linked_libunwind() } != 0 {
+            return true;
+        }
+    }
+
