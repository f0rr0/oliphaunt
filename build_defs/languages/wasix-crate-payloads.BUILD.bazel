# Appended by crate_universe inside the same checksum-locked registry repository
# that supplies the release library. These are public crate payload directories,
# rather than current workspace producer outputs.
filegroup(
    name = "payload_files",
    srcs = ["Cargo.toml"] + glob(
        ["payload/**", "artifacts/**", "manifests/**"],
        allow_empty = False,
    ),
    visibility = ["//visibility:public"],
)
