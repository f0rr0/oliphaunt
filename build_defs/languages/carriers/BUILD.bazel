load("//build_defs/quality:sources.bzl", "source_quality_files")
load("@javascript_consumer_packages//:roots.bzl", "CONSUMER_PACKAGES", "CONSUMER_TOOLS")
load("//build_defs/languages/ts:defs.bzl", "npm_dependency_closure")
load("@rules_cc//cc:defs.bzl", "cc_binary")
load("//build_defs/foundation:bun.bzl", "bun_script_test")
load("//build_defs/native:platform_config.bzl", "NATIVE_COMPATIBLE")
load(":defs.bzl", "native_helper_test_data", "native_helper_unit_inputs", "native_installed_sql_test")

package(default_visibility = ["//visibility:public"])

exports_files(glob(["*.bzl", "*.mts"]))

native_helper_unit_inputs(name = "unit_inputs")

# A tiny constructed host binary exercises envelope formatting. Installed SQL below
# separately consumes the actual Rust addon and broker, never this fixture.
cc_binary(name = "envelope_fixture", srcs = ["envelope-fixture.c"], target_compatible_with = NATIVE_COMPATIBLE)

bun_script_test(
    name = "package_test",
    entry_point = "package.test.mts",
    args = ["$(location :unit_inputs)", "$(location :envelope_fixture)"],
    data = [":unit_inputs", ":envelope_fixture"] + native_helper_test_data(),
    target_compatible_with = NATIVE_COMPATIBLE,
    size = "small",
)

_PG_ROOT = CONSUMER_TOOLS["@oliphaunt/ts"]["pg"]
_PG_PACKAGES = npm_dependency_closure(CONSUMER_PACKAGES, [_PG_ROOT])

native_installed_sql_test(
    name = "installed_sql_test",
    sdk = "//src/native/sdks/ts:npm",
    query = "//src/query/ts:npm",
    addon = "//src/native/node-addon:npm",
    broker = "//src/native/broker:npm",
    runtime = select({
        "//build_defs/native:linux_x86_64": "@node_frozen_native//:archive",
        "//build_defs/native:linux_aarch64_gnu_2_28": "@node_frozen_native_linux_arm64_gnu//:archive",
        "//build_defs/native:macos_arm64": "@node_frozen_native_macos_arm64//:archive",
        "//build_defs/native:windows_x64": "@node_frozen_native_windows_x64_msvc//:archive",
    }),
    artifact_crate = "//src/native/broker:artifact_crate",
    server_packages = {"@javascript_consumer_packages//:" + key: key for key in _PG_PACKAGES},
    server_metadata = {key: json.encode(CONSUMER_PACKAGES[key]) for key in _PG_PACKAGES},
    server_roots = {"pg": _PG_ROOT},
    restricted_launcher = select({"//build_defs/native:windows_x64": "//build_defs/native:windows_restricted_process", "//conditions:default": None}),
    deno = select({"//build_defs/native:linux_x86_64": "@deno_linux_x64//:deno", "//conditions:default": None}),
    contract_hosts = select({"//build_defs/native:linux_x86_64": ["node", "bun", "deno"], "//conditions:default": ["node"]}),
    target_compatible_with = NATIVE_COMPATIBLE,
    size = "medium",
)

source_quality_files()
