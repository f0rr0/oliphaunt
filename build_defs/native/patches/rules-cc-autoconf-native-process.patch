+#ifndef RULES_CC_AUTOCONF_NATIVE_PROCESS_H
+#define RULES_CC_AUTOCONF_NATIVE_PROCESS_H
+
+#include <cerrno>
+#include <filesystem>
+#include <stdexcept>
+#include <string>
+#include <system_error>
+#include <vector>
+
+#ifdef _WIN32
+#include <windows.h>
+#else
+#include <fcntl.h>
+#include <spawn.h>
+#include <sys/wait.h>
+#include <unistd.h>
+extern char** environ;
+#endif
+
+namespace rules_cc_autoconf {
+
+// The maintained numeric probes catch runtime_error for an unknown expression.
+// Infrastructure failures must bypass that legitimate optional-result handler.
+class NativeProcessError : public std::logic_error {
+ public:
+    using std::logic_error::logic_error;
+};
+
+inline NativeProcessError native_process_error(const std::string& context, int code) {
+    return NativeProcessError(context + ": " +
+                              std::error_code(code, std::generic_category()).message());
+}
+
+// A compiler's ordinary nonzero exit is a negative feature result. A failed
+// process launch, signal, broken output path or wrapper failure is a broken
+// construction environment and must fail the action instead.
+inline int run_native_process(const std::vector<std::string>& args,
+                              bool quiet = true,
+                              const std::string& stdout_path = "") {
+    if (args.empty() || args.front().empty()) {
+        throw NativeProcessError("native probe has no declared executable");
+    }
+#ifdef _WIN32
+    // CreateProcess uses the CRT command-line convention, not cmd.exe syntax.
+    auto quote = [](const std::string& value) {
+        std::string result = "\"";
+        size_t slashes = 0;
+        for (char c : value) {
+            if (c == '\\') {
+                ++slashes;
+            } else {
+                result.append(slashes * (c == '"' ? 2 : 1), '\\');
+                slashes = 0;
+                if (c == '"') result += '\\';
+                result += c;
+            }
+        }
+        result.append(slashes * 2, '\\');
+        return result + '"';
+    };
+    std::string command;
+    for (const auto& arg : args) {
+        if (!command.empty()) command += ' ';
+        command += quote(arg);
+    }
+    SECURITY_ATTRIBUTES security{sizeof(security), nullptr, TRUE};
+    HANDLE null_output = INVALID_HANDLE_VALUE;
+    HANDLE file_output = INVALID_HANDLE_VALUE;
+    if (quiet) {
+        null_output = CreateFileA("NUL", GENERIC_WRITE, FILE_SHARE_WRITE,
+                                  &security, OPEN_EXISTING, 0, nullptr);
+        if (null_output == INVALID_HANDLE_VALUE) {
+            throw NativeProcessError("cannot open native probe diagnostic sink");
+        }
+    }
+    if (!stdout_path.empty()) {
+        file_output = CreateFileA(stdout_path.c_str(), GENERIC_WRITE,
+                                  FILE_SHARE_READ, &security, CREATE_ALWAYS,
+                                  FILE_ATTRIBUTE_NORMAL, nullptr);
+        if (file_output == INVALID_HANDLE_VALUE) {
+            if (quiet) CloseHandle(null_output);
+            throw NativeProcessError("cannot create native probe output: " + stdout_path);
+        }
+    }
+    STARTUPINFOA startup{};
+    startup.cb = sizeof(startup);
+    startup.dwFlags = STARTF_USESTDHANDLES;
+    startup.hStdInput = GetStdHandle(STD_INPUT_HANDLE);
+    startup.hStdOutput = file_output != INVALID_HANDLE_VALUE ? file_output :
+        (quiet ? null_output : GetStdHandle(STD_OUTPUT_HANDLE));
+    startup.hStdError = quiet ? null_output : GetStdHandle(STD_ERROR_HANDLE);
+    PROCESS_INFORMATION process{};
+    auto application = std::filesystem::path(args.front()).make_preferred().string();
+    BOOL launched = CreateProcessA(application.c_str(), command.data(), nullptr,
+                                   nullptr, TRUE, 0, nullptr, nullptr,
+                                   &startup, &process);
+    DWORD launch_error = GetLastError();
+    if (file_output != INVALID_HANDLE_VALUE) CloseHandle(file_output);
+    if (quiet) CloseHandle(null_output);
+    if (!launched) {
+        throw NativeProcessError("cannot launch declared native probe tool " +
+                                 args.front() + ": Windows error " +
+                                 std::to_string(launch_error));
+    }
+    DWORD waited = WaitForSingleObject(process.hProcess, INFINITE);
+    DWORD code = 0;
+    BOOL obtained = GetExitCodeProcess(process.hProcess, &code);
+    CloseHandle(process.hThread);
+    CloseHandle(process.hProcess);
+    if (waited != WAIT_OBJECT_0 || !obtained || code >= 0xC0000000UL) {
+        throw NativeProcessError("declared native probe tool crashed: " + args.front());
+    }
+    return static_cast<int>(code);
+#else
+    posix_spawn_file_actions_t actions;
+    int error = posix_spawn_file_actions_init(&actions);
+    if (error) throw native_process_error("probe spawn setup", error);
+    auto redirect = [&](int descriptor, const std::string& path) {
+        int result = posix_spawn_file_actions_addopen(
+            &actions, descriptor, path.c_str(), O_WRONLY | O_CREAT | O_TRUNC, 0600);
+        if (result) {
+            posix_spawn_file_actions_destroy(&actions);
+            throw native_process_error("probe output setup", result);
+        }
+    };
+    if (!stdout_path.empty()) redirect(STDOUT_FILENO, stdout_path);
+    else if (quiet) redirect(STDOUT_FILENO, "/dev/null");
+    if (quiet) redirect(STDERR_FILENO, "/dev/null");
+    std::vector<char*> argv;
+    for (const auto& arg : args) argv.push_back(const_cast<char*>(arg.c_str()));
+    argv.push_back(nullptr);
+    pid_t pid = 0;
+    // No PATH lookup and no shell: args[0] is the declared toolchain path.
+    error = posix_spawn(&pid, args.front().c_str(), &actions, nullptr,
+                        argv.data(), environ);
+    posix_spawn_file_actions_destroy(&actions);
+    if (error) {
+        throw native_process_error("cannot launch declared native probe tool " + args.front(), error);
+    }
+    int status = 0;
+    pid_t waited;
+    do { waited = waitpid(pid, &status, 0); } while (waited == -1 && errno == EINTR);
+    if (waited == -1) {
+        throw native_process_error("probe wait", errno);
+    }
+    if (!WIFEXITED(status)) {
+        throw NativeProcessError("declared native probe tool was signalled: " + args.front());
+    }
+    int code = WEXITSTATUS(status);
+    if (code == 126 || code == 127) {
+        throw NativeProcessError("declared native probe wrapper failed: " + args.front());
+    }
+    return code;
+#endif
+}
+
+}  // namespace rules_cc_autoconf
+
+#endif
