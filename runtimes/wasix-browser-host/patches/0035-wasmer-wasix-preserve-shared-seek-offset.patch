+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::future::Future as _;
+
+    #[test]
+    fn suspended_seek_updates_original_offset_after_descriptor_reuse() {
+        let original_offset = Arc::new(AtomicU64::new(3));
+        let replacement_offset = Arc::new(AtomicU64::new(7));
+        let mut fd_map = std::collections::HashMap::from([(4_u32, original_offset.clone())]);
+        let captured_offset = fd_map.get(&4).unwrap().clone();
+        let ready = Arc::new(AtomicBool::new(false));
+        let seek_ready = ready.clone();
+        let seek = futures::future::poll_fn(move |cx| {
+            if seek_ready.load(Ordering::Acquire) {
+                Poll::Ready(41)
+            } else {
+                cx.waker().wake_by_ref();
+                Poll::Pending
+            }
+        });
+        let work = async move {
+            let end = seek.await;
+            captured_offset.store(end, Ordering::Release);
+        };
+        futures::pin_mut!(work);
+
+        let waker = futures::task::noop_waker();
+        let mut cx = Context::from_waker(&waker);
+        assert_eq!(work.as_mut().poll(&mut cx), Poll::Pending);
+
+        assert!(fd_map.remove(&4).is_some());
+        assert!(fd_map.insert(4, replacement_offset.clone()).is_none());
+        ready.store(true, Ordering::Release);
+
+        assert_eq!(work.as_mut().poll(&mut cx), Poll::Ready(()));
+        assert_eq!(original_offset.load(Ordering::Acquire), 41);
+        assert_eq!(replacement_offset.load(Ordering::Acquire), 7);
+        assert!(Arc::ptr_eq(fd_map.get(&4).unwrap(), &replacement_offset));
+    }
+}
