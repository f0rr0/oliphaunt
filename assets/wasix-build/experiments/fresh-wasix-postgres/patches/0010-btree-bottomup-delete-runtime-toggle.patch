@@ -74,7 +74,65 @@ static BlockNumber *_bt_deadblocks(Page page, OffsetNumber *deletable,
 								   int ndeletable, IndexTuple newitem,
 								   int *nblocks);
 static inline int _bt_blk_cmp(const void *arg1, const void *arg2);
+#ifdef __wasi__
+static int
+pglite_wasix_bottomup_delete_mode(void)
+{
+	static int	cached = -1;
+	const char *value;
+
+	if (cached >= 0)
+		return cached;
+
+	value = getenv("PGLITE_OXIDE_WASIX_DISABLE_BTREE_BOTTOMUP_DELETE");
+	if (value != NULL && value[0] != '\0' && strcmp(value, "0") != 0)
+	{
+		cached = 1;			/* legacy all-off mode */
+		return cached;
+	}
+
+	value = getenv("PGLITE_OXIDE_WASIX_BTREE_BOTTOMUP_DELETE");
+	if (value == NULL || value[0] == '\0' ||
+		strcmp(value, "0") == 0 ||
+		strcmp(value, "on") == 0 ||
+		strcmp(value, "default") == 0)
+		cached = 0;
+	else if (strcmp(value, "off") == 0 ||
+			 strcmp(value, "all-off") == 0 ||
+			 strcmp(value, "disable") == 0)
+		cached = 1;
+	else if (strcmp(value, "index-unchanged-off") == 0 ||
+			 strcmp(value, "index-unchanged") == 0 ||
+			 strcmp(value, "unchanged") == 0)
+		cached = 2;
+	else if (strcmp(value, "unique-dup-off") == 0 ||
+			 strcmp(value, "unique-dup") == 0 ||
+			 strcmp(value, "uniquedup") == 0)
+		cached = 3;
+	else
+		cached = 0;
+
+	return cached;
+}
+
+static bool
+pglite_wasix_skip_bottomup_delete(bool indexUnchanged, bool uniquedup)
+{
+	switch (pglite_wasix_bottomup_delete_mode())
+	{
+		case 1:
+			return true;
+		case 2:
+			return indexUnchanged;
+		case 3:
+			return uniquedup && !indexUnchanged;
+		default:
+			return false;
+	}
+}
+#endif
+

 /*
