+	 * default while letting benchmarks isolate the bottom-up deletion cost.
 	 */
+#ifdef __wasi__
+	if (!pglite_wasix_skip_bottomup_delete(indexUnchanged, uniquedup) &&
+		(indexUnchanged || uniquedup) &&
