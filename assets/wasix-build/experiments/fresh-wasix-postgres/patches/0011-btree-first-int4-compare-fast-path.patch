 	itup = (IndexTuple) PageGetItem(page, PageGetItemId(page, offnum));
 	ntupatts = BTreeTupleGetNAtts(itup, rel);

+#ifdef __wasi__
+	if (_bt_wasix_fast_first_int4_compare(rel, key, itup, ntupatts, &result))
+		return result;
+#endif
