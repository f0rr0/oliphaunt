diff --git a/src/backend/access/nbtree/nbtsearch.c b/src/backend/access/nbtree/nbtsearch.c
index 3ad6f1f3b4..b6dbfc9c70 100644
--- a/src/backend/access/nbtree/nbtsearch.c
+++ b/src/backend/access/nbtree/nbtsearch.c
@@ -15,6 +15,7 @@

 #include "access/nbtree.h"
 #include "access/relscan.h"
+#include "catalog/pg_type_d.h"
 #include "access/xact.h"
 #include "miscadmin.h"
 #include "pgstat.h"
@@ -767,10 +768,31 @@ _bt_compare(Relation rel,
 			 * to flip the sign of the comparison result.  (Unless it's a DESC
 			 * column, in which case we *don't* flip the sign.)
 			 */
-			result = DatumGetInt32(FunctionCall2Coll(&scankey->sk_func,
-													 scankey->sk_collation,
-													 datum,
-													 scankey->sk_argument));
+			if (rel->rd_opcintype[i - 1] == INT4OID &&
+				(scankey->sk_subtype == INT4OID ||
+				 scankey->sk_subtype == InvalidOid))
+			{
+				int32		index_value = DatumGetInt32(datum);
+				int32		scan_value = DatumGetInt32(scankey->sk_argument);
+
+				/*
+				 * Avoid the fmgr trampoline for the common int4 btree order
+				 * proc.  WASM indirect calls are comparatively expensive, and
+				 * single-column int4 lookup indexes dominate the update
+				 * parity cases.
+				 */
+				if (index_value > scan_value)
+					result = 1;
+				else if (index_value == scan_value)
+					result = 0;
+				else
+					result = -1;
+			}
+			else
+				result = DatumGetInt32(FunctionCall2Coll(&scankey->sk_func,
+														 scankey->sk_collation,
+														 datum,
+														 scankey->sk_argument));

 			if (!(scankey->sk_flags & SK_BT_DESC))
 				INVERT_COMPARE_RESULT(result);
