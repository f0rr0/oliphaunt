@@ -2818,6 +2818,8 @@ _bt_simpledel_pass(Relation rel, Buffer buffer, Relation heapRel,
 	BlockNumber *deadblocks;
 	int			ndeadblocks;
 	TM_IndexDeleteOp delstate;
+	TM_IndexDelete deltids[MaxTIDsPerBTreePage];
+	TM_IndexStatus status[MaxTIDsPerBTreePage];
 	OffsetNumber offnum;

 	/* Get array of table blocks pointed to by LP_DEAD-set tuples */
@@ -2830,8 +2832,14 @@ _bt_simpledel_pass(Relation rel, Buffer buffer, Relation heapRel,
 	delstate.bottomup = false;
 	delstate.bottomupfreespace = 0;
 	delstate.ndeltids = 0;
-	delstate.deltids = palloc(MaxTIDsPerBTreePage * sizeof(TM_IndexDelete));
-	delstate.status = palloc(MaxTIDsPerBTreePage * sizeof(TM_IndexStatus));
+
+	/*
+	 * This state is fixed-size and page-local.  Avoid allocator overhead in
+	 * the LP_DEAD cleanup path, which is visible in WASIX indexed-update
+	 * profiles.
+	 */
+	delstate.deltids = deltids;
+	delstate.status = status;

 	for (offnum = minoff;
 		 offnum <= maxoff;
@@ -2912,7 +2919,4 @@ _bt_simpledel_pass(Relation rel, Buffer buffer, Relation heapRel,

 	/* Physically delete LP_DEAD tuples (plus any delete-safe extra TIDs) */
 	_bt_delitems_delete_check(rel, buffer, heapRel, &delstate);
-
-	pfree(delstate.deltids);
-	pfree(delstate.status);
 }
