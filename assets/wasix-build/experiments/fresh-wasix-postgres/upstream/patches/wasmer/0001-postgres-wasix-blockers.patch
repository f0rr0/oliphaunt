+    }
+    if (revents & libc::POLLOUT) != 0 {
+        handler_guard.push_interest(InterestType::Writable);
+    }
+    if (revents & libc::POLLHUP) != 0 {
+        handler_guard.push_interest(InterestType::Closed);
+    }
