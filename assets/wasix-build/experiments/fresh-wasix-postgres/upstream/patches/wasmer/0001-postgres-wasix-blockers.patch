+        if local == 0 {
+            break;
+        }
+        written = written
+            .checked_add(local)
+            .ok_or_else(|| io::Error::from(io::ErrorKind::InvalidData))?;
+        if local < local_len {
+            break;
+        }
+    }
+    Ok(written)
