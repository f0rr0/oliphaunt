+#[cfg(unix)]
+fn host_iov_max() -> usize {
+    static IOV_MAX: OnceLock<usize> = OnceLock::new();
+    *IOV_MAX.get_or_init(|| {
+        let max = unsafe { libc::sysconf(libc::_SC_IOV_MAX) };
+        if max > 0 { max as usize } else { 1024 }
+    })
