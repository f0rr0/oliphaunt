+#[derive(Debug, Clone)]
+pub(crate) enum WasiFutexRegistry {
+    Private(Arc<WasiState>),
+    Shared(Arc<Mutex<WasiFutexState>>),
+}
+
+impl WasiFutexRegistry {
+    pub(crate) fn resolve(state: &Arc<WasiState>, addr: u64) -> (Self, u64) {
+        if let Some((futexs, key)) = state.shared_futex_registry(addr) {
+            (Self::Shared(futexs), key)
+        } else {
+            (Self::Private(state.clone()), addr)
+        }
+    }
+
+    pub(crate) fn with<R>(&self, f: impl FnOnce(&mut WasiFutexState) -> R) -> R {
+        match self {
+            Self::Private(state) => {
+                let mut guard = state.futexs.lock().unwrap();
+                f(&mut guard)
+            }
+            Self::Shared(futexs) => {
+                let mut guard = futexs.lock().unwrap();
+                f(&mut guard)
+            }
+        }
+    }
+
+    #[cfg(feature = "perf-stats")]
+    pub(crate) fn perf_id(&self) -> u64 {
+        match self {
+            Self::Private(state) => Arc::as_ptr(state) as usize as u64,
+            Self::Shared(futexs) => Arc::as_ptr(futexs) as usize as u64,
+        }
+    }
+
+    #[cfg(not(feature = "perf-stats"))]
+    pub(crate) fn perf_id(&self) -> u64 {
+        0
+    }
+}
