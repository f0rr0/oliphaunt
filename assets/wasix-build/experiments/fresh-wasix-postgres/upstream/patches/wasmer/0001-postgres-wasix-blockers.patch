+#[cfg(unix)]
+fn cvt_sync_result(mut sync: impl FnMut() -> libc::c_int) -> io::Result<()> {
+    loop {
+        if sync() == 0 {
+            return Ok(());
+        }
+        let err = io::Error::last_os_error();
+        if err.raw_os_error() == Some(libc::EINTR) {
+            continue;
+        }
+        return Err(err);
+    }
