+                let outermost = child_resume.frames.last();
+                trace!(
+                    frames = child_resume.frames.len(),
+                    outermost_function = outermost.map(|frame| frame.function_index),
+                    outermost_stackmap = outermost.map(|frame| frame.stackmap_id),
+                    "installing native fork child resume"
+                );
