 impl<'ctx> LLVMFunctionCodeGenerator<'ctx, '_> {
+    const INDIRECT_CALL_CACHE_BODY_LIMIT: u64 = 16 * 1024;
+
+    fn build_indirect_call_cache_slots(
+        &mut self,
+        name: &str,
+    ) -> Result<IndirectCallCacheSlots<'ctx>, CompileError> {
+        let index = err!(
+            self.alloca_builder
+                .build_alloca(self.intrinsics.i32_ty, &format!("{name}_index"))
+        );
+        let generation = err!(
+            self.alloca_builder
+                .build_alloca(self.intrinsics.isize_ty, &format!("{name}_generation"))
+        );
+        let func_ptr = err!(
+            self.alloca_builder
+                .build_alloca(self.intrinsics.ptr_ty, &format!("{name}_func_ptr"))
+        );
+        let vmctx = err!(
+            self.alloca_builder
+                .build_alloca(self.intrinsics.ptr_ty, &format!("{name}_vmctx"))
+        );
+
+        let entry = self
+            .function
+            .get_first_basic_block()
+            .ok_or_else(|| CompileError::Codegen("function has no entry block".to_string()))?;
+        let terminator = entry.get_terminator().ok_or_else(|| {
+            CompileError::Codegen("function entry block has no terminator".to_string())
+        })?;
+        let init_builder = self.context.create_builder();
+        init_builder.position_before(&terminator);
+        err!(init_builder.build_store(index, self.intrinsics.i32_ty.const_zero()));
+        err!(init_builder.build_store(generation, self.intrinsics.isize_ty.const_zero()));
+        err!(init_builder.build_store(func_ptr, self.intrinsics.ptr_ty.const_null()));
+        err!(init_builder.build_store(vmctx, self.intrinsics.ptr_ty.const_null()));
+
+        Ok(IndirectCallCacheSlots {
+            index,
+            generation,
+            func_ptr,
+            vmctx,
+        })
+    }
+
+    fn finish_indirect_call_cache_join(
+        &mut self,
+        cache: IndirectCallCacheJoin<'ctx>,
+        func_index: IntValue<'ctx>,
+        func_ptr: PointerValue<'ctx>,
+        callee_vmctx: PointerValue<'ctx>,
+        slow_rets: Vec<BasicValueEnum<'ctx>>,
+    ) -> Result<Vec<BasicValueEnum<'ctx>>, CompileError> {
+        if slow_rets.len() != cache.hit_rets.len() {
+            return Err(CompileError::Codegen(format!(
+                "indirect-call cache return mismatch: slow path returned {}, hit path returned {}",
+                slow_rets.len(),
+                cache.hit_rets.len()
+            )));
+        }
+        err!(self.builder.build_store(cache.slots.index, func_index));
+        err!(
+            self.builder
+                .build_store(cache.slots.generation, cache.current_generation)
+        );
+        err!(self.builder.build_store(cache.slots.func_ptr, func_ptr));
+        err!(self.builder.build_store(cache.slots.vmctx, callee_vmctx));
+        let slow_block = self.builder.get_insert_block().ok_or_else(|| {
+            CompileError::Codegen("indirect-call cache slow path has no block".to_string())
+        })?;
+        err!(self.builder.build_unconditional_branch(cache.after_block));
+
+        self.builder.position_at_end(cache.after_block);
+        let mut rets = Vec::with_capacity(slow_rets.len());
+        for (slow_ret, hit_ret) in slow_rets.iter().zip(cache.hit_rets.iter()) {
+            let phi = err!(self.builder.build_phi(slow_ret.get_type(), ""));
+            phi.add_incoming(&[(slow_ret, slow_block), (hit_ret, cache.hit_block)]);
+            rets.push(phi.as_basic_value());
+        }
+        Ok(rets)
+    }
+
+    const FORK_STACKMAP_TAG: u64 = 0x5746_5346_0000_0000;
+    const FORK_NONEMPTY_STACK_CAPTURE_BODY_LIMIT: u64 = 1_200;
+
+    fn is_wasix_proc_fork_import(&self, func_index: FunctionIndex) -> bool {
+        if !self.wasm_module.is_imported_function(func_index) {
+            return false;
+        }
+
+        self.wasm_module.imports.iter().any(|(key, import)| {
+            matches!(import, ImportIndex::Function(index) if *index == func_index)
+                && key.field == "proc_fork"
+                && (key.module.starts_with("wasix_")
+                    || key.module.starts_with("wasi_")
+                    || key.module == "env")
+        })
+    }
+
+    fn fork_stackmap_id(&self, module_offset: u32) -> u64 {
+        Self::FORK_STACKMAP_TAG
+            | ((self.function_index.as_u32() as u64) << 32)
+            | (module_offset as u64)
+    }
+
+    fn native_fork_raw_slot_type(&self) -> ArrayType<'ctx> {
+        self.intrinsics.i64_ty.array_type(2)
+    }
+
+    fn native_fork_can_capture_nonempty_stack(&self, base_stack_len: usize) -> bool {
+        base_stack_len == 0
+            || (self
+                .state
+                .control_stack
+                .iter()
+                .skip(1)
+                .all(|frame| frame.stack_size_snapshot() == 0)
+                && self.function_body_len <= Self::FORK_NONEMPTY_STACK_CAPTURE_BODY_LIMIT
+                && self.native_fork_nonempty_callsite_captures == 0)
+    }
+
+    fn restore_native_fork_value(
+        &self,
+        raw_ptr: PointerValue<'ctx>,
+        ty: BasicTypeEnum<'ctx>,
+    ) -> Result<BasicValueEnum<'ctx>, CompileError> {
+        match ty {
+            BasicTypeEnum::IntType(int_ty) => Ok(err!(self.builder.build_load(
+                int_ty,
+                raw_ptr,
+                "fork_raw_int_load"
+            ))
+            .as_basic_value_enum()),
+            BasicTypeEnum::FloatType(float_ty)
+                if float_ty == self.intrinsics.f32_ty || float_ty == self.intrinsics.f64_ty =>
+            {
+                Ok(err!(
+                    self.builder
+                        .build_load(float_ty, raw_ptr, "fork_raw_float_load")
+                )
+                .as_basic_value_enum())
+            }
+            BasicTypeEnum::VectorType(vector_ty) => Ok(err!(self.builder.build_load(
+                vector_ty,
+                raw_ptr,
+                "fork_raw_vector_load"
+            ))
+            .as_basic_value_enum()),
+            BasicTypeEnum::PointerType(pointer_ty) => {
+                let raw = err!(self.builder.build_load(
+                    self.intrinsics.isize_ty,
+                    raw_ptr,
+                    "fork_raw_ptr_load"
+                ))
+                .into_int_value();
+                Ok(err!(
+                    self.builder
+                        .build_int_to_ptr(raw, pointer_ty, "fork_ptr_restore")
+                )
+                .as_basic_value_enum())
+            }
+            _ => Err(CompileError::Codegen(
+                "unsupported native fork resume value type".to_string(),
+            )),
+        }
+    }
+
+    fn store_native_fork_raw_value(
+        &self,
+        raw_ptr: PointerValue<'ctx>,
+        value: BasicValueEnum<'ctx>,
+    ) -> Result<(), CompileError> {
+        match value {
+            BasicValueEnum::IntValue(value) => {
+                let width = value.get_type().get_bit_width();
+                if !matches!(width, 32 | 64 | 128) {
+                    return Err(CompileError::Codegen(format!(
+                        "unsupported native fork raw integer width {width}"
+                    )));
+                }
+                err!(self.builder.build_store(raw_ptr, value));
+            }
+            BasicValueEnum::FloatValue(value)
+                if value.get_type() == self.intrinsics.f32_ty
+                    || value.get_type() == self.intrinsics.f64_ty =>
+            {
+                err!(self.builder.build_store(raw_ptr, value));
+            }
+            BasicValueEnum::VectorValue(value) => {
+                err!(self.builder.build_store(raw_ptr, value));
+            }
+            BasicValueEnum::PointerValue(value) => {
+                let raw = err!(self.builder.build_ptr_to_int(
+                    value,
+                    self.intrinsics.isize_ty,
+                    "fork_ptr_raw"
+                ));
+                err!(self.builder.build_store(raw_ptr, raw));
+            }
+            _ => {
+                return Err(CompileError::Codegen(
+                    "unsupported native fork value type".to_string(),
+                ));
+            }
+        }
+        Ok(())
+    }
+
+    fn emit_native_fork_return_defaults(&self) -> Result<(), CompileError> {
+        let results = self.wasm_fn_type.results();
+        if results.is_empty() {
+            err!(self.builder.build_return(None));
+            return Ok(());
+        }
+
+        let values = results
+            .iter()
+            .map(|ty| type_to_llvm(self.intrinsics, *ty).map(|ty| ty.const_zero()))
+            .collect::<Result<Vec<_>, _>>()?;
+
+        if self.abi.is_sret(self.wasm_fn_type)? {
+            let sret = self
+                .function
+                .get_first_param()
+                .ok_or_else(|| CompileError::Codegen("missing sret parameter".to_string()))?
+                .into_pointer_value();
+            let llvm_tys = results
+                .iter()
+                .map(|ty| type_to_llvm(self.intrinsics, *ty))
+                .collect::<Result<Vec<_>, _>>()?;
+            let mut struct_value = self.context.struct_type(&llvm_tys, false).get_undef();
+            for (idx, value) in values.iter().enumerate() {
+                struct_value =
+                    err!(
+                        self.builder
+                            .build_insert_value(struct_value, *value, idx as u32, "")
+                    )
+                    .into_struct_value();
+            }
+            err!(self.builder.build_store(sret, struct_value));
+            err!(self.builder.build_return(None));
+        } else {
+            let ret = self.abi.pack_values_for_register_return(
+                self.intrinsics,
+                &self.builder,
+                &values,
+                &self.function.get_type(),
+            )?;
+            err!(self.builder.build_return(Some(&ret)));
+        }
+        Ok(())
+    }
+
+    fn emit_native_fork_capture_pending_load(&self) -> Result<IntValue<'ctx>, CompileError> {
+        let flag_ptr = self
+            .ctx
+            .native_fork_capture_pending_ptr(self.intrinsics, &self.builder)?;
+        let pending = err!(self.builder.build_load(
+            self.intrinsics.i32_ty,
+            flag_ptr,
+            "native_fork_capture_pending",
+        ))
+        .into_int_value();
+        pending
+            .as_instruction_value()
+            .expect("native fork capture-pending load must be an instruction")
+            .set_atomic_ordering(AtomicOrdering::Acquire)
+            .unwrap();
+        Ok(pending)
+    }
+
+    fn emit_native_fork_frame_capture(
+        &self,
+        stackmap_id: u64,
+        _module_offset: u32,
+        stack_values: &[(BasicValueEnum<'ctx>, ExtraInfo)],
+        local_values: &[(BasicTypeEnum<'ctx>, PointerValue<'ctx>)],
+        capture_func: FunctionValue<'ctx>,
+    ) -> Result<Vec<BasicTypeEnum<'ctx>>, CompileError> {
+        let mut value_tys = stack_values
+            .iter()
+            .map(|(value, _)| value.get_type())
+            .collect::<Vec<_>>();
+        value_tys.extend(local_values.iter().map(|(ty, _)| *ty));
+
+        let value_count = value_tys.len();
+        let values_ptr = if value_count == 0 {
+            self.intrinsics.ptr_ty.const_zero()
+        } else {
+            let raw_slot_ty = self.native_fork_raw_slot_type();
+            let values_ty = raw_slot_ty.array_type(value_count as u32);
+            let values_alloca = err!(
+                self.alloca_builder
+                    .build_alloca(values_ty, "fork_safepoint_values")
+            );
+            if let Some(instruction) = values_alloca.as_instruction_value() {
+                instruction.set_alignment(16).unwrap();
+            }
+            err!(
+                self.builder.build_memset(
+                    values_alloca,
+                    16,
+                    self.intrinsics.i8_ty.const_zero(),
+                    self.intrinsics
+                        .i64_ty
+                        .const_int((value_count * 16) as u64, false)
+                )
+            );
+            let zero = self.intrinsics.i32_zero;
+
+            for (idx, (value, _)) in stack_values.iter().enumerate() {
+                let idx = self.intrinsics.i32_ty.const_int(idx as u64, false);
+                let value_ptr = unsafe {
+                    err!(self.builder.build_gep(
+                        values_ty,
+                        values_alloca,
+                        &[zero, idx],
+                        "fork_safepoint_value_ptr",
+                    ))
+                };
+                self.store_native_fork_raw_value(value_ptr, *value)?;
+            }
+            for (local_idx, (ty, ptr)) in local_values.iter().enumerate() {
+                let idx = self
+                    .intrinsics
+                    .i32_ty
+                    .const_int((stack_values.len() + local_idx) as u64, false);
+                let value_ptr = unsafe {
+                    err!(self.builder.build_gep(
+                        values_ty,
+                        values_alloca,
+                        &[zero, idx],
+                        "fork_safepoint_local_ptr",
+                    ))
+                };
+                let value = err!(self.builder.build_load(*ty, *ptr, "fork_safepoint_local"));
+                self.store_native_fork_raw_value(value_ptr, value)?;
+            }
+
+            values_alloca
+        };
+
+        err!(
+            self.builder.build_call(
+                capture_func,
+                &[
+                    self.ctx.basic().into(),
+                    self.intrinsics
+                        .i32_ty
+                        .const_int(self.function_index.as_u32() as u64, false)
+                        .into(),
+                    self.intrinsics.i64_ty.const_int(stackmap_id, false).into(),
+                    values_ptr.into(),
+                    self.intrinsics
+                        .i32_ty
+                        .const_int(value_count as u64, false)
+                        .into(),
+                ],
+                "fork_native_safepoint",
+            )
+        );
+        Ok(value_tys)
+    }
+
+    fn emit_native_fork_resume_block(
+        &mut self,
+        stackmap_id: u64,
+        stack_values: &[(BasicValueEnum<'ctx>, ExtraInfo)],
+        local_values: &[(BasicTypeEnum<'ctx>, PointerValue<'ctx>)],
+        value_tys: &[BasicTypeEnum<'ctx>],
+    ) -> Result<(), CompileError> {
+        let value_count = value_tys.len();
+
+        let resume_block = self
+            .context
+            .append_basic_block(self.function, "native_fork_resume");
+        self.native_fork_resume_targets
+            .push((stackmap_id, resume_block));
+        self.builder.position_at_end(resume_block);
+
+        let mut restored_values = Vec::with_capacity(value_count);
+        let raw_slot_ty = self.native_fork_raw_slot_type();
+        for (idx, ty) in value_tys.iter().enumerate() {
+            let raw_alloca = err!(
+                self.alloca_builder
+                    .build_alloca(raw_slot_ty, "fork_resume_raw")
+            );
+            if let Some(instruction) = raw_alloca.as_instruction_value() {
+                instruction.set_alignment(16).unwrap();
+            }
+            err!(self.builder.build_call(
+                self.intrinsics.native_fork_resume_value,
+                &[
+                    self.ctx.basic().into(),
+                    self.intrinsics.i32_ty.const_int(idx as u64, false).into(),
+                    raw_alloca.into(),
+                ],
+                "fork_resume_value",
+            ));
+            restored_values.push(self.restore_native_fork_value(raw_alloca, *ty)?);
+        }
+        err!(
+            self.builder.build_call(
+                self.intrinsics.native_fork_resume_clear,
+                &[
+                    self.ctx.basic().into(),
+                    self.intrinsics
+                        .i32_ty
+                        .const_int(self.function_index.as_u32() as u64, false)
+                        .into(),
+                    self.intrinsics.i64_ty.const_int(stackmap_id, false).into(),
+                ],
+                "fork_resume_clear",
+            )
+        );
+
+        self.state.stack.clear();
+        self.state.reachable = true;
+        for value in restored_values.iter().take(stack_values.len()) {
+            self.state.push1_extra(*value, ExtraInfo::default());
+        }
+        for (idx, (_, ptr)) in local_values.iter().enumerate() {
+            let value = restored_values[stack_values.len() + idx];
+            err!(self.builder.build_store(*ptr, value));
+        }
+
+        Ok(())
+    }
+
+    fn emit_native_fork_safepoint(
+        &mut self,
+        func_index: FunctionIndex,
+        module_offset: u32,
+    ) -> Result<(), CompileError> {
+        if !self.is_wasix_proc_fork_import(func_index) {
+            return Ok(());
+        }
+
+        let stackmap_id = self.fork_stackmap_id(module_offset);
+        let stack_values = self.state.stack.clone();
+        let local_values = self.locals.clone();
+        let value_tys = self.emit_native_fork_frame_capture(
+            stackmap_id,
+            module_offset,
+            &stack_values,
+            &local_values,
+            self.intrinsics.native_fork_safepoint,
+        )?;
+        self.emit_native_fork_return_defaults()?;
+        self.state.reachable = false;
+
+        let continuation_block = self
+            .context
+            .append_basic_block(self.function, "native_fork_safepoint_cont");
+        let mut stack_slots = Vec::with_capacity(stack_values.len());
+        for (idx, (value, _)) in stack_values.iter().enumerate() {
+            stack_slots.push(err!(
+                self.alloca_builder
+                    .build_alloca(value.get_type(), &format!("fork_safepoint_stack_{idx}"))
+            ));
+        }
+        self.emit_native_fork_resume_block(stackmap_id, &stack_values, &local_values, &value_tys)?;
+        for (slot, (value, _)) in stack_slots.iter().zip(self.state.stack.iter()) {
+            err!(self.builder.build_store(*slot, *value));
+        }
+        err!(self.builder.build_unconditional_branch(continuation_block));
+        self.builder.position_at_end(continuation_block);
+        self.state.stack.clear();
+        self.state.reachable = true;
+        for (idx, (original, _)) in stack_values.iter().enumerate() {
+            let value = err!(self.builder.build_load(
+                original.get_type(),
+                stack_slots[idx],
+                "fork_safepoint_stack_load",
+            ));
+            self.state.push1(value);
+        }
+
+        self.native_fork_safepoints.push(NativeForkSafepoint {
+            function: self.function_index,
+            module_offset,
+            stackmap_id,
+        });
+        Ok(())
+    }
+
+    fn emit_native_fork_resume_dispatch(
