+            };
+
+            let mut inner = self.inner.0.lock().unwrap();
+            inner.children.retain(|a| a.pid != child.pid);
+            let code = status
+                .unwrap_or_else(|e| e.as_exit_code().unwrap_or_else(|| Errno::Canceled.into()));
+            return Ok(Some((child.pid, code)));
+        }
