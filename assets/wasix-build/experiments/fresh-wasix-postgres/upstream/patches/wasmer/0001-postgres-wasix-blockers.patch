+pub(crate) struct WasiSharedMemoryMapping {
+    pub start: u64,
+    pub len: u64,
+    pub file: Arc<std::fs::File>,
+    pub file_offset: u64,
+    pub futexs: Arc<Mutex<WasiFutexState>>,
+}
+
+impl WasiSharedMemoryMapping {
