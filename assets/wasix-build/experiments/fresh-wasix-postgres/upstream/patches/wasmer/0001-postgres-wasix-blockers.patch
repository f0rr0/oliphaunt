+
+impl SharedMemoryMappingSet {
+    pub(crate) fn new(mappings: Vec<WasiSharedMemoryMapping>) -> Self {
+        Self { mappings }
+    }
+
+    pub(crate) fn iter(&self) -> impl Iterator<Item = &WasiSharedMemoryMapping> {
+        self.mappings.iter()
+    }
+
+    pub(crate) fn excluded_copy_ranges(&self) -> Vec<(usize, usize)> {
+        let mut ranges: Vec<_> = self
+            .mappings
+            .iter()
+            .filter_map(|mapping| {
+                let start: usize = mapping.start.try_into().ok()?;
+                let len: usize = mapping.len.try_into().ok()?;
+                (len > 0).then_some((start, start.saturating_add(len)))
+            })
+            .collect();
+        ranges.sort_unstable_by_key(|(start, _)| *start);
+
+        let mut merged: Vec<(usize, usize)> = Vec::with_capacity(ranges.len());
+        for (start, end) in ranges {
+            match merged.last_mut() {
+                Some((_, last_end)) if start <= *last_end => {
+                    *last_end = (*last_end).max(end);
+                }
+                _ => merged.push((start, end)),
+            }
+        }
+
+        merged
+            .into_iter()
+            .map(|(start, end)| (start, end - start))
+            .collect()
+    }
+}
