+}
diff --git a/lib/wasix/tests/wasm_tests/dynamic_library_tests/fork-dlopen/main.c b/lib/wasix/tests/wasm_tests/dynamic_library_tests/fork-dlopen/main.c
new file mode 100644
index 0000000000..f4dc28aedf
--- /dev/null
+++ b/lib/wasix/tests/wasm_tests/dynamic_library_tests/fork-dlopen/main.c
@@ -0,0 +1,143 @@
+#include <dlfcn.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <sys/wait.h>
+#include <unistd.h>
+#include <wasi/api_wasix.h>
+
+typedef int (*value_fn)(int);
+
+static int fail(const char* message) {
+  fprintf(stderr, "%s\n", message);
+  return 1;
+}
+
+static value_fn load_value_fn(const char* path, const char* symbol) {
+  void* handle;
+  value_fn fn;
+
+  dlerror();
+  handle = dlopen(path, RTLD_NOW | RTLD_LOCAL);
+  if (!handle) {
+    fprintf(stderr, "dlopen(%s) failed: %s\n", path, dlerror());
+    return NULL;
+  }
+
+  fn = (value_fn)dlsym(handle, symbol);
+  if (!fn) {
+    fprintf(stderr, "dlsym(%s) failed: %s\n", symbol, dlerror());
+    return NULL;
+  }
+
+  return fn;
+}
+
+int main(void) {
+  const char* path = "fork-dlopen-slot.dat";
+  volatile int* slot;
+  __wasi_pid_t child_pid = 0;
+  __wasi_errno_t fork_errno;
+  int status = 0;
+  int fd;
+  value_fn parent_loaded_fn;
+
+  unlink(path);
+  fd = open(path, O_RDWR | O_CREAT | O_TRUNC, 0600);
+  if (fd < 0) {
+    perror("open");
+    return 1;
+  }
+  if (ftruncate(fd, 4096) < 0) {
+    perror("ftruncate");
+    return 1;
+  }
+
+  slot = mmap((void*)0x860000, 4096, PROT_READ | PROT_WRITE,
+              MAP_SHARED | MAP_FIXED, fd, 0);
+  if (slot == MAP_FAILED) {
+    perror("mmap");
+    return 1;
+  }
+
+  parent_loaded_fn = load_value_fn("./libfork_side.so", "fork_side_value");
+  if (!parent_loaded_fn) {
+    return 1;
+  }
+  if (parent_loaded_fn(7) != 42) {
+    return fail("pre-fork side module returned the wrong value");
+  }
+
+  *slot = 7;
+  if (msync((void*)slot, 4096, MS_SYNC) != 0) {
+    perror("parent msync");
+    return 1;
+  }
+
+  fork_errno = __wasi_proc_fork(1, &child_pid);
+  if (fork_errno != 0) {
+    pid_t waited;
+
+    errno = 0;
+    waited = waitpid(-1, &status, WNOHANG);
+    if (waited != -1 || errno != ECHILD) {
+      fprintf(stderr,
+              "fork failure left observable child state: waited=%d errno=%d "
+              "status=%d\n",
+              (int)waited, errno, status);
+      return 1;
+    }
+    fprintf(stderr, "proc_fork failed: %u\n", (unsigned int)fork_errno);
+    return 1;
+  }
+
+  if (child_pid == 0) {
+    value_fn child_loaded_fn;
+    int value;
+
+    if (*slot != 7) {
+      _exit(10);
+    }
+
+    value = parent_loaded_fn(*slot);
+    if (value != 42) {
+      _exit(11);
+    }
+
+    child_loaded_fn =
+        load_value_fn("./libfork_child_side.so", "fork_child_side_value");
+    if (!child_loaded_fn) {
+      _exit(12);
+    }
+
+    value = child_loaded_fn(value);
+    if (value != 123) {
+      _exit(13);
+    }
+
+    *slot = value;
+    if (msync((void*)slot, 4096, MS_SYNC) != 0) {
+      _exit(14);
+    }
+    _exit(0);
+  }
+
+  if (waitpid((pid_t)child_pid, &status, 0) < 0) {
+    perror("waitpid");
+    return 1;
+  }
+  if (!WIFEXITED(status) || WEXITSTATUS(status) != 0) {
+    fprintf(stderr, "child status=0x%x\n", status);
+    return 1;
+  }
+  if (*slot != 123) {
+    fprintf(stderr, "shared slot after fork=%d\n", *slot);
+    return 1;
+  }
+
+  puts("0");
+  return 0;
+}
