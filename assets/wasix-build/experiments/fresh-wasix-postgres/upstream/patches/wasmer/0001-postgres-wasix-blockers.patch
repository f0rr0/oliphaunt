+fn try_read_file_blocking<M: MemorySize>(
+    handle: &mut (dyn VirtualFile + Send + Sync),
+    memory: &wasmer::MemoryView<'_>,
+    iovs: WasmPtr<__wasi_iovec_t<M>, M>,
+    iovs_len: M::Offset,
+    offset: usize,
+    positioned_read: bool,
+) -> Result<Option<usize>, Errno> {
+    let has_blocking_read = if positioned_read {
+        handle.has_blocking_read_at()
+    } else {
+        handle.has_blocking_seek() && handle.has_blocking_read()
+    };
+
+    if !has_blocking_read {
+        return Ok(None);
+    }
+
+    if !positioned_read {
+        handle
+            .seek_blocking(std::io::SeekFrom::Start(offset as u64))
+            .map_err(map_io_err)?;
+    }
+
+    let mut total_read = 0usize;
+    let mut read_offset = offset as u64;
+    let iovs_arr = iovs.slice(memory, iovs_len).map_err(mem_error_to_wasi)?;
+    let iovs_arr = iovs_arr.access().map_err(mem_error_to_wasi)?;
+    for iovs in iovs_arr.iter() {
+        let mut buf = WasmPtr::<u8, M>::new(iovs.buf)
+            .slice(memory, iovs.buf_len)
+            .map_err(mem_error_to_wasi)?
+            .access()
+            .map_err(mem_error_to_wasi)?;
+        if buf.as_ref().is_empty() {
+            continue;
+        }
+        let local_read = if positioned_read {
+            match handle.read_at_blocking(buf.as_mut(), read_offset) {
+                Ok(s) => s,
+                Err(_) if total_read > 0 => break,
+                Err(err) => return Err(map_io_err(err)),
+            }
+        } else {
+            match handle.read_blocking(buf.as_mut()) {
+                Ok(s) => s,
+                Err(_) if total_read > 0 => break,
+                Err(err) => return Err(map_io_err(err)),
+            }
+        };
