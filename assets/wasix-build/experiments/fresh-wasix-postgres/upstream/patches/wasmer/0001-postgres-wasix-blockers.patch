+fn proc_fork_native_safepoint<M: MemorySize>(
+    mut ctx: FunctionEnvMut<'_, WasiEnv>,
+    pid_ptr: WasmPtr<Pid, M>,
+) -> Result<Errno, WasiError> {
+    let env = ctx.data();
+    let memory = unsafe { env.memory_view(&ctx) };
+
+    // The child observes zero in the pid slot. The parent overwrites this slot
+    // with the child pid after the runtime safepoint has captured the native
