+    pub indirect_calls: Arc<HashSet<(TableIndex, SignatureIndex)>>,
+}
+
+fn native_fork_reachability(
+    module: &ModuleInfo,
+    function_body_inputs: &PrimaryMap<LocalFunctionIndex, FunctionBodyData<'_>>,
+) -> Result<NativeForkReachability, CompileError> {
+    let proc_fork_imports = module
+        .imports
+        .iter()
+        .filter_map(|(key, import)| match import {
+            ImportIndex::Function(index)
+                if key.field == "proc_fork"
+                    && matches!(key.module.as_str(), "wasix_32v1" | "wasix_64v1" | "env") =>
+            {
+                Some(*index)
+            }
+            _ => None,
+        })
+        .collect::<HashSet<_>>();
+    let proc_fork_import_count = proc_fork_imports.len();
+    if proc_fork_imports.is_empty() {
+        return Ok(NativeForkReachability::default());
+    }
+
+    let imported_functions = module.num_imported_functions as u32;
+    let mut possible_indirect_callees = possible_indirect_callees_by_table_signature(module);
+    let mut direct_callees: HashMap<FunctionIndex, Vec<FunctionIndex>> = HashMap::new();
+    let mut indirect_callee_signatures: HashMap<FunctionIndex, Vec<(TableIndex, SignatureIndex)>> =
+        HashMap::new();
+    let mut has_dynamic_table_writes = false;
+    let mut dynamic_table_write_tables = HashSet::new();
+    let mut ref_func_targets = HashSet::new();
+    for (local_index, body) in function_body_inputs.iter() {
+        let function_index = FunctionIndex::from_u32(imported_functions + local_index.as_u32());
+        let mut reader = MiddlewareBinaryReader::new_with_offset(body.data, body.module_offset);
+        let local_count = reader
+            .read_local_count()
+            .map_err(|err| CompileError::Codegen(err.to_string()))?;
+        for _ in 0..local_count {
+            reader
+                .read_local_decl()
+                .map_err(|err| CompileError::Codegen(err.to_string()))?;
+        }
+        while !reader.eof() {
+            match reader
+                .read_operator()
+                .map_err(|err| CompileError::Codegen(err.to_string()))?
+            {
+                Operator::Call {
+                    function_index: callee_index,
+                }
+                | Operator::ReturnCall {
+                    function_index: callee_index,
+                } => {
+                    direct_callees
+                        .entry(function_index)
+                        .or_default()
+                        .push(FunctionIndex::from_u32(callee_index));
+                }
+                Operator::CallIndirect {
+                    type_index,
+                    table_index,
+                }
+                | Operator::ReturnCallIndirect {
+                    type_index,
+                    table_index,
+                } => {
+                    indirect_callee_signatures
+                        .entry(function_index)
+                        .or_default()
+                        .push((
+                            TableIndex::from_u32(table_index),
+                            SignatureIndex::from_u32(type_index),
+                        ));
+                }
+                Operator::TableSet { table }
+                | Operator::TableFill { table }
+                | Operator::TableGrow { table, .. } => {
+                    has_dynamic_table_writes = true;
+                    dynamic_table_write_tables.insert(TableIndex::from_u32(table));
+                }
+                Operator::RefFunc { function_index } => {
+                    ref_func_targets.insert(FunctionIndex::from_u32(function_index));
+                }
+                _ => {}
+            }
+        }
+    }
+    if has_dynamic_table_writes {
+        for table in dynamic_table_write_tables {
+            for function in &ref_func_targets {
+                let signature = module.functions[*function];
+                possible_indirect_callees
+                    .entry((table, signature))
+                    .or_default()
+                    .insert(*function);
+            }
+        }
+    }
+
+    let mut reaches_fork = proc_fork_imports;
+    let mut indirect_calls = HashSet::new();
+    loop {
+        let mut changed = false;
+        let fork_reachable_indirect_calls = possible_indirect_callees
+            .iter()
+            .filter_map(|(call_target, callees)| {
+                callees
+                    .iter()
+                    .any(|callee| reaches_fork.contains(callee))
+                    .then_some(*call_target)
+            })
+            .collect::<HashSet<_>>();
+
+        for (function, callees) in &direct_callees {
+            if reaches_fork.contains(function) {
+                continue;
+            }
+            if callees.iter().any(|callee| reaches_fork.contains(callee)) {
+                reaches_fork.insert(*function);
+                changed = true;
+            }
+        }
+        for (function, signatures) in &indirect_callee_signatures {
+            if reaches_fork.contains(function) {
+                continue;
+            }
+            if signatures
+                .iter()
+                .any(|signature| fork_reachable_indirect_calls.contains(signature))
+            {
+                reaches_fork.insert(*function);
+                changed = true;
+            }
+        }
+        for call_target in fork_reachable_indirect_calls {
+            if indirect_calls.insert(call_target) {
+                changed = true;
+            }
+        }
+        if !changed {
+            break;
+        }
+    }
+
+    tracing::debug!(
+        proc_fork_imports = proc_fork_import_count,
+        direct_callers = direct_callees.len(),
+        indirect_callers = indirect_callee_signatures.len(),
+        possible_indirect_signatures = possible_indirect_callees.len(),
+        dynamic_table_writes = has_dynamic_table_writes,
+        reachable_functions = reaches_fork.len(),
+        reachable_indirect_signatures = indirect_calls.len(),
+        "computed native fork reachability"
+    );
+
+    Ok(NativeForkReachability {
+        functions: Arc::new(reaches_fork),
+        indirect_calls: Arc::new(indirect_calls),
+    })
+}
+
+fn possible_indirect_callees_by_table_signature(
+    module: &ModuleInfo,
+) -> HashMap<(TableIndex, SignatureIndex), HashSet<FunctionIndex>> {
+    let mut callees_by_signature: HashMap<(TableIndex, SignatureIndex), HashSet<FunctionIndex>> =
+        HashMap::new();
+    for initializer in &module.table_initializers {
+        for function in initializer.elements.iter().copied() {
+            let signature = module.functions[function];
+            callees_by_signature
+                .entry((initializer.table_index, signature))
+                .or_default()
+                .insert(function);
+        }
+    }
+
+    let all_tables = module
+        .tables
+        .iter()
+        .map(|(table, _)| table)
+        .collect::<Vec<_>>();
+    for elements in module.passive_elements.values() {
+        for function in elements.iter().copied() {
+            let signature = module.functions[function];
+            for table in &all_tables {
+                callees_by_signature
+                    .entry((*table, signature))
+                    .or_default()
+                    .insert(function);
+            }
+        }
+    }
+    callees_by_signature
+}
