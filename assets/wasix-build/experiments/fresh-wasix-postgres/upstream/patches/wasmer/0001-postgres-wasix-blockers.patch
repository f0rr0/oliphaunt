+#[derive(Clone, Copy)]
+enum PgWritePathClass {
+    PgWal,
+    BaseMainFork,
+    BaseAuxFork,
+    PgXact,
+    Temp,
+    Control,
+    Other,
+}
+
+struct FdPwriteDetail {
+    class: PgWritePathClass,
+    path: Option<String>,
+    iov_count: Option<usize>,
+    sync_flags: Fdflags,
+}
+
+impl FdPwriteDetail {
+    fn capture<M: MemorySize>(fd_entry: &Fd, iovs_len: M::Offset) -> Option<Self> {
+        if !crate::perf::enabled() {
+            return None;
+        }
+
+        let (class, path) = classify_pg_write_path(fd_entry);
+        Some(Self {
+            class,
+            path,
+            iov_count: from_offset::<M>(iovs_len).ok(),
+            sync_flags: fd_entry.inner.flags,
+        })
+    }
+
+    fn record(&self, fd: WasiFd, offset: u64, bytes_written: usize, elapsed: Duration) {
+        let bytes = bytes_written as u64;
+        crate::perf::record_duration_event("syscall.fd_pwrite.detail", elapsed, bytes);
+        crate::perf::record_pwrite_offset(fd, offset, bytes);
+        if let Some(path) = self.path.as_deref() {
+            crate::perf::record_pwrite_path(path, elapsed, bytes);
+        }
+        record_pwrite_file_class(self.class, elapsed, bytes);
+        record_pwrite_iov_bucket(self.iov_count);
+        record_pwrite_byte_bucket(bytes);
+        record_pwrite_latency_bucket(elapsed);
+        record_pwrite_sync_bucket(self.sync_flags);
+    }
+}
+
+fn classify_pg_write_path(fd_entry: &Fd) -> (PgWritePathClass, Option<String>) {
+    let mut observed_path = None;
+    {
+        let kind = fd_entry.inode.read();
+        if let Kind::File { path, .. } = kind.deref() {
+            let path = path.to_string_lossy().into_owned();
+            let class = classify_pg_write_path_str(&path);
+            observed_path = Some(path);
+            if !matches!(class, PgWritePathClass::Other) {
+                return (class, observed_path);
+            }
+        }
+    }
+
+    let name = fd_entry.inode.name.read().unwrap().to_string();
+    let class = classify_pg_write_path_str(name.as_ref());
+    let path = observed_path.or_else(|| (!name.is_empty()).then_some(name));
+    (class, path)
+}
+
+fn classify_pg_write_path_str(path: &str) -> PgWritePathClass {
+    if path.contains("/pg_wal/") || path.starts_with("pg_wal/") || path.contains("/pg_xlog/") {
+        return PgWritePathClass::PgWal;
+    }
+    if path.contains("/pg_xact/") || path.starts_with("pg_xact/") {
+        return PgWritePathClass::PgXact;
+    }
+    if path.contains("pgsql_tmp") {
+        return PgWritePathClass::Temp;
+    }
+    if path.ends_with("/global/pg_control") || path == "global/pg_control" {
+        return PgWritePathClass::Control;
+    }
+    if path.contains("/base/") || path.starts_with("base/") || path.contains("/global/") {
+        if path.ends_with("_fsm") || path.ends_with("_vm") || path.ends_with("_init") {
+            PgWritePathClass::BaseAuxFork
+        } else {
+            PgWritePathClass::BaseMainFork
+        }
+    } else {
+        PgWritePathClass::Other
+    }
+}
+
+fn record_pwrite_file_class(class: PgWritePathClass, elapsed: Duration, bytes: u64) {
+    let name = match class {
+        PgWritePathClass::PgWal => "syscall.fd_pwrite.file.pg_wal",
+        PgWritePathClass::BaseMainFork => "syscall.fd_pwrite.file.base_main_fork",
+        PgWritePathClass::BaseAuxFork => "syscall.fd_pwrite.file.base_aux_fork",
+        PgWritePathClass::PgXact => "syscall.fd_pwrite.file.pg_xact",
+        PgWritePathClass::Temp => "syscall.fd_pwrite.file.temp",
+        PgWritePathClass::Control => "syscall.fd_pwrite.file.pg_control",
+        PgWritePathClass::Other => "syscall.fd_pwrite.file.other",
+    };
+    crate::perf::record_duration_event(name, elapsed, bytes);
+}
+
+fn record_pwrite_iov_bucket(iov_count: Option<usize>) {
+    let name = match iov_count {
+        Some(0) => "syscall.fd_pwrite.iovs.0",
+        Some(1) => "syscall.fd_pwrite.iovs.1",
+        Some(2..=4) => "syscall.fd_pwrite.iovs.2_4",
+        Some(5..=16) => "syscall.fd_pwrite.iovs.5_16",
+        Some(_) => "syscall.fd_pwrite.iovs.gt_16",
+        None => "syscall.fd_pwrite.iovs.unknown",
+    };
+    crate::perf::record_event(name, 0);
+}
+
+fn record_pwrite_byte_bucket(bytes: u64) {
+    let name = if bytes <= 512 {
+        "syscall.fd_pwrite.bytes.le_512"
+    } else if bytes <= 4 * 1024 {
+        "syscall.fd_pwrite.bytes.le_4k"
+    } else if bytes <= 32 * 1024 {
+        "syscall.fd_pwrite.bytes.le_32k"
+    } else if bytes <= 256 * 1024 {
+        "syscall.fd_pwrite.bytes.le_256k"
+    } else if bytes <= 1024 * 1024 {
+        "syscall.fd_pwrite.bytes.le_1m"
+    } else {
+        "syscall.fd_pwrite.bytes.gt_1m"
+    };
+    crate::perf::record_event(name, bytes);
+}
+
+fn record_pwrite_latency_bucket(elapsed: Duration) {
+    let micros = elapsed.as_micros();
+    let name = if micros <= 10 {
+        "syscall.fd_pwrite.latency.le_10us"
+    } else if micros <= 100 {
+        "syscall.fd_pwrite.latency.le_100us"
+    } else if micros <= 1_000 {
+        "syscall.fd_pwrite.latency.le_1ms"
+    } else if micros <= 10_000 {
+        "syscall.fd_pwrite.latency.le_10ms"
+    } else if micros <= 100_000 {
+        "syscall.fd_pwrite.latency.le_100ms"
+    } else {
+        "syscall.fd_pwrite.latency.gt_100ms"
+    };
+    crate::perf::record_event(name, 0);
+}
+
+fn record_pwrite_sync_bucket(fd_flags: Fdflags) {
+    let name = if fd_flags.contains(Fdflags::SYNC) {
+        "syscall.fd_pwrite.sync_flag.sync"
+    } else if fd_flags.contains(Fdflags::DSYNC) {
+        "syscall.fd_pwrite.sync_flag.dsync"
+    } else {
+        "syscall.fd_pwrite.sync_flag.none"
+    };
+    crate::perf::record_event(name, 0);
+}
+
+fn record_regular_write_path(
+    positioned_write: bool,
+    blocking: bool,
+    elapsed: Duration,
+    bytes: u64,
+) {
+    let name = match (positioned_write, blocking) {
+        (true, true) => "syscall.fd_pwrite.write_path.blocking",
+        (true, false) => "syscall.fd_pwrite.write_path.async_fallback",
+        (false, true) => "syscall.fd_write.write_path.blocking",
+        (false, false) => "syscall.fd_write.write_path.async_fallback",
+    };
+    crate::perf::record_duration_event(name, elapsed, bytes);
+}
+
+fn blocking_sync_available(handle: &(dyn VirtualFile + Send + Sync), fd_flags: Fdflags) -> bool {
+    if fd_flags.contains(Fdflags::SYNC) {
+        handle.is_sync_on_write(true) || handle.has_blocking_sync_all_to_disk()
+    } else if fd_flags.contains(Fdflags::DSYNC) {
+        handle.is_sync_on_write(false) || handle.has_blocking_sync_data_to_disk()
+    } else {
+        true
+    }
+}
+
+fn sync_after_blocking_write(
+    handle: &mut (dyn VirtualFile + Send + Sync),
+    fd_flags: Fdflags,
+) -> Result<(), Errno> {
+    if fd_flags.contains(Fdflags::SYNC) {
+        if !handle.is_sync_on_write(true) {
+            handle.sync_all_to_disk_blocking().map_err(map_io_err)?;
+        }
+    } else if fd_flags.contains(Fdflags::DSYNC) && !handle.is_sync_on_write(false) {
+        handle.sync_data_to_disk_blocking().map_err(map_io_err)?;
+    }
+    Ok(())
+}
+
+fn positioned_write_needs_explicit_sync(fd_flags: Fdflags) -> bool {
+    fd_flags.intersects(Fdflags::SYNC | Fdflags::DSYNC)
+}
+
+fn is_all_zero(buf: &[u8]) -> bool {
+    buf.iter().all(|byte| *byte == 0)
+}
+
+fn try_write_file_positioned_shared_blocking<M: MemorySize>(
+    handle: &(dyn VirtualFile + Send + Sync),
+    memory: &wasmer::MemoryView<'_>,
+    data: &FdWriteSource<'_, M>,
+    offset: u64,
+    fd_flags: Fdflags,
+) -> Result<Option<usize>, Errno> {
+    if positioned_write_needs_explicit_sync(fd_flags) || !handle.has_blocking_write_at_shared() {
+        return Ok(None);
