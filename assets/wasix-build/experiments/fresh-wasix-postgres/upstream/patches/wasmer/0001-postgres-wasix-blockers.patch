+        let capture = match store.objects_mut().as_sys_mut().take_native_fork_capture() {
+            Some(capture) => capture,
+            None => {
+                warn!("native fork safepoint returned without captured continuation values");
+                return Ok(OnCalledAction::Trap(Box::new(WasiError::Exit(
+                    Errno::Notsup.into(),
+                ))));
+            }
+        };
+        let innermost = capture.frames.first();
+        trace!(
+            frames = capture.frames.len(),
+            innermost_function = innermost.map(|frame| frame.function_index),
+            innermost_stackmap = innermost.map(|frame| frame.stackmap_id),
+            "native fork safepoint captured"
+        );
+
+        let mut ctx = func.into_mut(&mut store);
+        let (child_env, child_handle) = match ctx.data().fork() {
+            Ok(p) => p,
+            Err(err) => {
+                debug!("could not fork process after native safepoint capture: {err}");
+                return Ok(OnCalledAction::Trap(Box::new(WasiError::Exit(
+                    Errno::Perm.into(),
+                ))));
+            }
+        };
