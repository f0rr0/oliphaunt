+fn prime_socket_readiness(handler_guard: &mut HandlerGuardState, fd: RawFd) {
+    let Some(revents) = libc_poll(
+        fd,
+        libc::POLLIN | libc::POLLOUT | libc::POLLHUP | libc::POLLERR,
+    ) else {
+        return;
+    };
+
