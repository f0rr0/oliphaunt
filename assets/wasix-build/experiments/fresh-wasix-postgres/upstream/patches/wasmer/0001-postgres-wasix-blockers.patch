+        let child_pid = child_env.process.pid();
+        let child_process = child_env.process.clone();
+        let parent_process = ctx.data().process.clone();
+        let parent_tasks = ctx.data().tasks().clone();
+        let tasks = child_env.tasks().clone();
+        let child_resume = capture.clone();
+        let parent_resume = capture;
