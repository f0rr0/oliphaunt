+#!/usr/bin/env bash
+set -euo pipefail
+
+export WASIXCC_WASM_EXCEPTIONS=yes
+
+"$CC" -O0 -g3 -fPIC -sPIC=yes -pthread main.c -o main -Wl,-pie
