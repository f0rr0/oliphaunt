+            let env_inner = ctx.data().inner();
+            let instance_handles = env_inner.main_module_instance_handles();
+            (
+                instance_handles.module_clone(),
+                instance_handles.memory_clone(),
+                env_inner.linker().cloned(),
+            )
+        };
+        let shared_mappings = SharedMemoryMappingSet::new(state.shared_memory_mappings());
+        let spawn_type = match linker {
+            Some(linker) => SpawnType::NewLinkerCopiedInstanceGroup(
+                linker,
+                ctx.as_ref(),
+                ctx.as_store_mut(),
+                shared_mappings,
+            ),
+            None => SpawnType::CopyMemory(memory, ctx.as_store_ref(), shared_mappings),
+        };
