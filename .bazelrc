# Keep local executions independent from hosted cache or execution configuration.
startup --max_idle_secs=300
startup --shutdown_on_low_sys_mem
startup --host_jvm_args=-Xmx2048m
common --repo_env=DO_NOT_TRACK=1
common --lockfile_mode=error
build --incompatible_strict_action_env
# Compiler and quality tools use the runtime acquired by pinned rules_java.
build --java_runtime_version=remotejdk_17
build --tool_java_runtime_version=remotejdk_17
test --test_output=errors

# Cross-platform runtime tests need manifest or directory runfiles.
# Windows native file symlinks require Developer Mode or administrator privileges.
startup --windows_enable_symlinks
build --enable_runfiles

# Native C++ links need the allocator ABI generated by the selected Rust compiler.
build --@rules_rust//rust/settings:experimental_use_allocator_libraries_with_mangled_symbols=true

# Native Clippy checks use the same configuration as conventional Cargo checks.
build --@rules_rust//rust/settings:clippy.toml=//:clippy.toml
build --@rules_rust//rust/settings:clippy_flags=-Dwarnings

# Darwin sandbox reuse otherwise traverses the complete SDK forest per action.
build:macos-sandbox --experimental_inmemory_sandbox_stashes

# The LLVM serializer runs on Linux; serialized product targets remain separate.
build:wasix-aot --extra_execution_platforms=//build_defs/wasix:llvm_serializer_linux_x86_64

# Optional CI disk cache: callers supply an absolute --disk_cache path.
build:ci-cache --experimental_remote_merkle_tree_cache
