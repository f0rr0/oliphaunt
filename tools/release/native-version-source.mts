/** A version transition is exactly the bytes generated by the frozen candidate. */
import assert from 'node:assert/strict';
import { execFileSync } from 'node:child_process';
import { createHash } from 'node:crypto';
import { readFileSync } from 'node:fs';
import path from 'node:path';
import type { NativeBuildSource } from './native-build-qualification.mts';

type Identity = { size: number; sha256: string };
export type NativeVersionUpdate = { path: string; before?: Identity; after: Identity };
export type NativeVersionSourceBridge = {
  source: NativeBuildSource;
  updates: NativeVersionUpdate[];
  updatesSha256: string;
};
const digest = (bytes: Uint8Array) => createHash('sha256').update(bytes).digest('hex');
const identity = (bytes: Uint8Array): Identity => ({ size: bytes.length, sha256: digest(bytes) });
const exactFields = (value: object, fields: string[]) =>
  assert.deepEqual(Object.keys(value).sort(), fields.sort(), 'version transition fields differ');
const safePath = (file: string) => {
  assert.ok(
    typeof file === 'string' &&
      file &&
      !file.startsWith('/') &&
      !/[\\\u0000-\u001f\u007f]/u.test(file) &&
      file.normalize('NFC') === file &&
      !file.split('/').some((part) => !part || part === '.' || part === '..'),
    'version transition requires a safe repository path',
  );
  return file;
};
const sourceIdentity = (source: NativeBuildSource) => {
  exactFields(source, ['commit', 'tree']);
  for (const sha of [source.commit, source.tree]) assert.match(sha, /^[a-f0-9]{40}$/u);
};
const assertIdentity = (value: Identity) => {
  exactFields(value, ['size', 'sha256']);
  assert.ok(Number.isSafeInteger(value.size) && value.size >= 0);
  assert.match(value.sha256, /^[a-f0-9]{64}$/u);
};

/** Share this observer with the existing RP and synchronization writers. */
export function collectNativeVersionUpdates() {
  const rows = new Map<string, NativeVersionUpdate>();
  return {
    observe({
      path: file,
      before,
      after,
    }: {
      path: string;
      before?: Uint8Array;
      after: Uint8Array;
    }) {
      safePath(file);
      const previous = rows.get(file);
      const beforeIdentity = before === undefined ? undefined : identity(before);
      if (previous)
        assert.deepEqual(
          beforeIdentity,
          previous.after,
          'generated update writer changed its preceding bytes',
        );
      rows.set(file, {
        path: file,
        ...((previous ? previous.before : beforeIdentity) === undefined
          ? {}
          : { before: previous ? previous.before : beforeIdentity }),
        after: identity(after),
      });
    },
    freeze(source: NativeBuildSource): NativeVersionSourceBridge {
      sourceIdentity(source);
      const updates = [...rows.values()]
        .filter((row) => JSON.stringify(row.before) !== JSON.stringify(row.after))
        .sort((left, right) => left.path.localeCompare(right.path));
      return {
        source: structuredClone(source),
        updates: structuredClone(updates),
        updatesSha256: digest(Buffer.from(JSON.stringify(updates))),
      };
    },
  };
}

export function validateNativeVersionSourceBridge(bridge: NativeVersionSourceBridge) {
  exactFields(bridge, ['source', 'updates', 'updatesSha256']);
  sourceIdentity(bridge.source);
  assert.ok(
    Array.isArray(bridge.updates) && bridge.updates.length > 0,
    'version transition needs actual generated updates',
  );
  for (const row of bridge.updates) {
    exactFields(row, ['path', 'after', ...(row.before === undefined ? [] : ['before'])]);
    safePath(row.path);
    if (row.before !== undefined) assertIdentity(row.before);
    assertIdentity(row.after);
  }
  assert.deepEqual(
    bridge.updates.map((row) => row.path),
    [...new Set(bridge.updates.map((row) => row.path))].sort((left, right) =>
      left.localeCompare(right),
    ),
    'version transition update order differs',
  );
  assert.equal(
    bridge.updatesSha256,
    digest(Buffer.from(JSON.stringify(bridge.updates))),
    'version transition generated update digest differs',
  );
  return structuredClone(bridge);
}

/** No path allowlist can substitute for exact generated content and file modes. */
export function assertNativeVersionSourceTransition(
  bridge: NativeVersionSourceBridge,
  finalSource: NativeBuildSource,
  directory = process.cwd(),
) {
  validateNativeVersionSourceBridge(bridge);
  sourceIdentity(finalSource);
  const git = (...args: string[]) =>
    execFileSync('git', args, { cwd: directory, maxBuffer: 64 * 1024 * 1024 });
  for (const source of [bridge.source, finalSource])
    assert.equal(
      git('rev-parse', `${source.commit}^{tree}`).toString('utf8').trim(),
      source.tree,
      'version transition commit/tree differs',
    );
  const changed = git(
    'diff-tree',
    '-r',
    '--no-commit-id',
    '--name-only',
    '-z',
    bridge.source.tree,
    finalSource.tree,
  )
    .toString('utf8')
    .split('\0')
    .filter(Boolean)
    .sort((left, right) => left.localeCompare(right));
  assert.deepEqual(
    changed,
    bridge.updates.map((row) => row.path),
    'version transition contains changes outside the generated updates',
  );
  const entry = (source: NativeBuildSource, file: string) => {
    const row = git('ls-tree', '-z', source.tree, '--', file).toString('utf8');
    if (!row) return undefined;
    const match = /^(100644|100755) blob ([a-f0-9]{40})\t([^\0]+)\0$/u.exec(row);
    assert.ok(match && match[3] === file, 'version transition requires regular tracked Files');
    return { mode: match[1], identity: identity(git('cat-file', 'blob', match[2])) };
  };
  for (const update of bridge.updates) {
    const before = entry(bridge.source, update.path);
    const after = entry(finalSource, update.path);
    assert.deepEqual(before?.identity, update.before, 'version transition original bytes differ');
    assert.deepEqual(after?.identity, update.after, 'version transition generated bytes differ');
    assert.equal(after?.mode, before?.mode ?? '100644', 'version transition changed a File mode');
  }
  return { source: structuredClone(finalSource), updatesSha256: bridge.updatesSha256 };
}

/** Commit only the already observed writers' output, never ambient checkout changes. */
export function commitNativeVersionUpdates(
  bridge: NativeVersionSourceBridge,
  title: string,
  directory = process.cwd(),
) {
  validateNativeVersionSourceBridge(bridge);
  assert.match(title, /^chore\(release\): [^\r\n]+$/u);
  const git = (...args: string[]) =>
    execFileSync('git', args, {
      cwd: directory,
      encoding: 'utf8',
      maxBuffer: 64 * 1024 * 1024,
    }).trim();
  assert.equal(git('rev-parse', 'HEAD'), bridge.source.commit, 'native candidate source advanced');
  assert.equal(
    git('diff', '--cached', '--name-only'),
    '',
    'native candidate has ambient staged changes',
  );
  const changed = git('diff', '--name-only', '-z').split('\0').filter(Boolean).sort();
  const existingUpdates = bridge.updates
    .filter((row) => row.before !== undefined)
    .map((row) => row.path)
    .sort();
  assert.deepEqual(changed, existingUpdates, 'native candidate has ambient tracked changes');
  for (const row of bridge.updates) {
    assert.deepEqual(
      identity(readFileSync(path.join(directory, row.path))),
      row.after,
      'native candidate generated bytes changed before commit',
    );
  }
  git('add', '--', ...bridge.updates.map((row) => row.path));
  const bot = JSON.parse(readFileSync(path.join(import.meta.dir, 'release-bot.json'), 'utf8'));
  git('-c', `user.name=${bot.name}`, '-c', `user.email=${bot.email}`, 'commit', '-m', title);
  const source = { commit: git('rev-parse', 'HEAD'), tree: git('rev-parse', 'HEAD^{tree}') };
  assertNativeVersionSourceTransition(bridge, source, directory);
  return source;
}
