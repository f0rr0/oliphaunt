    mobile_static_modules = [_DESCRIPTORS[name]["native-module-file"][:-3] for name in ANDROID_COMPILED_EXTENSIONS], icu = "//src/database-resources:icu_payload", version = PRODUCTS["liboliphaunt-native"]["version"], abi = _ABI,
    leaves = select({_ARM64: ["//build_defs/extensions/mobile/final:" + product.replace("-", "_") + "_android_arm64_v8a" for product in sorted({row["artifactProduct"]: True for row in EXTENSION_RELEASE_METADATA if row["sqlName"] in ANDROID_SELECTED_EXTENSIONS}.keys())],
                     _X64: ["//build_defs/extensions/mobile/final:" + product.replace("-", "_") + "_android_x86_64" for product in sorted({row["artifactProduct"]: True for row in EXTENSION_RELEASE_METADATA if row["sqlName"] in ANDROID_SELECTED_EXTENSIONS}.keys())]}))

_LIBRARIES = {
    ":liboliphauntreactnative.so": "liboliphauntreactnative.so", ":liboliphaunt_extensions.so": "liboliphaunt_extensions.so",
    ":jna_library": "libjnidispatch.so", "@expo_android_sources//:libexpo-modules-core.so": "libexpo-modules-core.so",
