diff --git a/lib/api/src/entities/instance.rs b/lib/api/src/entities/instance.rs
index edea32f..ae5033e 100644
--- a/lib/api/src/entities/instance.rs
+++ b/lib/api/src/entities/instance.rs
@@ -20,6 +20,44 @@ pub struct Instance {
 }
 
 impl Instance {
+    /// Asynchronously creates a new JavaScript-backed WebAssembly instance.
+    ///
+    /// This uses `WebAssembly.instantiate()` so browsers can instantiate large
+    /// modules without hitting the synchronous constructor's size limit. Other
+    /// enabled backends retain their regular synchronous instantiation path.
+    #[cfg(all(feature = "js", target_arch = "wasm32"))]
+    #[allow(clippy::result_large_err)]
+    pub async fn new_async(
+        store: &mut impl AsStoreMut,
+        module: &Module,
+        imports: &Imports,
+    ) -> Result<Self, InstantiationError> {
+        let (_inner, exports) = match &store.as_store_mut().inner.store {
+            #[cfg(feature = "sys")]
+            crate::BackendStore::Sys(_) => {
+                let (i, e) = crate::backend::sys::instance::Instance::new(store, module, imports)?;
+                (crate::BackendInstance::Sys(i), e)
+            }
+            #[cfg(feature = "v8")]
+            crate::BackendStore::V8(_) => {
+                let (i, e) = crate::backend::v8::instance::Instance::new(store, module, imports)?;
+                (crate::BackendInstance::V8(i), e)
+            }
+            crate::BackendStore::Js(_) => {
+                let (i, e) =
+                    crate::backend::js::instance::Instance::new_async(store, module, imports)
+                        .await?;
+                (crate::BackendInstance::Js(i), e)
+            }
+        };
+
+        Ok(Self {
+            _inner,
+            module: module.clone(),
+            exports,
+        })
+    }
+
     /// Creates a new `Instance` from a WebAssembly [`Module`] and a
     /// set of imports using [`Imports`] or the [`imports!`] macro helper.
     ///
