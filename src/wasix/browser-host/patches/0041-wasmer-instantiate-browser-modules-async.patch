From: Sid Jain <sid_26@outlook.com>
Date: Sun, 4 Oct 2026 00:00:00 +0000
Subject: [PATCH] Instantiate large browser modules asynchronously

WebAssembly.instantiate avoids the synchronous main-realm size limit. Share
import validation and retain table-function annotations for indirect calls.
Enabled non-JavaScript backends keep their synchronous instantiation.

diff --git a/lib/api/src/backend/js/entities/instance.rs b/lib/api/src/backend/js/entities/instance.rs
index 22a7a71..e847fd4 100644
--- a/lib/api/src/backend/js/entities/instance.rs
+++ b/lib/api/src/backend/js/entities/instance.rs
@@ -19,6 +19,21 @@ pub struct Instance {
 // unsafe impl Send for Instance {}
 
 impl Instance {
+    #[cfg(target_arch = "wasm32")]
+    pub(crate) async fn new_async(
+        mut store: &mut impl AsStoreMut,
+        module: &Module,
+        imports: &Imports,
+    ) -> Result<(Self, Exports), InstantiationError> {
+        let instance = module
+            .as_js()
+            .instantiate_async(&mut store, imports)
+            .await
+            .map_err(InstantiationError::Start)?;
+
+        Self::from_module_and_instance(store, module, instance)
+    }
+
     pub(crate) fn new(
         mut store: &mut impl AsStoreMut,
         module: &Module,
