+// This poller processes signals while the main working function is idle.
+// The work is borrowed through its existing pin so a caller may poll it once
+// before entering the blocking path without moving or recreating the future.
+struct SignalPoller<'a, 'b, 'c, Fut, T>
+where
+    Fut: Future<Output = Result<T, Errno>>,
+{
+    ctx: &'a mut FunctionEnvMut<'b, WasiEnv>,
+    pinned_work: Pin<&'c mut Fut>,
+}
+impl<Fut, T> Future for SignalPoller<'_, '_, '_, Fut, T>
+where
+    Fut: Future<Output = Result<T, Errno>>,
+{
+    type Output = Result<Fut::Output, WasiError>;
+    fn poll(mut self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<Self::Output> {
+        if let Poll::Ready(res) = self.pinned_work.as_mut().poll(cx) {
+            return Poll::Ready(Ok(res));
+        }
+        if let Some(signals) = self.ctx.data().thread.pop_signals_or_subscribe(cx.waker()) {
+            if let Err(err) = WasiEnv::process_signals_internal(self.ctx, signals) {
+                return Poll::Ready(Err(err));
+            }
+            return Poll::Ready(Ok(Err(Errno::Intr)));
+        }
+        Poll::Pending
+    }
+}
+
+fn asyncify_continue<T, Fut>(
+    ctx: &mut FunctionEnvMut<'_, WasiEnv>,
+    timeout: Option<Duration>,
+    pinned_work: Pin<&mut Fut>,
+) -> WasiResult<T>
+where
+    T: 'static,
+    Fut: Future<Output = Result<T, Errno>>,
+{
+    let tasks = ctx.data().tasks().clone();
+    let poller = SignalPoller { ctx, pinned_work };
+    block_on_with_timeout(&tasks, timeout, poller)
+}
+
+fn poll_ready_once<Fut>(work: Pin<&mut Fut>, cx: &mut Context<'_>) -> Poll<Fut::Output>
+where
+    Fut: Future,
+{
+    work.poll(cx)
+}
