From: Sid Jain <sid_26@outlook.com>
Date: Sun, 4 Oct 2026 00:00:00 +0000
Subject: [PATCH] Preserve typed browser execution and IO policies

Embedded PostgreSQL has one execution realm and must reject guest process or
thread spawning instead of deadlocking the caller. Keep this per instance,
with canonical WASIX behavior as the default. Synchronous filesystems may
skip the close-time flush barrier; explicit fsync/fdatasync remain intact.
Propagate asynchronous main instantiation through both static and dynamic
linking without bypassing upstream runtime hooks. Browser clock optimizations
are installed by the embedder through those hooks, not by this policy.

diff --git a/lib/wasix/src/capabilities.rs b/lib/wasix/src/capabilities.rs
index b95f5e5..6dab333 100644
--- a/lib/wasix/src/capabilities.rs
+++ b/lib/wasix/src/capabilities.rs
@@ -2,6 +2,53 @@ use std::time::Duration;
 
 use crate::http::HttpClientCapabilityV1;
 
+/// Defines how much guest-controlled execution a WASI environment permits.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Hash)]
+pub enum WasiGuestExecutionMode {
+    /// Retain the normal WASIX process and thread behavior.
+    #[default]
+    General,
+    /// Keep the initial program as the environment's only process and thread.
+    SingleProgram,
+}
+
+/// Describes whether a filesystem needs WASIX to flush before closing a file.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Hash)]
+pub enum WasiFdClosePolicy {
+    /// Preserve the upstream flush-before-close behavior.
+    #[default]
+    FlushBeforeClose,
+    /// Writes complete synchronously, so POSIX close must not become fsync.
+    WritesCompleteSynchronously,
+}
+
+/// Immutable host-selected execution policy for one WASI environment.
+///
+/// This policy is deliberately separate from guest environment variables and
+/// from mergeable [`Capabilities`]. The builder fixes it before instantiation.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Hash)]
+pub struct WasiHostPolicy {
+    guest_execution: WasiGuestExecutionMode,
+    fd_close: WasiFdClosePolicy,
+}
+
+impl WasiHostPolicy {
+    pub const fn new(guest_execution: WasiGuestExecutionMode, fd_close: WasiFdClosePolicy) -> Self {
+        Self {
+            guest_execution,
+            fd_close,
+        }
+    }
+
+    pub const fn guest_execution(self) -> WasiGuestExecutionMode {
+        self.guest_execution
+    }
+
+    pub const fn fd_close(self) -> WasiFdClosePolicy {
+        self.fd_close
+    }
+}
+
 /// Defines capabilities for a Wasi environment.
 #[derive(Clone, Debug, PartialEq, Eq, Hash)]
 pub struct Capabilities {
