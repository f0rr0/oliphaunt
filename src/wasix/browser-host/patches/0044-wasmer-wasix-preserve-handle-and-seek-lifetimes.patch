+    fn registry_removal_does_not_borrow_the_registered_value() {
+        let registry = RefCell::new(HashMap::new());
+        registry
+            .borrow_mut()
+            .insert(7, Rc::new(RefCell::new(41_u8)));
+        let inner = clone_registered(&registry, 7).expect("registered value");
+        let retained = inner.borrow();
+        assert!(inner.try_borrow_mut().is_err());
+        assert!(remove_registered(&registry, 7).is_some());
+        assert!(registry.borrow().is_empty());
