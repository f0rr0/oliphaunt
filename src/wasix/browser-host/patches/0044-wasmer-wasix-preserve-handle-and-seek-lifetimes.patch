-                    return Poll::Ready(Err(err));
-                }
-                return Poll::Ready(Ok(Err(Errno::Intr)));
+
+    futures::pin_mut!(work);
+    let waker = WasiDummyWaker.into_waker();
+    let mut cx = Context::from_waker(&waker);
+    if let Poll::Ready(res) = poll_ready_once(work.as_mut(), &mut cx) {
+        return Ok(res);
+    }
+
+    // Preserve SignalPoller's work-then-signals ordering across the split poll.
+    // This check therefore happens after the first work poll but before the
+    // continuation is allowed to perform its second work poll.
+    let signals = ctx.data().thread.pop_signals();
+    if !signals.is_empty() {
+        if let Err(err) = WasiEnv::process_signals_internal(ctx, signals) {
+            return Err(err);
+        }
+        return Ok(Err(Errno::Intr));
+    }
+
+    asyncify_continue(ctx, None, work)
+}
