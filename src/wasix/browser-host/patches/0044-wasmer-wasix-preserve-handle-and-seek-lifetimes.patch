+/// Asyncify work that commonly finishes on its first poll and never times out.
+///
+/// Ready work (including an error) wins over a queued signal, matching the
+/// existing signal poller's ordering. After Pending, queued signals are handled
+/// before the same pinned future can be polled a second time. The continuation
+/// deliberately skips the exit check already performed here.
+pub(crate) fn __asyncify_ready_no_timeout<T, Fut>(
+    ctx: &mut FunctionEnvMut<'_, WasiEnv>,
+    work: Fut,
+) -> WasiResult<T>
+where
+    T: 'static,
+    Fut: Future<Output = Result<T, Errno>>,
+{
+    let env = ctx.data();
+
+    // This must remain the only exit check on both the ready and pending paths.
+    if let Some(exit_code) = env.should_exit() {
+        return Err(WasiError::Exit(exit_code));
     }
