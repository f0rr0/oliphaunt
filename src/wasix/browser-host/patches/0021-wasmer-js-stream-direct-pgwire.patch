+const DEFAULT_PROGRAM_NAME: &str = "wasm";
+const PROTOCOL_CHUNK_BYTES: usize = 64 * 1024;
+const TOOL_OUTPUT_LIMIT_BYTES: usize = 67108864;
+
+#[wasm_bindgen]
+extern "C" {
+    #[wasm_bindgen(typescript_type = "OliphauntToolOutput")]
+    pub type JsToolOutput;
