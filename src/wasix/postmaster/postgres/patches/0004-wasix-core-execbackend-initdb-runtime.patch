+#ifdef __wasi__
+/*
+ * WASIX supports real subprocesses and pipes, but its libc popen() currently
+ * routes through /bin/sh.  PostgreSQL owns this argv exactly, so keep the
+ * upstream validation behavior while avoiding a shell dependency.
+ */
+static char *
+wasix_read_first_line_from_argv(char *const argv[])
+{
+	__wasi_process_handles_t handles;
+	__wasi_errno_t wasi_rc;
+	char	   *args;
+	char	   *line = NULL;
+	size_t		line_size = 0;
+	size_t		line_len = 0;
+	char		ch;
+	ssize_t		nread;
+
+	args = wasix_join_argv_lines(argv);
+	if (args == NULL)
+		return NULL;
+
+	wasi_rc = __wasi_proc_spawn(argv[0],
+								0,
+								args,
+								"",
+								__WASI_STDIO_MODE_NULL,
+								__WASI_STDIO_MODE_PIPED,
+								__WASI_STDIO_MODE_NULL,
+								".",
+								&handles);
+	free(args);
+	if (wasi_rc != 0)
+	{
+		log_error(errcode(ERRCODE_SYSTEM_ERROR),
+				  _("could not execute command \"%s\": WASIX proc_spawn failed with errno %d"),
+				  argv[0], wasi_rc);
+		return NULL;
+	}
+
+	if (handles.stdout.tag == 0)
+	{
+		log_error(errcode(ERRCODE_SYSTEM_ERROR),
+				  _("command \"%s\" did not return a stdout pipe"), argv[0]);
+		(void) wasix_join_process(handles.pid, argv[0]);
+		return NULL;
+	}
+
+	for (;;)
+	{
+		nread = read(handles.stdout.u.some, &ch, 1);
+		if (nread < 0 && errno == EINTR)
+			continue;
+		if (nread != 1)
+			break;
+		if (line_len + 2 >= line_size)
+		{
+			size_t		new_size = line_size == 0 ? 128 : line_size * 2;
+#ifndef FRONTEND
+			char	   *new_line = line == NULL ? palloc(new_size) : repalloc(line, new_size);
+#else
+			char	   *new_line = realloc(line, new_size);
+
+			if (new_line == NULL)
+			{
+				free(line);
+				line = NULL;
+				log_error(errcode(ERRCODE_OUT_OF_MEMORY),
+						  _("out of memory"));
+				break;
+			}
+#endif
+			line = new_line;
+			line_size = new_size;
+		}
+		line[line_len++] = ch;
+		if (ch == '\n')
+			break;
+	}
+	close(handles.stdout.u.some);
+
+	if (nread < 0)
+	{
+		log_error(errcode_for_file_access(),
+				  _("could not read from command \"%s\": %m"), argv[0]);
+#ifndef FRONTEND
+		pfree(line);
+#else
+		free(line);
+#endif
+		line = NULL;
+	}
+	else if (line == NULL)
+	{
+		log_error(errcode(ERRCODE_NO_DATA),
+				  _("no data was returned by command \"%s\""), argv[0]);
+	}
+	else
+	{
+		line[line_len] = '\0';
+	}
+
+	if (wasix_join_process(handles.pid, argv[0]) != 0 && line != NULL)
+	{
+#ifndef FRONTEND
+		pfree(line);
+#else
+		free(line);
+#endif
+		line = NULL;
+	}
+
+	return line;
+}
+
+static char *
+wasix_join_argv_lines(char *const argv[])
+{
+	size_t		len = 1;
+	char	   *args;
+	char	   *pos;
+	int			i;
+
+	for (i = 0; argv[i] != NULL; i++)
+		len += strlen(argv[i]) + 1;
+
+	args = malloc(len);
+	if (args == NULL)
+	{
+		log_error(errcode(ERRCODE_OUT_OF_MEMORY), _("out of memory"));
+		return NULL;
+	}
+
+	pos = args;
+	for (i = 0; argv[i] != NULL; i++)
+	{
+		size_t		arglen = strlen(argv[i]);
+
+		if (i > 0)
+			*pos++ = '\n';
+		memcpy(pos, argv[i], arglen);
+		pos += arglen;
+	}
+	*pos = '\0';
+
+	return args;
+}
+
+static int
+wasix_join_process(__wasi_pid_t pid, const char *command)
+{
+	__wasi_option_pid_t join_pid;
+	__wasi_join_status_t join_status;
+	__wasi_errno_t wasi_rc;
+
+	join_pid.tag = 1;
+	join_pid.u.some = pid;
+	wasi_rc = __wasi_proc_join(&join_pid, 0, &join_status);
+	if (wasi_rc != 0)
+	{
+		log_error(errcode(ERRCODE_SYSTEM_ERROR),
+				  _("could not wait for command \"%s\": WASIX proc_join failed with errno %d"),
+				  command, wasi_rc);
+		return -1;
+	}
+
+	if (join_status.tag != __WASI_JOIN_STATUS_TYPE_EXIT_NORMAL)
+	{
+		log_error(errcode(ERRCODE_SYSTEM_ERROR),
+				  _("command \"%s\" did not exit normally under WASIX"), command);
+		return -1;
+	}
+
+	if (join_status.u.exit_normal != 0)
+	{
+		log_error(errcode(ERRCODE_SYSTEM_ERROR),
+				  _("command \"%s\" exited with status %d"),
+				  command, join_status.u.exit_normal);
+		return join_status.u.exit_normal;
+	}
+
+	return 0;
+}
+#endif
