 typedef struct Latch
 {
+#ifdef PG_WASIX_ATOMIC_LATCH_STATE
+	pg_atomic_uint32 state;
+	uint32		state_reserved;
+#else
 	sig_atomic_t is_set;
 	sig_atomic_t maybe_sleeping;
+#endif
 	bool		is_shared;
 	int			owner_pid;
 #ifdef WIN32
@@ -121,6 +136,77 @@ typedef struct Latch
 #endif
 } Latch;
 
+#ifdef PG_WASIX_ATOMIC_LATCH_STATE
+/*
+ * WASIX maps one PostgreSQL shared-memory file into several Wasm instances.
+ * Keep the latch predicate and waiter publication in one sequentially
+ * consistent atomic word so whole-program optimization cannot turn their
+ * cross-instance synchronization into ordinary LLVM memory operations.
+ * state_reserved retains the upstream two-word layout; it is not state.
+ */
+#define PG_WASIX_LATCH_STATE_SET		((uint32) 1)
+#define PG_WASIX_LATCH_STATE_SLEEPING	((uint32) 2)
+#define PG_WASIX_LATCH_STATE_VALID \
+	(PG_WASIX_LATCH_STATE_SET | PG_WASIX_LATCH_STATE_SLEEPING)
+
+typedef struct PGWasixUpstreamLatchLayout
+{
+	sig_atomic_t is_set;
+	sig_atomic_t maybe_sleeping;
+	bool		is_shared;
+	int			owner_pid;
+} PGWasixUpstreamLatchLayout;
+
+StaticAssertDecl(sizeof(pg_atomic_uint32) == sizeof(uint32),
+				 "WASIX latch state must be exactly one uint32");
+StaticAssertDecl(__alignof__(pg_atomic_uint32) >= __alignof__(uint32),
+				 "WASIX latch state must be naturally uint32-aligned");
+StaticAssertDecl(__atomic_always_lock_free(sizeof(uint32), 0),
+				 "WASIX latch state must be signal-safe and lock-free");
+StaticAssertDecl(sizeof(Latch) == sizeof(PGWasixUpstreamLatchLayout),
+				 "WASIX latch must preserve the upstream size");
+StaticAssertDecl(offsetof(Latch, state) ==
+				 offsetof(PGWasixUpstreamLatchLayout, is_set),
+				 "WASIX latch must preserve the is_set word offset");
+StaticAssertDecl(offsetof(Latch, state_reserved) ==
+				 offsetof(PGWasixUpstreamLatchLayout, maybe_sleeping),
+				 "WASIX latch must preserve the maybe_sleeping word offset");
+StaticAssertDecl(offsetof(Latch, is_shared) ==
+				 offsetof(PGWasixUpstreamLatchLayout, is_shared),
+				 "WASIX latch must preserve the is_shared offset");
+StaticAssertDecl(offsetof(Latch, owner_pid) ==
+				 offsetof(PGWasixUpstreamLatchLayout, owner_pid),
+				 "WASIX latch must preserve the owner_pid offset");
+
+/* Unlike pg_atomic_read_u32(), this is a true SC atomic load. */
+static inline uint32
+pg_wasix_latch_state_read(const Latch *latch)
+{
+	return __atomic_load_n(&latch->state.value, __ATOMIC_SEQ_CST);
+}
+
+static inline bool
+pg_wasix_latch_state_is_set(const Latch *latch)
+{
+	return (pg_wasix_latch_state_read(latch) &
+			PG_WASIX_LATCH_STATE_SET) != 0;
+}
+
+static inline bool
+pg_wasix_latch_state_is_sleeping(const Latch *latch)
+{
+	return (pg_wasix_latch_state_read(latch) &
+			PG_WASIX_LATCH_STATE_SLEEPING) != 0;
+}
+
+static inline bool
+pg_wasix_latch_state_is_set_and_sleeping(const Latch *latch)
+{
+	return (pg_wasix_latch_state_read(latch) &
+			PG_WASIX_LATCH_STATE_VALID) == PG_WASIX_LATCH_STATE_VALID;
+}
+#endif
