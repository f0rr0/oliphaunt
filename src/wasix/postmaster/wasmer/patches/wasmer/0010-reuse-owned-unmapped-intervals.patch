+    fn reusable_range(&self, len: u64) -> Result<Option<(usize, u64)>, Errno> {
+        // Preserve the guest's WebAssembly page alignment for non-fixed mmap.
+        const ALIGN: u64 = 65_536;
+        for (index, range) in self.unmapped.iter().enumerate() {
+            let start = range.start.checked_add(ALIGN - 1).ok_or(Errno::Overflow)? & !(ALIGN - 1);
+            if start.checked_add(len).ok_or(Errno::Overflow)? <= range.end {
+                return Ok(Some((index, start)));
+            }
+        }
+        Ok(None)
+    }
+
+    fn reclaim(&mut self, start: u64, len: u64) -> Result<(), Errno> {
+        let mut end = start.checked_add(len).ok_or(Errno::Overflow)?;
+        let index = self.unmapped.partition_point(|range| range.end < start);
+        let mut first = start;
+        let mut last = index;
+        while let Some(range) = self.unmapped.get(last) {
+            if range.start > end {
+                break;
+            }
+            first = first.min(range.start);
+            end = end.max(range.end);
+            last += 1;
+        }
+        self.unmapped.splice(index..last, [first..end]);
+        Ok(())
+    }
+
+    fn consume_reusable(&mut self, index: usize, start: u64, len: u64) -> Result<(), Errno> {
+        let end = start.checked_add(len).ok_or(Errno::Overflow)?;
+        let range = self.unmapped[index].clone();
+        self.unmapped.splice(
+            index..=index,
+            [
+                (range.start < start).then_some(range.start..start),
+                (end < range.end).then_some(end..range.end),
+            ]
+            .into_iter()
+            .flatten(),
+        );
+        Ok(())
+    }
