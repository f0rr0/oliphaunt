Subject: [PATCH] wasix: service trusted-session deadlines at backend boundaries

Use the existing PostgreSQL timeout queue without a host process timer.
Detect CPU expiry without throwing; dispatch ordinary handlers only at safe
interrupt points, bounded waits and re-entry after the live recovery frame.
This does not interrupt an inactive guest or an arbitrary host-blocked read.

diff --git a/src/backend/storage/ipc/waiteventset.c b/src/backend/storage/ipc/waiteventset.c
index b074652..11aaf34 100644
--- a/src/backend/storage/ipc/waiteventset.c
+++ b/src/backend/storage/ipc/waiteventset.c
@@ -77,6 +77,9 @@
 #include "storage/waiteventset.h"
 #include "utils/memutils.h"
 #include "utils/resowner.h"
+#ifdef OLIPHAUNT_WASM_SINGLE_USER
+#include "utils/timeout.h"
+#endif
 
 /*
  * Select the fd readiness primitive to use. Normally the "most modern"
@@ -1070,6 +1073,12 @@ WaitEventSetWait(WaitEventSet *set, long timeout,
 	while (returned_events == 0)
 	{
 		int			rc;
+#ifdef OLIPHAUNT_WASM_SINGLE_USER
+		bool		embedded_timeout_selected = false;
+		long		block_timeout = cur_timeout;
+
+		ProcessEmbeddedTimeouts();
+#endif
 
 		/*
 		 * Check if the latch is set already first.  If so, we either exit
@@ -1136,7 +1145,23 @@ WaitEventSetWait(WaitEventSet *set, long timeout,
 		 * this file. If -1 is returned, a timeout has occurred, if 0 we have
 		 * to retry, everything >= 1 is the number of returned events.
 		 */
+#ifdef OLIPHAUNT_WASM_SINGLE_USER
+		block_timeout = cur_timeout;
+		if (EmbeddedTimeoutsActive)
+		{
+			long		embedded_timeout = GetEmbeddedTimeoutDelayMilliseconds();
+
+			if (embedded_timeout >= 0 &&
+				(block_timeout < 0 || embedded_timeout <= block_timeout))
+			{
+				block_timeout = embedded_timeout;
+				embedded_timeout_selected = true;
+			}
+		}
+		rc = WaitEventSetWaitBlock(set, block_timeout,
+#else
 		rc = WaitEventSetWaitBlock(set, cur_timeout,
+#endif
 								   occurred_events, nevents - returned_events);
 
 		if (set->latch &&
@@ -1144,7 +1169,17 @@ WaitEventSetWait(WaitEventSet *set, long timeout,
 			set->latch->maybe_sleeping = false;
 
 		if (rc == -1)
-			break;				/* timeout occurred */
+		{
+#ifdef OLIPHAUNT_WASM_SINGLE_USER
+			if (embedded_timeout_selected)
+			{
+				/* The backend deadline wins ties with the caller timeout. */
+				ProcessEmbeddedTimeouts();
+			}
+			else
+#endif
+				break;			/* caller timeout occurred */
+		}
 		else
 			returned_events += rc;
 
