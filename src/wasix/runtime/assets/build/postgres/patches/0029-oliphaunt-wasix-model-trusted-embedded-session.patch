@@ -3642,7 +3665,7 @@ struct config_int ConfigureNamesInt[] =
 		},
 		&max_parallel_workers,
 		8, 0, MAX_PARALLEL_WORKER_LIMIT,
-		NULL, NULL, NULL
+		CHECK_OLIPHAUNT_SINGLE_BACKEND_WORKER_LIMIT, NULL, NULL
 	},
 
 	{
