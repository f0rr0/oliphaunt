From: Sid Jain <sid_26@outlook.com>
Date: Thu, 8 Oct 2026 00:00:00 +0000
Subject: [PATCH 1/3] wasix: respect optional runner feature boundaries

Keep journal and host filesystem runner imports and fields behind their existing
feature gates so the minimal desktop feature set compiles.

The complete ordered series is the build and qualification unit.

diff --git a/src/runners/wasi.rs b/src/runners/wasi.rs
--- a/src/runners/wasi.rs
+++ b/src/runners/wasi.rs
@@ -9,11 +9,12 @@
 use wasmer_types::ModuleHash;
 use webc::metadata::{Command, annotations::Wasi};
 
+#[cfg(feature = "journal")]
+use crate::journal::{DynJournal, DynReadableJournal, SnapshotTrigger};
 use crate::{
     Runtime, WasiEnvBuilder, WasiError, WasiRuntimeError,
     bin_factory::BinaryPackage,
     capabilities::Capabilities,
-    journal::{DynJournal, DynReadableJournal, SnapshotTrigger},
     runners::{MappedDirectory, MountedDirectory, wasi_common::CommonWasiOptions},
     runtime::task_manager::VirtualTaskManagerExt,
 };
@@ -364,13 +365,16 @@
 
         let wasi = webc::metadata::annotations::Wasi::new(program_name);
 
-        let mut builder = runner.prepare_webc_env(
+        let builder = runner.prepare_webc_env(
             program_name,
             &wasi,
             PackageOrHash::Hash(module_hash),
             runtime_or_engine,
             None,
         )?;
+
+        #[cfg(any(feature = "ctrlc", feature = "journal"))]
+        let mut builder = builder;
 
         #[cfg(feature = "ctrlc")]
         {
diff --git a/src/runners/wasi_common.rs b/src/runners/wasi_common.rs
--- a/src/runners/wasi_common.rs
+++ b/src/runners/wasi_common.rs
@@ -6,6 +6,7 @@
 };
 
 use anyhow::{Context, Error};
+#[cfg(feature = "host-fs")]
 use tokio::runtime::Handle;
 use virtual_fs::{
     ArcFileSystem, ExactMountConflictMode, FileSystem, MountFileSystem, OverlayFileSystem,
@@ -13,12 +14,13 @@
 };
 use webc::metadata::annotations::Wasi as WasiAnnotation;
 
+#[cfg(feature = "journal")]
+use crate::journal::{DynJournal, DynReadableJournal, SnapshotTrigger};
 use crate::{
     WasiEnvBuilder,
     bin_factory::{BinaryPackage, BinaryPackageMounts},
     capabilities::Capabilities,
     fs::WasiFsRoot,
-    journal::{DynJournal, DynReadableJournal, SnapshotTrigger},
 };
 
 pub const MAPPED_CURRENT_DIR_DEFAULT_PATH: &str = "/home";
@@ -49,10 +51,15 @@
     pub(crate) is_home_mapped: bool,
     pub(crate) injected_packages: Vec<BinaryPackage>,
     pub(crate) capabilities: Capabilities,
+    #[cfg(feature = "journal")]
     pub(crate) read_only_journals: Vec<Arc<DynReadableJournal>>,
+    #[cfg(feature = "journal")]
     pub(crate) writable_journals: Vec<Arc<DynJournal>>,
+    #[cfg(feature = "journal")]
     pub(crate) snapshot_on: Vec<SnapshotTrigger>,
+    #[cfg(feature = "journal")]
     pub(crate) snapshot_interval: Option<std::time::Duration>,
+    #[cfg(feature = "journal")]
     pub(crate) stop_running_after_snapshot: bool,
     pub(crate) skip_stdio_during_bootstrap: bool,
     pub(crate) current_dir: Option<PathBuf>,
