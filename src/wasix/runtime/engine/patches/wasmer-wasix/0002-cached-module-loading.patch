From: Sid Jain <sid_26@outlook.com>
Date: Thu, 8 Oct 2026 00:00:00 +0000
Subject: [PATCH 2/3] wasix: require cached modules for SDK runtime loading

Add an opt-in cache-only policy to the existing Runtime abstraction and preserve
it through runtime overrides. The SDK enables it to keep cache misses from
compiling guests or extensions at runtime.

The complete ordered series is the build and qualification unit.

diff --git a/src/runtime/mod.rs b/src/runtime/mod.rs
--- a/src/runtime/mod.rs
+++ b/src/runtime/mod.rs
@@ -353,6 +353,11 @@
         Arc::new(UnsupportedPackageLoader)
     }
 
+    /// Require cached modules instead of compiling on cache misses.
+    fn module_cache_only(&self) -> bool {
+        false
+    }
+
     /// A cache for compiled modules.
     fn module_cache(&self) -> Arc<dyn ModuleCache + Send + Sync> {
         // Return a cache that uses a thread-local variable. This isn't ideal
@@ -471,7 +476,21 @@
 
         let module_cache = self.module_cache();
 
-        let task = async move { load_module(&engine, &module_cache, input, on_progress).await };
+        let cache_only = self.module_cache_only();
+        let task = async move {
+            if cache_only {
+                let result = if let Some(progress) = on_progress {
+                    module_cache
+                        .load_with_progress(input.hash(), &engine, progress)
+                        .await
+                } else {
+                    module_cache.load(input.hash(), &engine).await
+                };
+                result.map_err(SpawnError::CacheError)
+            } else {
+                load_module(&engine, &module_cache, input, on_progress).await
+            }
+        };
         Box::pin(task)
     }
 
@@ -674,6 +693,7 @@
     pub source: Arc<dyn Source + Send + Sync>,
     pub engine: Engine,
     pub module_cache: Arc<dyn ModuleCache + Send + Sync>,
+    pub module_cache_only: bool,
