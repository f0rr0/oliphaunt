From: Sid Jain <sid_26@outlook.com>
Date: Thu, 8 Oct 2026 00:00:00 +0000
Subject: [PATCH 3/3] wasix: propagate terminal shared memory cancellation

Use the engine terminal-cancellation operation for process shutdown. Propagate
failed shared-memory attachment through the existing task and linker errors
instead of panicking when shutdown races with task creation.

The complete ordered series is the build and qualification unit.

diff --git a/src/os/task/process.rs b/src/os/task/process.rs
--- a/src/os/task/process.rs
+++ b/src/os/task/process.rs
@@ -925,9 +925,9 @@
     };
 
     if signal == Signal::Sigkill {
-        // On kill, disable atomics to prevent threads from resuming.
-        // NOTE: disable_atomics also wakes all current waiters.
-        if let Err(err) = memory.disable_atomics() {
+        // Terminal cancellation: V8 interrupts whole execution contexts;
+        // Sys keeps its existing memory-specific atomics shutdown.
+        if let Err(err) = memory.terminate_execution_contexts() {
             tracing::trace!(
                 pid=%process.pid,
                 error = &err as &dyn std::error::Error,
diff --git a/src/runtime/task_manager/mod.rs b/src/runtime/task_manager/mod.rs
--- a/src/runtime/task_manager/mod.rs
+++ b/src/runtime/task_manager/mod.rs
@@ -206,7 +206,10 @@
                 })?;
                 Ok(Some(mem))
             }
-            SpawnType::AttachMemory(mem) => Ok(Some(mem.attach(store))),
+            SpawnType::AttachMemory(mem) => mem
+                .try_attach(store)
+                .map(Some)
+                .map_err(WasiThreadError::MemoryCreateFailed),
             SpawnType::CreateMemory | SpawnType::NewLinkerInstanceGroup(..) => Ok(None),
         }
     }
diff --git a/src/runtime/task_manager/tokio.rs b/src/runtime/task_manager/tokio.rs
--- a/src/runtime/task_manager/tokio.rs
+++ b/src/runtime/task_manager/tokio.rs
@@ -150,7 +150,9 @@
                 SpawnType::CreateMemoryOfType(t) => (SpawnMemoryTypeOrStore::Type(t), None),
                 SpawnType::AttachMemory(mem) => {
                     let mut store = task.env.runtime().new_store();
-                    let memory = mem.attach(&mut store);
+                    let memory = mem
+                        .try_attach(&mut store)
+                        .map_err(WasiThreadError::MemoryCreateFailed)?;
                     (SpawnMemoryTypeOrStore::StoreAndMemory(store, memory), None)
                 }
             };
diff --git a/src/state/linker/mod.rs b/src/state/linker/mod.rs
--- a/src/state/linker/mod.rs
+++ b/src/state/linker/mod.rs
@@ -692,7 +692,7 @@
 
         let mut imports = import_object_for_all_wasi_versions(&main_module, store, &func_env.env);
 
-        let memory = memory.attach(store);
+        let memory = memory.try_attach(store)?;
 
         let indirect_function_table = create_indirect_function_table(
             store,
