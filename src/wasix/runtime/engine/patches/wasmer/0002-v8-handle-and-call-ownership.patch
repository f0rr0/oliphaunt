+// Delete owned argument and result vectors on every return path.
+pub(super) struct OwnedValueVec(pub(super) wasm_val_vec_t);
+impl std::ops::Deref for OwnedValueVec {
+    type Target = wasm_val_vec_t;
+    fn deref(&self) -> &Self::Target {
+        &self.0
+    }
+}
+impl std::ops::DerefMut for OwnedValueVec {
+    fn deref_mut(&mut self) -> &mut Self::Target {
+        &mut self.0
+    }
+}
+impl Drop for OwnedValueVec {
+    fn drop(&mut self) {
+        unsafe { wasm_val_vec_delete(&mut self.0) }
+    }
+}
+// C vectors adopt reference wrappers; borrow a Function only through a copy.
+pub(super) fn own_call_parameter(value: wasm_val_t) -> wasm_val_t {
+    if value.kind == wasm_valkind_enum_WASM_FUNCREF as _ {
+        let mut owned = value;
+        unsafe { wasm_val_copy(&mut owned, &value) };
+        owned
+    } else {
+        value
+    }
+}
+
+// Returned Function aliases must outlive the temporary native result vector.
+pub(super) fn into_call_value(
+    mut value: wasm_val_t,
+    expected: wasmer_types::Type,
+    store: &mut impl AsStoreMut,
+) -> Value {
+    // The pinned C API reports returned function references as generic refs.
+    if expected == wasmer_types::Type::FuncRef {
+        value.kind = wasm_valkind_enum_WASM_FUNCREF as _;
+        let pointer = unsafe { value.of.ref_ };
+        if pointer.is_null() {
+            return Value::FuncRef(None);
+        }
+        let owned = unsafe { wasm_ref_copy(pointer) };
+        store
+            .as_store_mut()
+            .inner
+            .store
+            .as_v8_mut()
+            .owned_refs
+            .push(super::super::store::OwnedRef(owned));
+        value.of.ref_ = owned;
+    }
+    value.into_wv()
+}
