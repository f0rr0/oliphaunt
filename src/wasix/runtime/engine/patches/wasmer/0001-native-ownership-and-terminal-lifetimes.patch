+mod oliphaunt_contract {
+    use super::*;
+
+    const GUEST: &[u8] = b"\0asm\x01\0\0\0\x01\x05\x01\x60\0\x01\x7f\x03\x02\x01\0\x07\x0a\x01\x06answer\0\0\x0a\x06\x01\x04\0\x41\x2a\x0b";
+
+    fn native_offset(cache: &[u8]) -> usize {
+        assert!(cache[0] < 128, "the fixture has a one-byte wire length");
+        1 + usize::from(cache[0])
+    }
+
+    fn encoded(info: &V8ModuleInfo) -> Vec<u8> {
+        rkyv::to_bytes::<rkyv::rancor::Error>(info).unwrap().to_vec()
+    }
+
+    #[test]
+    fn rejects_wire_only_and_incompatible_caches_without_compilation() {
+        let engine: crate::Engine = crate::v8::V8::try_new().unwrap().into();
+        let module = Module::from_binary(&engine, GUEST).unwrap();
+        let mut info = module.info.clone();
+        let offset = native_offset(&info.v8_module_bytes[0]);
+        info.v8_module_bytes[0].truncate(offset);
+        let error = unsafe { crate::Module::deserialize(&engine, encoded(&info)) }.unwrap_err();
+        assert!(error.to_string().contains("guest compilation is disabled"));
+
+        let mut info = module.info.clone();
+        // Deliberately incompatible test bytes, never a producer workaround.
+        info.v8_module_bytes[0][offset + 8..offset + 12].copy_from_slice(&u32::MAX.to_le_bytes());
+        assert!(unsafe { crate::Module::deserialize(&engine, encoded(&info)) }.is_err());
+    }
+
+    #[test]
+    fn skips_an_incompatible_cpu_profile_and_executes_the_next_native_cache() {
+        let engine: crate::Engine = crate::v8::V8::try_new().unwrap().into();
+        let module = Module::from_binary(&engine, GUEST).unwrap();
+        let mut info = module.info.clone();
+        let original = info.v8_module_bytes[0].clone();
+        let offset = native_offset(&original);
+        assert_eq!(u32::from_le_bytes(original[offset + 8..offset + 12].try_into().unwrap()), 0x1000e, "the native runner must qualify the CET profile");
+        info.v8_module_bytes[0][offset + 8..offset + 12].copy_from_slice(&u32::MAX.to_le_bytes());
+        info.v8_module_bytes.push(original);
+        let loaded = unsafe { crate::Module::deserialize(&engine, encoded(&info)) }.unwrap();
+        let mut store = crate::Store::new(engine);
+        let instance = crate::Instance::new(&mut store, &loaded, &crate::imports! {}).unwrap();
+        let answer = instance.exports.get_typed_function::<(), i32>(&store, "answer").unwrap();
+        assert_eq!(answer.call(&mut store).unwrap(), 42);
+    }
+
+    #[test]
+    fn rejects_variants_for_another_guest() {
+        let engine: crate::Engine = crate::v8::V8::try_new().unwrap().into();
+        let module = Module::from_binary(&engine, GUEST).unwrap();
+        let mut different = GUEST.to_vec();
+        let position = different.len() - 2;
+        different[position] = 43;
+        let other = Module::from_binary(&engine, &different).unwrap();
+        assert!(module.serialize_with_native_variants(&other.info.v8_module_bytes).is_err());
