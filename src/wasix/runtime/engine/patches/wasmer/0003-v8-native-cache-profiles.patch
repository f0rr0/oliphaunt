+    /// Serialize this module with additional producer-built native CPU profiles.
+    /// Every profile must contain the same WebAssembly wire bytes.
+    pub fn serialize_with_native_variants(
+        &self,
+        variants: &[Vec<u8>],
+    ) -> Result<Bytes, SerializeError> {
+        fn wire(bytes: &[u8]) -> Option<&[u8]> {
+            let mut length = 0u64;
+            for (index, byte) in bytes.iter().copied().take(10).enumerate() {
+                if index == 9 && byte > 1 {
+                    return None;
+                }
+                length |= u64::from(byte & 0x7f) << (index * 7);
+                if byte & 0x80 == 0 {
+                    let end = (index + 1).checked_add(usize::try_from(length).ok()?)?;
+                    if bytes.len().checked_sub(end)? < 20 {
+                        return None;
+                    }
+                    return bytes.get(index + 1..end);
+                }
+            }
+            None
+        }
+        let original = self
+            .info
+            .v8_module_bytes
+            .first()
+            .ok_or_else(|| SerializeError::Generic("module has no native cache".into()))?;
+        let expected = wire(original)
+            .ok_or_else(|| SerializeError::Generic("module has no complete native cache".into()))?;
+        let mut info = self.info.clone();
+        for variant in variants {
+            if wire(variant) != Some(expected) {
+                return Err(SerializeError::Generic(
+                    "native cache wire identity mismatch".into(),
+                ));
+            }
+            info.v8_module_bytes.push(variant.clone());
+        }
+        rkyv::to_bytes::<rkyv::rancor::Error>(&info)
+            .map(|bytes| bytes.to_vec().into())
+            .map_err(|error| SerializeError::Generic(format!("{error:?}")))
     }
 
