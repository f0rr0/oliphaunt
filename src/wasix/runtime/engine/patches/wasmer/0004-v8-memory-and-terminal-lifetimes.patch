 impl Drop for Store {
     fn drop(&mut self) {
+        // These vectors uniquely own the export wrappers. Rust export clones
+        // borrow them through their Store, so retain them until Store teardown.
+        self.interrupt.retire();
+        self.shared_memories.get_mut().clear();
+        self.owned_exports.clear();
+        self.owned_refs.clear();
         unsafe { wasm_store_delete(self.inner) }
     }
 }
