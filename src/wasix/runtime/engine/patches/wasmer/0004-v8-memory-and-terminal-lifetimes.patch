+    /// Attach shared memory, returning an error after V8 terminal cancellation.
+    ///
+    /// This permits task creation to race with terminal cancellation without
+    /// unwinding through the task or linker. Other backends retain their
+    /// existing attachment behavior.
+    pub fn try_attach(self, store: &mut impl AsStoreMut) -> Result<Memory, crate::MemoryError> {
+        let memory = match self.memory {
+            #[cfg(feature = "v8")]
+            VMSharedMemory::V8(memory) => {
+                let mut store = store.as_store_mut();
+                VMMemory::V8(memory.try_into_vm_memory(store.inner.store.as_v8_mut())?)
+            }
+            memory => memory.into_vm_memory(store),
+        };
+        Ok(Memory::new_from_existing(store, memory))
+    }
