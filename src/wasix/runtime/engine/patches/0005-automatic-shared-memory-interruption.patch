@@ -0,0 +1,122 @@
+use std::{cell::Cell, ffi::c_void, sync::{Arc, Mutex, Weak}};
+
+use crate::{error::AtomicsError, location::SharedMemoryOps};
+use crate::backend::v8::bindings::*;
+
+#[cfg(not(windows))]
+unsafe extern "C" {
+    #[link_name = "_ZN2v87Isolate10GetCurrentEv"]
+    fn current_isolate() -> *mut c_void;
+    #[link_name = "_ZN2v87Isolate18TerminateExecutionEv"]
+    fn terminate_execution(isolate: *mut c_void);
+}
+#[cfg(windows)]
+use crate::backend::v8::bindings::{
+    oliphaunt_v8_current_isolate as current_isolate,
+    oliphaunt_v8_terminate_execution as terminate_execution,
+};
+
+thread_local! { static CAPTURED: Cell<usize> = const { Cell::new(0) }; }
+
+unsafe extern "C" fn capture(
+    _args: *const wasm_val_vec_t,
+    _results: *mut wasm_val_vec_t,
+) -> *mut wasm_trap_t {
+    // The pinned C API enters the Store's isolate before a direct host call.
+    CAPTURED.with(|slot| slot.set(unsafe { current_isolate() } as usize));
+    std::ptr::null_mut()
+}
+
+pub(super) struct StoreInterrupt(Mutex<Option<usize>>);
+
+impl StoreInterrupt {
+    pub(super) fn new() -> Arc<Self> { Arc::new(Self(Mutex::new(None))) }
+
+    pub(super) fn capture(&self, store: *mut wasm_store_t) {
+        unsafe {
+            let mut params = std::mem::zeroed();
+            let mut results = std::mem::zeroed();
+            let ty = wasm_functype_new(&mut params, &mut results);
+            assert!(!ty.is_null(), "cannot create V8 interrupt capture type");
+            let function = wasm_func_new(store, ty, Some(capture));
+            wasm_functype_delete(ty);
+            assert!(!function.is_null(), "cannot create V8 interrupt capture function");
+            let owner = super::ResearchRef(wasm_func_as_ref(function));
+            let mut args = std::mem::zeroed();
+            let mut results = std::mem::zeroed();
+            CAPTURED.with(|slot| slot.set(0));
+            let trap = wasm_func_call(function, &mut args, &mut results);
+            let pointer = CAPTURED.with(Cell::get);
+            if !trap.is_null() { wasm_trap_delete(trap); }
+            drop(owner);
+            assert!(trap.is_null() && pointer != 0, "cannot capture V8 Store interrupt");
+            *self.0.lock().unwrap_or_else(|e| e.into_inner()) = Some(pointer);
+        }
+    }
+
+    fn terminate(&self) {
+        // Keep the lock through termination. Store teardown takes this same
+        // lock before retiring the pointer and deleting the native Store.
+        let pointer = self.0.lock().unwrap_or_else(|e| e.into_inner());
+        if let Some(pointer) = *pointer {
+            unsafe { terminate_execution(pointer as *mut c_void) };
+        }
+    }
+
+    pub(super) fn retire(&self) {
+        *self.0.lock().unwrap_or_else(|e| e.into_inner()) = None;
+    }
+}
+
+#[derive(Default)]
+struct MemoryState {
+    disabled: bool,
+    stores: Vec<Weak<StoreInterrupt>>,
+}
+
+pub(crate) struct MemoryInterrupt(Mutex<MemoryState>);
+
+impl MemoryInterrupt {
+    pub(super) fn new(store: &Arc<StoreInterrupt>) -> Arc<Self> {
+        Arc::new(Self(Mutex::new(MemoryState {
+            disabled: false, stores: vec![Arc::downgrade(store)],
+        })))
+    }
+
+    pub(crate) fn attach(
+        self: &Arc<Self>,
+        store: &mut super::Store,
+        memory: *mut wasm_shared_memory_t,
+    ) -> *mut wasm_memory_t {
+        let mut state = self.0.lock().unwrap_or_else(|e| e.into_inner());
+        if state.disabled {
+            // attach's existing infallible API cannot return a MemoryError.
+            // Release the lock before rejecting so cancellation stays usable.
+            drop(state);
+            panic!("cannot attach V8 shared memory after atomics are disabled");
+        }
+        let handle = unsafe { wasm_memory_obtain(store.inner, memory) };
+        assert!(!handle.is_null(), "cannot obtain V8 shared memory");
+        state.stores.retain(|entry| entry.strong_count() != 0);
+        let interrupt = Arc::downgrade(&store.interrupt);
+        if !state.stores.iter().any(|entry| Weak::ptr_eq(entry, &interrupt)) {
+            state.stores.push(interrupt);
+        }
+        store.remember_shared_memory(handle, self.clone());
+        handle
+    }
+}
+
+impl SharedMemoryOps for MemoryInterrupt {
+    fn disable_atomics(&self) -> Result<(), AtomicsError> {
+        let mut state = self.0.lock().unwrap_or_else(|e| e.into_inner());
+        state.disabled = true;
+        state.stores.retain(|entry| {
+            if let Some(store) = entry.upgrade() {
+                store.terminate();
+                true
+            } else { false }
+        });
+        Ok(())
+    }
+}
