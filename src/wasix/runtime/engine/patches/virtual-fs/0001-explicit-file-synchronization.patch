diff --git a/src/lib.rs b/src/lib.rs
index e0987244..63fba5d1 100644
--- a/src/lib.rs
+++ b/src/lib.rs
@@ -345,6 +345,18 @@ impl<'a> OpenOptions<'a> {
 pub trait VirtualFile:
     fmt::Debug + AsyncRead + AsyncWrite + AsyncSeek + Unpin + Upcastable + Send
 {
+    /// Synchronize data to the backing store, separately from draining writes.
+    /// Memory files and existing providers retain their flush contract; durable
+    /// host files must override this with a checked data synchronization.
+    fn poll_sync_data(self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<io::Result<()>> {
+        self.poll_flush(cx)
+    }
+
+    /// Synchronize data and metadata to the backing store.
+    fn poll_sync_all(self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<io::Result<()>> {
+        self.poll_flush(cx)
+    }
+
     /// the last time the file was accessed in nanoseconds as a UNIX timestamp
     fn last_accessed(&self) -> u64;
 
diff --git a/src/mem_fs/file.rs b/src/mem_fs/file.rs
index 311d65a5..800d41d7 100644
--- a/src/mem_fs/file.rs
+++ b/src/mem_fs/file.rs
@@ -54,6 +54,37 @@ impl Clone for FileHandle {
 }
 
 impl FileHandle {
+    fn poll_sync(&mut self, cx: &mut Context<'_>, data_only: bool) -> Poll<io::Result<()>> {
+        let fs = self
+            .filesystem
+            .inner
+            .read()
+            .map_err(|_| io::Error::other("failed to acquire a read lock"))?;
+        let file = match fs.storage.get(self.inode) {
+            Some(Node::CustomFile(node)) => {
+                let mut file = node.file.lock().unwrap();
+                return if data_only {
+                    Pin::new(file.as_mut()).poll_sync_data(cx)
+                } else {
+                    Pin::new(file.as_mut()).poll_sync_all(cx)
+                };
+            }
+            Some(Node::ArcFile(_)) => {
+                drop(fs);
+                self.lazy_load_arc_file_mut().map_err(io::Error::from)?
+            }
+            Some(Node::File(_) | Node::OffloadedFile(_) | Node::ReadOnlyFile(_)) => {
+                return Poll::Ready(Ok(()));
+            }
+            _ => return Poll::Ready(Err(io::ErrorKind::NotFound.into())),
+        };
+        if data_only {
+            Pin::new(file).poll_sync_data(cx)
+        } else {
+            Pin::new(file).poll_sync_all(cx)
+        }
+    }
+
     pub(super) fn new_opened(
         inode: Inode,
         filesystem: FileSystem,
@@ -116,6 +147,14 @@ impl FileHandle {
 }
 
