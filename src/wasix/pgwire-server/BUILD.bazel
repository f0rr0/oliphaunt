load("//build_defs/quality:sources.bzl", "rust_quality_files")
load("//build_defs/languages:rust.bzl", "cargo_binary", "cargo_integration_test", "cargo_library", "cargo_library_test", "cargo_package_env")
load("@rules_rust//rust:defs.bzl", "rust_clippy_test")
load("//build_defs/languages:source.bzl", "cargo_source_contract_test", "cargo_source_package")
load("@wasix_adapter_cargo_metadata//:cargo.bzl", "CARGO")
load("@wasix_adapter_crates//:defs.bzl", "all_crate_deps", "crate_deps")
load("@wasix_release_cargo_metadata//:cargo.bzl", RELEASE_CARGO = "CARGO")
load("@wasix_release_crates//:defs.bzl", release_crate_deps = "crate_deps")
load("@oliphaunt_metadata//:metadata.bzl", "CONTRIB_MEMBERS", "PRODUCTS")
load("//build_defs/extensions/wasix:contrib_carriers.bzl", "wasix_contrib_server_crate_deps")

package(default_visibility = ["//visibility:public"])
exports_files(["Cargo.toml"])

PATH_DEPS = {}

cargo_package_env(workspace_manifest = "//src/wasix/node-addon:Cargo.toml")
cargo_library(path_dependencies = PATH_DEPS, cargo_facts = CARGO, crate_dependencies = crate_deps)
# Cargo unifies the SDK's dependency feature from the N-API root across both
# direct and pgwire paths. Keep that one configured SDK instance in this root.
cargo_library(name = "napi_lib", path_dependencies = PATH_DEPS, cargo_facts = CARGO, crate_dependencies = crate_deps)
cargo_library(name = "napi_release_lib", features = ["extensions"], path_dependencies = PATH_DEPS, cargo_facts = RELEASE_CARGO, crate_dependencies = release_crate_deps)
_CONTRIB_FEATURES = ["extension-" + member["sql-name"].replace("_", "-") for member in CONTRIB_MEMBERS]
cargo_library(name = "extension_carrier_lib", features = _CONTRIB_FEATURES, cargo_facts = CARGO, crate_dependencies = wasix_contrib_server_crate_deps)
cargo_integration_test(
    name = "contrib_carrier_server_test",
    source = "tests/extensions.rs",
    crate = ":extension_carrier_lib",
    features = _CONTRIB_FEATURES,
    cargo_facts = CARGO,
    crate_dependencies = wasix_contrib_server_crate_deps,
    rustc_env = {"OLIPHAUNT_DECLARED_CONTRIB_SQL_NAMES": json.encode([member["sql-name"] for member in CONTRIB_MEMBERS]), "OLIPHAUNT_DECLARED_RUNTIME_VERSION": PRODUCTS["liboliphaunt-wasix"]["version"]},
    data = ["//src/test-fixtures:rust_fixtures", "//src/extensions/catalog:extensions.source.json"],
    tags = ["manual"],
)
cargo_integration_test(
    name = "held_contrib_server_test",
    source = "tests/extensions.rs",
    crate = ":napi_release_lib",
    features = _CONTRIB_FEATURES,
    cargo_facts = RELEASE_CARGO,
    crate_dependencies = release_crate_deps,
    args = ["--ignored", "--exact", "public_extensions_pass_server_smoke", "--nocapture", "--test-threads=1"],
    rustc_env = {"OLIPHAUNT_DECLARED_CONTRIB_SQL_NAMES": json.encode([member["sql-name"] for member in CONTRIB_MEMBERS])},
    data = ["//src/test-fixtures:rust_fixtures", "//src/extensions/catalog:extensions.source.json"],
    size = "large",
    timeout = "long",
    tags = ["manual", "installed-consumer"],
)
cargo_library_test(data = ["//src/test-fixtures:rust_fixtures"], cargo_facts = CARGO, all_dependencies = all_crate_deps)
cargo_binary(name = "server", source = "src/main.rs", path_dependencies = PATH_DEPS, library = ":lib", cargo_facts = CARGO, crate_dependencies = crate_deps)
cargo_library_test(name = "binary_test", crate = ":server", cargo_facts = CARGO, all_dependencies = all_crate_deps, tags = ["manual"])
_INTEGRATION_ROOTS = glob(["tests/*.rs"])
[
    cargo_integration_test(
        name = source.removeprefix("tests/").removesuffix(".rs") + "_test",
        source = source,
        srcs = glob(["tests/support/**/*.rs"]),
        args = ["--include-ignored", "--test-threads=1"],
        size = "large",
        timeout = "long",
        rustc_env = {"CARGO_BIN_EXE_oliphaunt-pgwire-server": "$(rootpath :server)"},
        data = [":server", "//src/test-fixtures:rust_fixtures"],
        cargo_facts = CARGO,
        crate_dependencies = crate_deps,
        tags = ["manual"],
    )
    for source in _INTEGRATION_ROOTS
]
rust_clippy_test(
    name = "clippy_test",
    targets = [":lib", ":unit_test", ":server", ":binary_test"] + [":" + source.removeprefix("tests/").removesuffix(".rs") + "_test" for source in _INTEGRATION_ROOTS],
    transitive = False,
    size = "small",
)
cargo_source_package(
    product = "oliphaunt-pgwire-server",
    cargo_facts = CARGO,
    workspace_manifest = "//src/wasix/node-addon:Cargo.toml",
    qualification = [":source_package_test", "//build_defs/languages/installed:pgwire_source_compile_test", ":unit_test", ":binary_test", ":held_contrib_server_test"] +
                    [":" + source.removeprefix("tests/").removesuffix(".rs") + "_test" for source in _INTEGRATION_ROOTS if source != "tests/extensions.rs"],
)
cargo_source_contract_test(
    name = "source_package_test",
    packages = [":crate"],
    target_compatible_with = ["@platforms//os:linux", "@platforms//cpu:x86_64"],
    size = "small",
)

rust_quality_files()
