load("//build_defs/languages:rust.bzl", "cargo_binary", "cargo_library", "cargo_library_test", "cargo_package_env")
load("//build_defs/languages:source.bzl", "cargo_source_package")

package(default_visibility = ["//visibility:public"])
exports_files(["Cargo.toml"])

PATH_DEPS = {
    "oliphaunt-query": "//src/query/rust:oliphaunt_query",
    "oliphaunt-wasix": "//src/wasix/sdks/rust:lib",
}

cargo_package_env()
cargo_library(path_dependencies = PATH_DEPS)
# Cargo unifies the SDK's dependency feature from the N-API root across both
# direct and pgwire paths. Keep that one configured SDK instance in this root.
cargo_library(name = "napi_lib", path_dependencies = PATH_DEPS | {"oliphaunt-wasix": "//src/wasix/sdks/rust:napi_lib"})
cargo_library_test(data = ["//src/test-fixtures:rust_fixtures"])
cargo_binary(name = "server", source = "src/main.rs", path_dependencies = PATH_DEPS, library = ":lib")
cargo_source_package(product = "oliphaunt-pgwire-server")
