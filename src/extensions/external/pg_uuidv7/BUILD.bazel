load("//build_defs/extensions:external.bzl", "native_external_extension_modules")
load("//build_defs/extensions:extensions.bzl", "NATIVE_EXTENSION_CONFIGURATION", "extension_identity", "extension_member_payload", "extension_member_validation_test")
load("//build_defs/release:shipping.bzl", "shipping_package")

package(default_visibility = ["//visibility:public"])

exports_files(["upstream-license-data.json"])

native_external_extension_modules(name = "pg_uuidv7")


extension_member_payload(
    name = "native_payload",
    sql_name = "pg_uuidv7",
    owner = extension_identity("pg_uuidv7"),
    resources = ["@pg_uuidv7//:sql_resources"],
    server_module = ":pg_uuidv7_server.so",
    embedded_module = ":pg_uuidv7_embedded.so",
)

shipping_package(name = "native_member", owner = extension_identity("pg_uuidv7"), artifacts = [":native_payload"], ecosystem = "internal", package_name = "pg_uuidv7", configuration = NATIVE_EXTENSION_CONFIGURATION, role = "extension-member")
extension_member_validation_test(name = "native_payload_test", payload = ":native_payload", sql_name = "pg_uuidv7")
