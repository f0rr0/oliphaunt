+#[cfg(unix)]
+fn apply_sync_open_options(
+    options: &mut fs::OpenOptions,
+    sync: bool,
+    data_sync: bool,
+) -> (bool, bool) {
+    use std::os::unix::fs::OpenOptionsExt;
+
+    let mut flags = 0;
+    if sync {
+        flags |= libc::O_SYNC;
+    } else if data_sync {
+        flags |= libc::O_DSYNC;
+    }
+    if flags != 0 {
+        options.custom_flags(flags);
+    }
+    (sync, !sync && data_sync)
+}
