+                        executable_prefix_len,
+                        region::Protection::READ_EXECUTE,
+                    )
+                }
+                .map_err(|error| format!("make anonymous code memory executable: {error}"))
+            }
+            #[cfg(all(target_os = "linux", target_arch = "x86_64"))]
+            Self::StrictLinuxX86_64FileBacked(mapping) => mapping.publish(executable_prefix_len),
+        }
+    }
+}
