+fn mapped_artifact(bytes: &[u8]) -> Result<OwnedBuffer, String> {
+    let mut artifact_file = tempfile::tempfile().map_err(|error| error.to_string())?;
+    artifact_file
+        .write_all(bytes)
+        .map_err(|error| error.to_string())?;
+    artifact_file.rewind().map_err(|error| error.to_string())?;
+    OwnedBuffer::from_file(&artifact_file).map_err(|error| error.to_string())
+}
