+#[cfg(all(target_os = "linux", target_arch = "x86_64"))]
+impl Drop for StrictLinuxX86_64CodeMapping {
+    fn drop(&mut self) {
+        if self.len != 0 {
+            unsafe {
+                libc::munmap(self.ptr as *mut libc::c_void, self.len);
+            }
+        }
+    }
+}
