+            CodeMemoryPolicyKind::Anonymous => None,
+            #[cfg(all(target_os = "linux", target_arch = "x86_64"))]
+            CodeMemoryPolicyKind::StrictLinuxX86_64FileBacked(policy) => {
+                Some(policy.directory_device)
+            }
+        }
+    }
+
+    /// Return the inode of the pinned strict-policy directory.
+    pub fn pinned_directory_inode(&self) -> Option<u64> {
+        match &self.kind {
+            CodeMemoryPolicyKind::Anonymous => None,
+            #[cfg(all(target_os = "linux", target_arch = "x86_64"))]
+            CodeMemoryPolicyKind::StrictLinuxX86_64FileBacked(policy) => {
