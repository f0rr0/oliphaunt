+    fn get_named_exports(
+        store: &mut impl AsStoreMut,
+        handle: &mut VMInstance,
+        export_names: &[&str],
+    ) -> Exports {
+        export_names
+            .iter()
+            .filter_map(|name| {
+                let export = handle.lookup(name)?;
+                let extern_ = Extern::from_vm_extern(store, crate::vm::VMExtern::Sys(export));
+                Some(((*name).to_string(), extern_))
+            })
+            .collect::<Exports>()
+    }
