+            .checked_add(page_size - (cursor % page_size))
+            .unwrap_or(end);
+        let next = next_page.min(end);
+        let src_chunk = &src[cursor..next];
+
+        if src_chunk.iter().any(|byte| *byte != 0) {
+            dst[cursor..next].copy_from_slice(src_chunk);
+        }
+        cursor = next;
+    }
