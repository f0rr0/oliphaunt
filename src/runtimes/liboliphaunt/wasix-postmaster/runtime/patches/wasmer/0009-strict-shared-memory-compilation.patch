+
+#[cfg(all(test, feature = "llvm"))]
+mod tests {
+    use super::*;
+    use clap::Parser;
+
+    #[test]
+    fn llvm_cli_routes_use_strict_memory_identity() {
+        let target = Target::default();
+        for arguments in [vec!["wasmer"], vec!["wasmer", "--disable-non-volatile-memops"]] {
+            let options = RuntimeOptions::try_parse_from(arguments).unwrap();
+            let compiler = options.get_sys_compiler_config(&BackendType::LLVM).unwrap();
+            assert!(compiler.compiler().deterministic_id().contains("-nv0-"));
+            let engine = BackendType::LLVM.get_engine(&target, &options).unwrap();
+            assert!(engine.deterministic_id().contains("-nv0-"));
+        }
+    }
+}
