+            let observe_publication = Function::new_typed(store, move || {
+                let expected = expected_for_start.lock().unwrap();
+                let (parent, child, plane) = expected
+                    .as_ref()
+                    .expect("module start ran before the test installed its expectation");
+                let registered = plane
+                    .get_process(child.pid())
+                    .is_some_and(|process| process.same_identity(child));
