+
+        let reused =
+            WasiSharedFutexRegistries::registry_for_file(&registries, mapping.file.clone())
+                .unwrap();
+        assert!(Arc::ptr_eq(&live, &reused));
+        assert_eq!(registries.lock().unwrap().counts(), (1, 0));
+    }
 }
