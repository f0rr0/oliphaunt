+    fn task_wasm_test_env(
+        runtime: &tokio::runtime::Runtime,
+        engine: &Engine,
+        name: &str,
+    ) -> WasiEnv {
+        let mut wasix_runtime =
+            PluggableRuntime::new(Arc::new(TokioTaskManager::new(runtime.handle().clone())));
+        wasix_runtime.set_engine(engine.clone());
