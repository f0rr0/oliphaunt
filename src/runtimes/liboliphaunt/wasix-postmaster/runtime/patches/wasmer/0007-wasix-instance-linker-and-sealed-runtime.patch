+        assert!(result.is_err(), "missing import unexpectedly instantiated");
+        assert!(!run_called.load(Ordering::Acquire));
+        assert!(thread.try_join().is_some(), "thread remained nonterminal");
+        assert_eq!(process.lock().execution_leases, 0);
