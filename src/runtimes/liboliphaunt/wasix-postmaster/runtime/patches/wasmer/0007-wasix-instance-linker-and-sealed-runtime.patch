+    pub first_instance_full_byte_validation: bool,
+}
+
+/// Versioned, portable metadata bound into the sealed carrier manifest.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "kebab-case", deny_unknown_fields)]
+pub struct PreinitializedMemoryImageMetadata {
