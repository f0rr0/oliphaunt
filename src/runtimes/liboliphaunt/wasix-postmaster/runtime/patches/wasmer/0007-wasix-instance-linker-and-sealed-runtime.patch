+fn lookup_exported_global(
+    instance: &Instance,
+    store: &mut impl AsStoreMut,
+    name: &str,
+) -> Result<Global, ExportError> {
+    match instance.lookup_export(store, name) {
+        Some(Extern::Global(global)) => Ok(global),
+        Some(_) => Err(ExportError::IncompatibleType),
+        None => Err(ExportError::Missing(name.to_string())),
+    }
+}
