+
+    fn same_exec_backing(
+        &self,
+        len: u64,
+        file_offset: u64,
+        futexs: &Arc<WasiSharedFutexRegistry>,
+    ) -> bool {
+        self.len == len && self.file_offset == file_offset && Arc::ptr_eq(&self.futexs, futexs)
+    }
+}
