+#[cfg(test)]
+mod required_import_tests {
+    use super::*;
+
+    #[test]
+    fn filtered_namespace_only_materializes_exact_module_imports() {
+        fn retained() {}
+        fn must_not_materialize() -> wasmer::Function {
+            panic!("filtered import expression was evaluated")
+        }
+
+        let required = RequiredImports::from([("wasix_32v1", "retained")]);
+        let mut store = wasmer::Store::default();
+        let exports = namespace_for_required_imports! {
+            Some(&required), "wasix_32v1";
+            "retained" => wasmer::Function::new_typed(&mut store, retained),
+            "wrong-name" => must_not_materialize(),
+        };
+
+        assert_eq!(exports.len(), 1);
+        assert!(exports.get_function("retained").is_ok());
+        assert!(exports.get_function("wrong-name").is_err());
+    }
+
