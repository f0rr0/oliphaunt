+/// API that atomically reserves fresh WebAssembly pages and therefore never
+/// need permission to replace existing private memory.
+#[derive(Debug, Clone, Copy, Eq, PartialEq)]
+pub(crate) enum WasiSharedMemoryMapOrigin {
+    GuestFixed,
+}
+
+#[derive(Debug, Clone, Copy, Eq, PartialEq)]
+pub(crate) enum WasiSharedMemoryRuntimePlacement {
+    Fresh { minimum_start: u64 },
+    Inherited { start: u64 },
+}
