+
+impl WasiSharedMemoryMapping {
+    fn end(&self) -> Result<u64, Errno> {
+        self.start.checked_add(self.len).ok_or(Errno::Overflow)
+    }
+
+    fn same_exec_reservation(&self, candidate: &Self) -> bool {
+        self.start == candidate.start
+            && self.same_exec_backing(candidate.len, candidate.file_offset, &candidate.futexs)
