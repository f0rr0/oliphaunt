+            let compact = hex::decode(concat!(
+                "0061736d0100000002150103656e76007f01066d656d6f7279",
+                "020302808004"
+            ))
+            .unwrap();
+            let expected = RawMemoryContract {
+                initial_pages: 2,
+                maximum_pages: Some(65_536),
+                shared: true,
+                memory64: false,
+                page_size_log2: None,
+            };
+            assert!(imported_memory_maximum_span(&compact, expected).is_err());
+        }
+    }
