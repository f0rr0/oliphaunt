+    fn source_residency(&self) -> FileResidencyAudit {
+        file_residency(self.source_file.as_ref().unwrap_or(&self.file), self.len)
+    }
+
+    fn has_distinct_source(&self) -> bool {
+        self.source_file.is_some()
+    }
