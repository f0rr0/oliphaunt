+    fn source_from_bytes(carrier_root: &Path, name: &str, bytes: &[u8]) -> SealedArtifactSource {
+        let path = carrier_root.join(name);
+        fs::write(&path, bytes).unwrap();
+        SealedArtifactSource {
+            file: open_regular(&path).unwrap(),
