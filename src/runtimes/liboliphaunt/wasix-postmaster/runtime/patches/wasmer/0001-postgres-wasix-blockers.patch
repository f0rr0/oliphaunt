+
+impl PendingArtifact {
+    fn new(engine: &Engine, artifact: Artifact) -> Self {
+        let code_memory_id = artifact.code_memory_id;
+        Self {
+            artifact: Some(artifact),
+            engine: engine.clone(),
+            code_memory_id,
+        }
+    }
+
+    /// Borrow the validated artifact while rollback ownership remains pending.
+    pub fn artifact(&self) -> &Artifact {
+        self.artifact
+            .as_ref()
+            .expect("pending artifact must exist before commit")
+    }
