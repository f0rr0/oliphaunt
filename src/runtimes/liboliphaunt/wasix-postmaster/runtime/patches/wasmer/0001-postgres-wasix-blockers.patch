+                    let range = line.split_whitespace().next().expect("mapping range");
+                    let (start, end) = range.split_once('-').expect("mapping range separator");
+                    let start = usize::from_str_radix(start, 16).expect("mapping start");
+                    let end = usize::from_str_radix(end, 16).expect("mapping end");
+                    start <= address && address < end
