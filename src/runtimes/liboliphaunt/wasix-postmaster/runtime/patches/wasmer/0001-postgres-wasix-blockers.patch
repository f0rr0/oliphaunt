+        let controller = handle.signal_controller();
+        for signal in [
+            Signal::Sigint,
+            Signal::Sigterm,
+            Signal::Sigquit,
+            Signal::Sighup,
+        ] {
+            controller.send_signal(signal).unwrap();
+            assert_eq!(
+                recorded.recv_timeout(Duration::from_secs(1)).unwrap(),
+                signal.to_native() as u8
+            );
+        }
+        status.set_finished(Ok(Errno::Success.into()));
+        assert!(matches!(
+            controller.send_signal(Signal::Sigterm),
+            Err(TaskSignalError::Terminated)
