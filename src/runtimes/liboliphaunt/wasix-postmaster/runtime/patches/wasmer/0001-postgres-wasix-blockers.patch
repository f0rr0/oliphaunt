+fn retire_finished_process_tree(
+    control_plane: &WasiControlPlane,
+    process: &WasiProcess,
+) -> Result<(), ControlPlaneError> {
+    let descendants = process.begin_epoch_retirement()?;
+    for descendant in &descendants {
+        control_plane.retire_process_epoch(descendant)?;
+        descendant.retire_epoch_task_registrations();
+    }
+    control_plane.retire_process_epoch(process)?;
+    process.retire_epoch_task_registrations();
+    for descendant in &descendants {
+        descendant.clear_retired_children();
+    }
+    process.clear_retired_children();
+    Ok(())
