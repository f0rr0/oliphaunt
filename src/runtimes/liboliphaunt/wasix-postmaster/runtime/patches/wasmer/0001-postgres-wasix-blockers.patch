+                let mut non_empty_count = 0usize;
+                let mut repeated_iov = None;
+                let mut all_non_empty_iovs_match = true;
+                for iov in iovs_arr.iter() {
+                    if iov.buf_len == M::ZERO {
+                        continue;
+                    }
+                    non_empty_count += 1;
+                    match repeated_iov {
+                        Some((buf, buf_len)) if buf == iov.buf && buf_len == iov.buf_len => {}
+                        Some(_) => all_non_empty_iovs_match = false,
+                        None => repeated_iov = Some((iov.buf, iov.buf_len)),
