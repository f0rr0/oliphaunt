+        let manager = TokioTaskManager::new_with_config(runtime.handle().clone(), config);
+        let pool = manager.pool_handle();
+        let barrier = Arc::new(Barrier::new(TASKS + 1));
+
+        for _ in 0..TASKS {
+            let barrier = Arc::clone(&barrier);
+            pool.execute(move || {
+                barrier.wait();
+            });
+        }
+
+        barrier.wait();
+        pool.join();
+        assert_eq!(manager.config(), config);
+        assert_eq!(pool.get_current_worker_count(), TASKS);
+
+        let deadline = Instant::now() + Duration::from_secs(2);
+        while pool.get_current_worker_count() != config.core_threads && Instant::now() < deadline {
+            std::thread::sleep(Duration::from_millis(10));
+        }
