+    assert_eq!(read_memory(&memory, &store, 32, 10)?, b"0101234567");
+
+    fill.call(&mut store, 48, 0x7a, 4)?;
+    assert_eq!(read_memory(&memory, &store, 48, 4)?, b"zzzz");
+
+    memory.view(&store).write(PAGE_SIZE - 4, &[1, 2, 3, 4])?;
+    let result = fill
+        .call(&mut store, (PAGE_SIZE - 2) as i32, 0x41, 4)
+        .unwrap_err();
+    assert_eq!(
+        result.to_trap(),
+        Some(wasmer_types::TrapCode::HeapAccessOutOfBounds)
+    );
+    assert_eq!(
+        read_memory(&memory, &store, PAGE_SIZE - 4, 4)?,
+        &[1, 2, 3, 4]
+    );
+
+    memory.view(&store).write(PAGE_SIZE - 4, &[5, 6, 7, 8])?;
+    let result = copy
+        .call(&mut store, (PAGE_SIZE - 2) as i32, 8, 4)
+        .unwrap_err();
+    assert_eq!(
+        result.to_trap(),
+        Some(wasmer_types::TrapCode::HeapAccessOutOfBounds)
+    );
+    assert_eq!(
+        read_memory(&memory, &store, PAGE_SIZE - 4, 4)?,
+        &[5, 6, 7, 8]
+    );
+
+    Ok(())
+}
