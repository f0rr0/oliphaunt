+        carrier_root: &Path,
+        name: &str,
+        bytes: &[u8],
+    ) -> ImmutableArtifactSnapshot {
+        immutable_artifact_snapshot(
+            source_from_bytes(carrier_root, name, bytes),
+            SealedActivationPolicy::Compatibility,
+        )
+        .unwrap()
+    }
