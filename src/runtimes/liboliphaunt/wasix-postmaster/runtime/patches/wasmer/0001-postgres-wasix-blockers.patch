+    thread: WasiThread,
+    lease: Option<WasiProcessExecutionLease>,
+    owner_identity: Arc<()>,
+}
+
+impl TaskWasmAcceptedExecutionGuard {
+    pub(crate) fn thread(&self) -> &WasiThread {
+        &self.thread
+    }
+
+    pub(crate) fn owner_identity(&self) -> &Arc<()> {
+        &self.owner_identity
+    }
+
+    fn admit_successor<T, E>(mut self, admission: impl FnOnce() -> Result<T, E>) -> Result<T, E> {
