+#[cfg(all(feature = "ctrlc", unix))]
+fn deliver_unix_signal_mask(
+    mask: u32,
+    controller: &TaskSignalController,
+) -> Result<(), (Signal, TaskSignalError)> {
+    for (_, bit, signal, _) in UNIX_HOST_SIGNALS {
+        if mask & bit != 0 {
+            controller
+                .send_signal(signal)
+                .map_err(|source| (signal, source))?;
+        }
+    }
+    Ok(())
+}
