+        use wasmer::sys::{BaseTunables, NativeEngineExt};
+        use wasmer::{Module, Pages};
+
+        let mut engine = wasmer::Engine::default();
+        engine.set_tunables(BaseTunables {
+            static_memory_bound: Pages(0),
+            static_memory_offset_guard_size: 0,
+            dynamic_memory_offset_guard_size: 0,
+        });
+        let mut store = wasmer::Store::new(engine.clone());
+        let module = Module::new(
