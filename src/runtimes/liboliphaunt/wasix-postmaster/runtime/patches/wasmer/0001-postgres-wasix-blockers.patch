+    fn detached_artifact_with_one_frame(code: *const VMFunctionBody) -> Artifact {
+        let mut frame = CompiledFunctionFrameInfo::default();
+        frame.traps.push(TrapInformation {
+            code_offset: 0,
+            trap_code: TrapCode::UnreachableCodeReached,
