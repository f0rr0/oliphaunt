+fn copy_sparse_range(src: &[u8], dst: &mut [u8], start: usize, end: usize) {
+    let page_size = region::page::size();
+    let mut cursor = start;
+
+    while cursor < end {
+        let next_page = cursor
+            .checked_add(page_size - (cursor % page_size))
+            .unwrap_or(end);
+        let next = next_page.min(end);
+        let src_chunk = &src[cursor..next];
+
+        if src_chunk.iter().any(|byte| *byte != 0) {
+            dst[cursor..next].copy_from_slice(src_chunk);
+        }
+        cursor = next;
+    }
