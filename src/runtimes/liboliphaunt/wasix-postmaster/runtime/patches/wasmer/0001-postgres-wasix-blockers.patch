+#[cfg(all(feature = "ctrlc", unix))]
+fn unix_host_signal_bit(signal: libc::c_int) -> Option<u32> {
+    UNIX_HOST_SIGNALS
+        .iter()
+        .find_map(|(candidate, bit, _, _)| (*candidate == signal).then_some(*bit))
+}
