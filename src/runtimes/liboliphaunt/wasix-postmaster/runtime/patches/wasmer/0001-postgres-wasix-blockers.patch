+            // ENDBR64; mov eax, 42; ret. ENDBR64 keeps this indirect call valid
+            // on hosts enforcing Intel CET while remaining a NOP elsewhere.
+            let function = [0xf3, 0x0f, 0x1e, 0xfa, 0xb8, 42, 0, 0, 0, 0xc3];
+            mapping.as_mut_slice()[..function.len()].copy_from_slice(&function);
+            let data = b"relocated-code-memory-byte-stability";
+            mapping.as_mut_slice()[page_size..page_size + data.len()].copy_from_slice(data);
