+    /// Completes the child launch transaction after a task/command has been
+    /// accepted. Exit notification is deliberately delayed until this point,
+    /// so a launch rollback cannot emit a spurious SIGCHLD.
+    pub(crate) fn complete_child_launch(
+        &mut self,
+        tasks: &Arc<dyn crate::runtime::VirtualTaskManager>,
+    ) {
