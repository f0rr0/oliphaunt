+/// on backends that do not expose exact raw WebAssembly values.
+#[derive(Clone, Debug)]
+enum StoreSnapshotRepr {
+    DenseV1(DenseStoreSnapshotV1),
+    SparseV2(SparseStoreSnapshotV2),
