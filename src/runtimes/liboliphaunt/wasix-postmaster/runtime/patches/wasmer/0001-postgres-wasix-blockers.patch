+
+        let wrap = SerializedLinearMemoryPlan {
+            maximum_pages: Some(65_536),
+            style: SerializedLinearMemoryStyle::Static {
+                bound_pages: 65_536,
+                offset_guard_bytes: 2_147_483_648,
+            },
+            ..valid
+        };
+        assert!(validate_serialized_memory_plans(&[wrap]).is_err());
+    }
+}
