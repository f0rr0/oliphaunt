+#[derive(Debug)]
+pub struct InterestHandlerRegistration {
+    inner: Weak<InterestHandlerFanoutInner>,
+    id: u64,
+}
+
+impl Drop for InterestHandlerRegistration {
+    fn drop(&mut self) {
+        let Some(inner) = self.inner.upgrade() else {
+            return;
+        };
+        let removed = inner.handlers.lock().unwrap().remove(&self.id);
+        drop(removed);
+    }
+}
