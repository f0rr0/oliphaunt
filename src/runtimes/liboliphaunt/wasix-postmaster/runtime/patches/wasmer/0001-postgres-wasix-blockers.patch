+#[derive(Debug)]
+pub(crate) struct WasiProcessRegistrationGuard {
+    control_plane: WasiControlPlane,
+    process: WasiProcess,
+    parent: Option<WasiProcess>,
+    parent_publication: Option<WasiChildPublicationGuard>,
+    committed: bool,
+    launch_complete: bool,
