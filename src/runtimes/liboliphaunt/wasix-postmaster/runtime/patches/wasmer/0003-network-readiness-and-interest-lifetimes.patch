+    #[derive(Debug)]
+    struct ReentrantDropHandler {
+        fanout: InterestHandlerFanout,
+        dropped: mpsc::Sender<()>,
+    }
+
+    impl InterestHandler for ReentrantDropHandler {
+        fn push_interest(&mut self, _interest: InterestType) {}
+
+        fn pop_interest(&mut self, _interest: InterestType) -> bool {
+            false
+        }
+
+        fn has_interest(&self, _interest: InterestType) -> bool {
+            false
+        }
+    }
+
+    impl Drop for ReentrantDropHandler {
+        fn drop(&mut self) {
+            let transient = self
+                .fanout
+                .register(Box::new(CountingHandler(Arc::new(AtomicUsize::new(0)))));
+            drop(transient);
+            self.dropped.send(()).unwrap();
+        }
+    }
+
+    #[test]
+    fn registration_drop_releases_map_lock_before_handler_drop() {
+        let fanout = InterestHandlerFanout::default();
+        let (dropped_tx, dropped_rx) = mpsc::channel();
+        let registration = fanout.register(Box::new(ReentrantDropHandler {
+            fanout: fanout.clone(),
+            dropped: dropped_tx,
+        }));
+
+        std::thread::spawn(move || drop(registration));
+        dropped_rx
+            .recv_timeout(Duration::from_secs(1))
+            .expect("handler drop should re-enter the fanout without deadlocking");
+        assert_eq!(fanout.handler_count(), 0);
+    }
+}
