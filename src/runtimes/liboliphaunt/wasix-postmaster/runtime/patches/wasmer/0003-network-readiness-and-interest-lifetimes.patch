+
+    #[test]
+    fn fanout_removes_only_the_dropped_registration() {
+        let mut fanout = InterestHandlerFanout::default();
+        let first = Arc::new(AtomicUsize::new(0));
+        let second = Arc::new(AtomicUsize::new(0));
+        let first_registration = fanout.register(Box::new(CountingHandler(first.clone())));
+        let _second_registration = fanout.register(Box::new(CountingHandler(second.clone())));
+
+        fanout.push_interest(InterestType::Readable);
+        assert_eq!(first.load(Ordering::SeqCst), 1);
+        assert_eq!(second.load(Ordering::SeqCst), 1);
+
+        drop(first_registration);
+        fanout.push_interest(InterestType::Readable);
+        assert_eq!(first.load(Ordering::SeqCst), 1);
+        assert_eq!(second.load(Ordering::SeqCst), 2);
+        assert_eq!(fanout.handler_count(), 1);
+    }
+
+    #[test]
+    fn singleton_fanout_uses_allocation_free_snapshot_shape() {
+        let fanout = InterestHandlerFanout::default();
+        let _registration =
+            fanout.register(Box::new(CountingHandler(Arc::new(AtomicUsize::new(0)))));
+        assert!(matches!(fanout.snapshot(), InterestHandlerSnapshot::One(_)));
+    }
