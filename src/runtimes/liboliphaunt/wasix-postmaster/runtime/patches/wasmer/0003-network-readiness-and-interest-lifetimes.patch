+            SocketAddr::from((Ipv4Addr::LOCALHOST, 0)),
+            false,
+            false,
+            false,
+        )
+        .await
+        .unwrap();
+    let addr = listener.addr_local().unwrap();
+
+    let (sender, receiver) = mpsc::channel();
+    listener
+        .set_handler(Box::new(ReadableHandler { sender }))
+        .unwrap();
+
+    let clients: Vec<_> = (0..20).map(|_| TcpStream::connect(addr).unwrap()).collect();
+    receiver
+        .recv_timeout(Duration::from_secs(1))
+        .expect("listener should report first readable accept");
+
+    let mut accepted = Vec::new();
+    for idx in 0..clients.len() {
+        accepted.push(listener.try_accept().unwrap());
+        if idx + 1 < clients.len() {
+            receiver
+                .recv_timeout(Duration::from_secs(1))
+                .expect("listener should keep reporting readable across a queued burst");
+        }
+    }
+    drop(accepted);
+    drop(clients);
+}
