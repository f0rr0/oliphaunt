+    pub(crate) fn acquire_descriptor(&self) {
+        self.inner.ofd.acquire_descriptor();
+        self.inode.acquire_handle();
+    }
+
+    pub(crate) fn release_descriptor(&self) {
+        let last_description_handle = self.inner.ofd.release_descriptor();
+        if last_description_handle && let Kind::Epoll { state } = &*self.inode.read() {
+            state.close();
+        }
+        self.inode.drop_one_handle();
+    }
