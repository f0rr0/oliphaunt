+fn blocking_sync_available(handle: &(dyn VirtualFile + Send + Sync), fd_flags: Fdflags) -> bool {
+    if fd_flags.contains(Fdflags::SYNC) {
+        handle.is_sync_on_write(true) || handle.has_blocking_sync_all_to_disk()
+    } else if fd_flags.contains(Fdflags::DSYNC) {
+        handle.is_sync_on_write(false) || handle.has_blocking_sync_data_to_disk()
+    } else {
+        true
+    }
