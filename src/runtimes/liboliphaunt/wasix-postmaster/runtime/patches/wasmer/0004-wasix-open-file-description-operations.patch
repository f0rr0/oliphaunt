+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn read_only_open_never_inherits_parent_write_access() {
+        let parent = Rights::FD_READ | Rights::FD_WRITE | Rights::FD_SEEK;
+        let adjusted = constrain_requested_rights(Rights::FD_READ | Rights::FD_SEEK, parent);
+
+        assert!(adjusted.contains(Rights::FD_READ));
+        assert!(adjusted.contains(Rights::FD_SEEK));
+        assert!(!adjusted.contains(Rights::FD_WRITE));
+    }
+
+    #[test]
+    fn parent_capabilities_remain_an_upper_bound() {
+        let requested = Rights::FD_READ | Rights::FD_WRITE;
+        let adjusted = constrain_requested_rights(requested, Rights::FD_READ);
+
+        assert_eq!(adjusted, Rights::FD_READ);
+    }
+
+    #[test]
+    fn descriptor_inheriting_rights_are_capped_independently() {
+        let parent = Rights::FD_READ | Rights::FD_SEEK;
+        let adjusted = constrain_requested_rights(
+            Rights::FD_READ | Rights::FD_WRITE | Rights::FD_SEEK,
+            parent,
+        );
+
+        assert_eq!(adjusted, parent);
+    }
