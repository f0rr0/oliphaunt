+#[cfg(all(feature = "ctrlc", windows))]
+fn windows_host_signal_bit(control: u32) -> Option<u32> {
+    match control {
+        CTRL_C_EVENT => Some(1 << 0),
+        CTRL_CLOSE_EVENT | CTRL_SHUTDOWN_EVENT => Some(1 << 1),
+        CTRL_BREAK_EVENT => Some(1 << 2),
+        CTRL_LOGOFF_EVENT => Some(1 << 3),
+        _ => None,
+    }
+}
