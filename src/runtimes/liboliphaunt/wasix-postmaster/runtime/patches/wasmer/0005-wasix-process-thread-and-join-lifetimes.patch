+    /// Retains execution ownership until the command's authoritative task
+    /// status becomes terminal. The task-manager acceptance boundary is the
+    /// handoff: rejection, panic, or cancellation transfers the command and
+    /// its execution guard to an independent reaper.
+    pub(crate) fn monitor(
+        self,
+        handle: TaskJoinHandle,
+        tasks: &Arc<dyn VirtualTaskManager>,
+    ) -> Result<(), WasiThreadError> {
+        let watcher = ProcessMonitorLifecycleGuard::new(handle, self);
+        let admission = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+            tasks.task_shared(Box::new(move || {
+                Box::pin(async move { watcher.wait_finished().await })
+            }))
+        }));
+        match admission {
+            Ok(result) => result,
+            Err(_) => {
+                tracing::error!("task manager panicked while admitting a process monitor");
+                Err(WasiThreadError::InvalidWasmContext)
+            }
+        }
+    }
+}
