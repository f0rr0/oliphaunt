+    }
+
+    fn status_and_signals() -> (OwnedTaskStatus, mpsc::Receiver<u8>, TaskJoinHandle) {
+        let (sender, receiver) = mpsc::channel();
+        let mut status = OwnedTaskStatus::default();
+        status.set_signal_handler(Arc::new(RecordingSignalHandler { sender }));
+        let handle = status.handle();
+        (status, receiver, handle)
