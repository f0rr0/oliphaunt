+    use std::{sync::mpsc, time::Duration};
+
+    #[derive(Debug)]
+    struct RecordingSignalHandler {
+        sender: mpsc::Sender<u8>,
+    }
+
+    impl SignalHandlerAbi for RecordingSignalHandler {
+        fn signal(&self, signal: u8) -> Result<(), SignalDeliveryError> {
+            self.sender.send(signal).map_err(|_| SignalDeliveryError)
