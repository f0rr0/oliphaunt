+#[cfg(all(feature = "ctrlc", windows))]
+fn route_windows_signal_mask(mask: u32, route: &Arc<Mutex<WindowsHostSignalRoute>>) {
+    if mask == 0 {
+        return;
+    }
+    let target = {
+        let mut route = lock_windows_signal_route(route);
+        match &route.target {
+            Some(target) => Some(target.clone()),
+            None => {
+                route.buffered |= mask;
+                None
+            }
+        }
+    };
+    if let Some(target) = target
+        && let Err((signal, error)) = deliver_windows_signal_mask(mask, &target)
+    {
+        tracing::warn!(?signal, %error, "failed to forward Windows host lifecycle event");
+    }
+}
