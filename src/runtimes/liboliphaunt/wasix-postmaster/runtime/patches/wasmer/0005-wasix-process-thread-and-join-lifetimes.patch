+#[cfg(all(feature = "ctrlc", windows))]
+fn deliver_windows_signal_mask(
+    mask: u32,
+    controller: &TaskSignalController,
+) -> Result<(), (Signal, TaskSignalError)> {
+    for (bit, signal) in WINDOWS_GUEST_SIGNALS {
+        if mask & bit != 0 {
+            controller
+                .send_signal(signal)
+                .map_err(|source| (signal, source))?;
+        }
+    }
+    Ok(())
+}
