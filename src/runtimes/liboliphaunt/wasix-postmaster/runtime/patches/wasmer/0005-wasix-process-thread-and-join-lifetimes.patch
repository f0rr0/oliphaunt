+    use super::*;
+
+    #[test]
+    fn sealed_aliases_are_exact_and_close_the_executable_namespace() {
+        let module_hash = ModuleHash::from_bytes([0x5a; 32]);
+        let sealed_modules = HashMap::from([(
+            "/bin/postgres".to_string(),
+            SealedExecutable {
+                module_hash,
