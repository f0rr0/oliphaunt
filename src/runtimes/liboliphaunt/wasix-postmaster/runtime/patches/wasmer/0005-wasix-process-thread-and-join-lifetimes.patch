+#[cfg(all(feature = "ctrlc", windows))]
+unsafe extern "system" fn windows_host_lifecycle_handler(control: u32) -> BOOL {
+    WINDOWS_HOST_SIGNAL_HANDLERS_IN_FLIGHT.fetch_add(1, Ordering::SeqCst);
+    let handled = if let Some(bit) = windows_host_signal_bit(control) {
+        let event = WINDOWS_HOST_SIGNAL_EVENT.load(Ordering::SeqCst);
+        if event.is_null() {
+            false
+        } else {
+            WINDOWS_HOST_SIGNAL_PENDING.fetch_or(bit, Ordering::Release);
+            // Only claim the console event when its forwarder was actually
+            // woken. The pending bit intentionally remains set on failure so
+            // a later successful wake can still drain it.
+            (unsafe { SetEvent(event) }) != 0
+        }
+    } else {
+        false
+    };
+    WINDOWS_HOST_SIGNAL_HANDLERS_IN_FLIGHT.fetch_sub(1, Ordering::SeqCst);
+    if handled { 1 } else { 0 }
+}
