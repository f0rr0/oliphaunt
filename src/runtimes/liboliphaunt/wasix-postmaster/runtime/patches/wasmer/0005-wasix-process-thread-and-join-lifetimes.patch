+            // A concurrent POSIX waiter may already have consumed the failed
+            // child's status and removed this exact link.
+            parent.remove_child_if_same(&self.process);
+        }
+        // Likewise, reap is idempotent with a concurrent exact-identity wait.
+        // PIDs are monotonic, so an absent entry cannot name a replacement.
+        self.control_plane.reap_process(&self.process);
+        self.committed = false;
+        self.launch_complete = true;
+    }
+}
