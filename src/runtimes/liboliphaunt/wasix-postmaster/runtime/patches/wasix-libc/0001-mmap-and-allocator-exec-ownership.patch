+static int legacy_msync(struct map *map, void *addr, size_t length) {
+    uintptr_t delta = (uintptr_t) addr - (uintptr_t) map->addr;
+    off_t map_offset;
+
+    if (__builtin_add_overflow(map->offset, (off_t) delta, &map_offset)) {
+        errno = EOVERFLOW;
+        return -1;
+    }
+
+    if ((map->flags & MAP_SHARED) != 0 &&
+        (map->flags & MAP_ANON) == 0 &&
+        (map->prot & PROT_WRITE) != 0) {
+        char *body = (char *) addr;
+
+        while (length > 0) {
+            const ssize_t nwrite = pwrite(map->fd, body, length, map_offset);
+
+            if (nwrite > 0) {
+                length -= (size_t) nwrite;
+                map_offset += (size_t) nwrite;
+                body += (size_t) nwrite;
+            } else if (errno == EINTR) {
+                continue;
+            } else {
+                return -1;
+            }
+        }
+    }
+
+    return 0;
+}
