 		path, combined_argv, combined_env,
 		use_path ? __WASI_BOOL_TRUE : __WASI_BOOL_FALSE, getenv("PATH"));
+	/* proc_exec3 has consumed both buffers before returning. On vfork success
+	   this is the last point before longjmp restores the shared parent image. */
+	free(combined_argv);
+	free(combined_env);
 #ifdef __wasm_exception_handling__
 	extern _Noreturn void __vfork_restore();
 	if (e == 0) {
@@ -99,9 +127,6 @@ int __execvpe(const char *path, char *const argv[], char *const envp[], uint8_t
 	}
 #endif
 
-	free(combined_argv);
-	free(combined_env);
-
 	// A return from proc_exec automatically means it failed
 	errno = e;
 	return -1;
