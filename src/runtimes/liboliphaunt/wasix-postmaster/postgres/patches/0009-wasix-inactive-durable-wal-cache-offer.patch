diff --git a/src/backend/replication/walreceiver.c b/src/backend/replication/walreceiver.c
index 8c4d0fd..7c2020b 100644
--- a/src/backend/replication/walreceiver.c
+++ b/src/backend/replication/walreceiver.c
@@ -102,6 +102,67 @@ static int	recvFile = -1;
 static TimeLineID recvFileTLI = 0;
 static XLogSegNo recvSegNo = 0;
 
+#ifdef __wasi__
+/*
+ * A walreceiver may reopen a recycled inode that still has a deferred class-6
+ * offer.  Bind a once-only revoke to the exact local open generation and
+ * linearize it before the first received WAL write.
+ */
+typedef struct WalRcvCacheRevokeState
+{
+	int			fd;
+	XLogSegNo	segno;
+	TimeLineID	tli;
+	bool		pending;
+} WalRcvCacheRevokeState;
+
+static WalRcvCacheRevokeState recvFileCacheRevoke =
+{
+	.fd = -1,
+	.segno = 0,
+	.tli = 0,
+	.pending = false,
+};
+
+static inline void
+XLogWalRcvCacheRevokeReset(void)
+{
+	recvFileCacheRevoke.fd = -1;
+	recvFileCacheRevoke.segno = 0;
+	recvFileCacheRevoke.tli = 0;
+	recvFileCacheRevoke.pending = false;
+}
+
+static inline void
+XLogWalRcvCacheRevokeOpened(int fd, XLogSegNo segno, TimeLineID tli)
+{
+	Assert(fd >= 0);
+	Assert(tli != 0);
+
+	recvFileCacheRevoke.fd = fd;
+	recvFileCacheRevoke.segno = segno;
+	recvFileCacheRevoke.tli = tli;
+	recvFileCacheRevoke.pending = true;
+}
+
+static inline void
+XLogWalRcvCacheRevokeBeforeFirstWrite(int fd, XLogSegNo segno,
+									 TimeLineID tli)
+{
+	Assert(recvFileCacheRevoke.fd == fd);
+	Assert(recvFileCacheRevoke.segno == segno);
+	Assert(recvFileCacheRevoke.tli == tli);
+
+	if (recvFileCacheRevoke.pending)
+	{
+		recvFileCacheRevoke.pending = false;
+		(void) pg_wasix_fd_cache_revoke_v1(
+			fd, PG_WASIX_CACHE_CLASS_WAL_INACTIVE_DURABLE,
+			PG_WASIX_CACHE_OFFER_V1_FLAGS_NONE);
+	}
+}
+#endif
