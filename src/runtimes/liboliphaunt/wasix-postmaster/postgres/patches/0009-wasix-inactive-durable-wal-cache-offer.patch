+/*
+ * Cache offers for WAL must stay attached to the exact descriptor and WAL
+ * identity that proved them.  File-descriptor numbers can be reused, so a
+ * bare "last segment was durable" boolean is not a sufficient contract.
+ */
+typedef struct XLogFileCacheOfferState
+{
+	int			fd;
+	XLogSegNo	segno;
+	TimeLineID	tli;
+	bool		sync_open_writes;
+	bool		revoke_before_first_write;
+	bool		complete_and_durable;
+} XLogFileCacheOfferState;
+
+static XLogFileCacheOfferState openLogFileCacheOffer =
+{
+	.fd = -1,
+	.segno = 0,
+	.tli = 0,
+	.sync_open_writes = false,
+	.revoke_before_first_write = false,
+	.complete_and_durable = false,
+};
+
+static inline void
+XLogFileCacheOfferReset(void)
+{
+	openLogFileCacheOffer.fd = -1;
+	openLogFileCacheOffer.segno = 0;
+	openLogFileCacheOffer.tli = 0;
+	openLogFileCacheOffer.sync_open_writes = false;
+	openLogFileCacheOffer.revoke_before_first_write = false;
+	openLogFileCacheOffer.complete_and_durable = false;
+}
+
+static inline void
+XLogFileCacheOfferOpened(int fd, XLogSegNo segno, TimeLineID tli)
+{
+	Assert(fd >= 0);
+	Assert(tli != 0);
+
+	openLogFileCacheOffer.fd = fd;
+	openLogFileCacheOffer.segno = segno;
+	openLogFileCacheOffer.tli = tli;
+	openLogFileCacheOffer.sync_open_writes =
+		enableFsync &&
+		(wal_sync_method == WAL_SYNC_METHOD_OPEN ||
+		 wal_sync_method == WAL_SYNC_METHOD_OPEN_DSYNC);
+	openLogFileCacheOffer.revoke_before_first_write = true;
+	openLogFileCacheOffer.complete_and_durable = false;
+}
+
+static inline void
+XLogFileCacheOfferWriteStarted(int fd, XLogSegNo segno, TimeLineID tli)
+{
+	Assert(openLogFileCacheOffer.fd == fd);
+	Assert(openLogFileCacheOffer.segno == segno);
+	Assert(openLogFileCacheOffer.tli == tli);
+
+	/*
+	 * A recycled inode can retain a descriptor-pinned deferred offer from its
+	 * prior contents.  Revoke that identity synchronously once for this open
+	 * generation, before its first WAL payload write can change the file.
+	 */
+	if (openLogFileCacheOffer.revoke_before_first_write)
+	{
+		openLogFileCacheOffer.revoke_before_first_write = false;
+		(void) pg_wasix_fd_cache_revoke_v1(
+			fd, PG_WASIX_CACHE_CLASS_WAL_INACTIVE_DURABLE,
+			PG_WASIX_CACHE_OFFER_V1_FLAGS_NONE);
+	}
+
+	/* Any subsequent write invalidates an earlier completion proof. */
+	openLogFileCacheOffer.complete_and_durable = false;
+}
+
+static inline void
+XLogFileCacheOfferCompleted(int fd, XLogSegNo segno, TimeLineID tli)
+{
+	bool		durability_proved;
+
+	/*
+	 * issue_xlog_fsync() is a successful durability proof only when fsync is
+	 * enabled.  For open_sync/open_datasync it returns without another syscall
+	 * because the successful final-page write itself supplied that proof.  The
+	 * descriptor must also have been opened while those semantics were enabled;
+	 * fsync can be reloaded without reopening an existing descriptor.
+	 */
+	durability_proved = enableFsync;
+	if (wal_sync_method == WAL_SYNC_METHOD_OPEN ||
+		wal_sync_method == WAL_SYNC_METHOD_OPEN_DSYNC)
+		durability_proved = durability_proved &&
+			openLogFileCacheOffer.sync_open_writes;
+
+	openLogFileCacheOffer.complete_and_durable =
+		durability_proved &&
+		openLogFileCacheOffer.fd == fd &&
+		openLogFileCacheOffer.segno == segno &&
+		openLogFileCacheOffer.tli == tli;
+}
+
+static inline bool
+XLogFileCacheOfferTake(int fd, XLogSegNo segno, TimeLineID tli)
+{
+	bool		eligible;
+
+	eligible = openLogFileCacheOffer.complete_and_durable &&
+		openLogFileCacheOffer.fd == fd &&
+		openLogFileCacheOffer.segno == segno &&
+		openLogFileCacheOffer.tli == tli;
+	XLogFileCacheOfferReset();
+
+	return eligible;
+}
+#endif
