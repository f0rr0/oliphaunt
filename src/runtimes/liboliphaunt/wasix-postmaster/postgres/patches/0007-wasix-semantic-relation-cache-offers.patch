  * Return fd for the specified block number and update *off to the appropriate
  * position.
diff --git a/src/include/port.h b/src/include/port.h
index 0048ea3..9966e25 100644
--- a/src/include/port.h
+++ b/src/include/port.h
@@ -542,6 +542,46 @@ extern bool wait_result_is_signal(int exit_status, int signum);
 extern bool wait_result_is_any_signal(int exit_status, bool include_command_not_found);
 extern int	wait_result_to_exit_code(int exit_status);
 
+#ifdef __wasi__
+#include <wasix/cache_offer.h>
+
+/*
+ * Product-owned, hint-only cache-offer ABI.
+ *
+ * The PostgreSQL port deliberately keeps this wrapper inert until the
+ * matching versioned import is provided by the selected WASIX libc and the
+ * carrier has negotiated it with the host.  Hints must never change the
+ * success, failure, or errno of the PostgreSQL operation that produced them.
+ */
+static inline int
+pg_wasix_cache_offer(int fd, off_t offset, off_t length,
+					 uint32_t offer_class, uint32_t flags)
+{
+	int			save_errno = errno;
+	int			result;
+
+	if (offset < 0 || length < 0 ||
+		(length > 0 && offset > INT64_MAX - length))
+		result = EINVAL;
+#ifdef PG_WASIX_HAVE_FD_CACHE_OFFER_V1
+	else
+		result = pg_wasix_fd_cache_offer_v1(fd, (int64_t) offset,
+										(int64_t) length, offer_class, flags);
+#else
+	else
+	{
+		(void) fd;
+		(void) offer_class;
+		(void) flags;
+		result = ENOSYS;
+	}
+#endif
+
+	errno = save_errno;
+	return result;
+}
+#endif
