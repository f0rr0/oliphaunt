diff --git a/src/backend/storage/smgr/md.c b/src/backend/storage/smgr/md.c
index db4595d..cf10ad1 100644
--- a/src/backend/storage/smgr/md.c
+++ b/src/backend/storage/smgr/md.c
@@ -1469,6 +1469,12 @@ mdimmedsync(SMgrRelation reln, ForkNumber forknum)
 					 errmsg("could not fsync file \"%s\": %m",
 							FilePathName(v->mdfd_vfd))));
 
+#ifdef __wasi__
+		/* length zero is the versioned ABI's exact through-EOF range. */
+		(void) FileCacheOffer(v->mdfd_vfd, 0, 0,
+							  SMGR_CACHE_OFFER_RELATION_SYNC_IMMEDIATE);
+#endif
+
 		/* Close inactive segments immediately */
 		if (segno > min_inactive_seg)
 		{
@@ -1495,6 +1501,42 @@ mdfd(SMgrRelation reln, ForkNumber forknum, BlockNumber blocknum, uint32 *off)
 	return FileGetRawDesc(v->mdfd_vfd);
 }
 
+#ifdef __wasi__
+/*
+ * Split an offer at relation segment boundaries and use only MdfdVec entries
+ * that are already present.  Neither a missing segment nor a VFD whose raw
+ * descriptor was reclaimed is worth reopening for a lossy cache hint.
+ */
+void
+mdcacheoffer(SMgrRelation reln, ForkNumber forknum, BlockNumber blocknum,
+			 BlockNumber nblocks, SMgrCacheOfferClass offer_class)
+{
+	int			save_errno = errno;
+
+	while (nblocks > 0)
+	{
+		BlockNumber segoff = blocknum % ((BlockNumber) RELSEG_SIZE);
+		BlockNumber nblocks_this_segment;
+		MdfdVec    *v;
+
+		nblocks_this_segment = Min(nblocks,
+									RELSEG_SIZE - segoff);
+		v = _mdfd_getseg(reln, forknum, blocknum, false,
+							 EXTENSION_DONT_OPEN);
+		if (v != NULL)
+			(void) FileCacheOffer(v->mdfd_vfd,
+							  (off_t) segoff * BLCKSZ,
+							  (off_t) nblocks_this_segment * BLCKSZ,
+							  offer_class);
+
+		blocknum += nblocks_this_segment;
+		nblocks -= nblocks_this_segment;
+	}
+
+	errno = save_errno;
+}
+#endif
