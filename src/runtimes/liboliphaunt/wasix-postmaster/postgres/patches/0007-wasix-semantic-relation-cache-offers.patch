diff --git a/src/backend/storage/buffer/bufmgr.c b/src/backend/storage/buffer/bufmgr.c
index 0212cab..34be524 100644
--- a/src/backend/storage/buffer/bufmgr.c
+++ b/src/backend/storage/buffer/bufmgr.c
@@ -1623,6 +1623,35 @@ ProcessReadBuffersResult(ReadBuffersOperation *operation)
 	Assert(newly_read_blocks > 0);
 	Assert(newly_read_blocks <= MAX_IO_COMBINE_LIMIT);
 
+#ifdef __wasi__
+	/*
+	 * Offer only blocks completed by this I/O.  Buffer hits and temporary
+	 * relations never reach this seam, and the host remains free to retain
+	 * every page because this is a semantic hint, not eviction policy.
+	 */
+	if (operation->persistence != RELPERSISTENCE_TEMP)
+	{
+		SMgrCacheOfferClass offer_class;
+
+		switch (IOContextForStrategy(operation->strategy))
+		{
+			case IOCONTEXT_BULKREAD:
+				offer_class = SMGR_CACHE_OFFER_RELATION_READ_BULK;
+				break;
+			case IOCONTEXT_VACUUM:
+				offer_class = SMGR_CACHE_OFFER_RELATION_READ_VACUUM;
+				break;
+			default:
+				offer_class = SMGR_CACHE_OFFER_RELATION_READ_NORMAL;
+				break;
+		}
+
+		smgrcacheoffer(operation->smgr, operation->forknum,
+						   operation->blocknum + operation->nblocks_done,
+						   newly_read_blocks, offer_class);
+	}
+#endif
+
 	operation->nblocks_done += newly_read_blocks;
 
 	Assert(operation->nblocks_done <= operation->nblocks);
diff --git a/src/backend/storage/file/fd.c b/src/backend/storage/file/fd.c
index 378c078..4ad9805 100644
--- a/src/backend/storage/file/fd.c
+++ b/src/backend/storage/file/fd.c
@@ -2541,6 +2541,30 @@ FileGetRawDesc(File file)
 	return VfdCache[file].fd;
 }
 
+#ifdef __wasi__
+/*
+ * Offer a range from an already-open VFD to the product cache controller.
+ * This is intentionally not FileAccess(): reopening a path or perturbing the
+ * VFD LRU merely to emit a lossy hint would invert the optimization's cost.
+ * Return positive errno values and preserve the caller's errno.
+ */
+int
+FileCacheOffer(File file, off_t offset, off_t amount, uint32 offer_class)
+{
+	int			save_errno = errno;
+	int			result;
+
+	if (!FileIsValid(file) || FileIsNotOpen(file))
+		result = EBADF;
+	else
+		result = pg_wasix_cache_offer(VfdCache[file].fd, offset, amount,
+									  offer_class, 0);
+
+	errno = save_errno;
+	return result;
+}
+#endif
+
