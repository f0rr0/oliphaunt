 	RESUME_INTERRUPTS();
 }
 
+#ifdef __wasi__
+/* Pass a completed relation-I/O range to the storage manager as a hint. */
+void
+smgrcacheoffer(SMgrRelation reln, ForkNumber forknum, BlockNumber blocknum,
+				BlockNumber nblocks, SMgrCacheOfferClass offer_class)
+{
+	int			save_errno = errno;
+
+	if (nblocks > 0 && blocknum <= MaxBlockNumber &&
+		nblocks - 1 <= MaxBlockNumber - blocknum)
+		smgrsw[reln->smgr_which].smgr_cacheoffer(reln, forknum, blocknum,
+											  nblocks, offer_class);
+
+	errno = save_errno;
+}
+#endif
