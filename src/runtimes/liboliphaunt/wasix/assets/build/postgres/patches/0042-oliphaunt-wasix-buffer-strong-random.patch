From 0000000000000000000000000000000000000042 Mon Sep 17 00:00:00 2001
From: Oliphaunt Maintainers <dev@oliphaunt.dev>
Date: Mon, 17 Aug 2026 00:00:00 +0000
Subject: [PATCH] oliphaunt-wasix: buffer strong random

The embedded WASIX backend otherwise opens the virtual /dev/urandom device
for every UUID and causes one host entropy request for every 8 or 16 bytes.

Use the pinned WASIX libc getrandom interface directly and keep a small
guest-side reservoir for the explicitly single-backend build. Refill errors
and short reads remain visible through pg_strong_random's existing boolean
contract. Concurrent and non-WASIX PostgreSQL builds retain upstream behavior.
---
 src/port/pg_strong_random.c | 77 +++++++++++++++++++++++++++++++++++++
 1 file changed, 77 insertions(+)

diff --git a/src/port/pg_strong_random.c b/src/port/pg_strong_random.c
index ea6780d..c0f42f4 100644
--- a/src/port/pg_strong_random.c
+++ b/src/port/pg_strong_random.c
@@ -92,6 +92,83 @@ pg_strong_random(void *buf, size_t len)
 	return false;
 }
 
+#elif defined(__wasi__) && defined(OLIPHAUNT_WASM_SINGLE_USER)
+
+#include <sys/random.h>
+
+/*
+ * WASIX random_get crosses the guest/host boundary.  Keep a small reservoir
+ * in the single-backend guest so UUID-sized requests do not each require a
+ * host call.  The runtime forbids backend fork/thread creation, so this state
+ * cannot be duplicated by a concurrent PostgreSQL process.
+ */
+#define WASIX_STRONG_RANDOM_POOL_SIZE 4096
+
+static unsigned char wasix_strong_random_pool[WASIX_STRONG_RANDOM_POOL_SIZE];
+static size_t wasix_strong_random_used = WASIX_STRONG_RANDOM_POOL_SIZE;
+
+static bool
+wasix_strong_random_refill(void)
+{
+	size_t		filled = 0;
+
+	while (filled < sizeof(wasix_strong_random_pool))
+	{
+		ssize_t		res;
+
+		res = getrandom(wasix_strong_random_pool + filled,
+						sizeof(wasix_strong_random_pool) - filled, 0);
+		if (res < 0)
+		{
+			if (errno == EINTR)
+				continue;
+			wasix_strong_random_used = sizeof(wasix_strong_random_pool);
+			return false;
+		}
+		if (res == 0)
+		{
+			wasix_strong_random_used = sizeof(wasix_strong_random_pool);
+			return false;
+		}
+		filled += (size_t) res;
+	}
+
+	wasix_strong_random_used = 0;
+	return true;
+}
+
+void
+pg_strong_random_init(void)
+{
+	/* Discard unused bytes whenever PostgreSQL initializes the source. */
+	wasix_strong_random_used = sizeof(wasix_strong_random_pool);
+}
+
+bool
+pg_strong_random(void *buf, size_t len)
+{
+	unsigned char *p = buf;
+
+	while (len > 0)
+	{
+		size_t		available;
+		size_t		copy_len;
+
+		if (wasix_strong_random_used == sizeof(wasix_strong_random_pool) &&
+			!wasix_strong_random_refill())
+			return false;
+
+		available = sizeof(wasix_strong_random_pool) - wasix_strong_random_used;
+		copy_len = Min(len, available);
+		memcpy(p, wasix_strong_random_pool + wasix_strong_random_used, copy_len);
+		wasix_strong_random_used += copy_len;
+		p += copy_len;
+		len -= copy_len;
+	}
+
+	return true;
+}
+
 #elif WIN32
 
 #include <wincrypt.h>
-- 
