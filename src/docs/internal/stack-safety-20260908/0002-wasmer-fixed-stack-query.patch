 }
 
+/// Fixed runtime operation, not a general opt-out from host-stack isolation.
+pub(crate) struct ExecutionStackRemaining;
+
+impl HostFunction<(), (), u64, WithoutEnv> for ExecutionStackRemaining {
+    fn function_callback(&self, _backend: crate::BackendKind) -> crate::vm::VMFunctionCallback {
+        // The public constructor rejects non-Sys stores before registration.
+        self.function_callback_sys()
+    }
+
+    fn function_callback_sys(&self) -> crate::vm::VMFunctionCallback {
+        // The ignored context belongs to the normal StaticFunction allocation.
+        // Only scalar return ABI is used; the successful measurement has no
+        // store/reference conversions, locks, allocations, user callbacks, or
+        // stack switches. The cold failure path terminates the invocation.
+        unsafe extern "C" fn remaining(_context: *mut VMContext) -> u64 {
+            unsafe { wasmer_vm::checked_execution_stack_remaining() as u64 }
+        }
+        crate::vm::VMFunctionCallback::Sys(remaining as *const VMFunctionBody)
+    }
+
+    fn call_trampoline_address() -> crate::vm::VMTrampoline {
+        // Reuse Wasmer's scalar result ABI and normal host-to-Wasm trampoline.
+        crate::vm::VMTrampoline::Sys(gen_call_trampoline_address_s0_no_env::<u64>())
+    }
+}
+
 impl From<StoreHandle<VMFunction>> for Function {
     fn from(handle: StoreHandle<VMFunction>) -> Self {
         Self { handle }
