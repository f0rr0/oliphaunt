 pub struct Function(pub(crate) BackendFunction);
 
 impl Function {
+    /// Experimental Sys-only stack-budget query, with Wasm signature `() -> i64`.
+    ///
+    /// Runs a fixed, non-allocating measurement on the execution stack. No user
+    /// callback is accepted. Unsupported accounting is rejected at construction.
+    /// Missing accounting or reaching the engine hard reserve terminates the
+    /// invocation, never returns a recoverable zero. Callers must check an earlier
+    /// application-specific soft limit and leave space for their own recovery.
+    #[cfg(feature = "sys")]
+    pub fn new_execution_stack_remaining(
+        store: &mut impl AsStoreMut,
+    ) -> Result<Self, RuntimeError> {
+        if !matches!(
+            &store.as_store_mut().inner.store,
+            crate::BackendStore::Sys(_)
+        ) {
+            return Err(RuntimeError::new(
+                "execution-stack measurement requires the Sys backend",
+            ));
+        }
+        if !wasmer_vm::execution_stack_accounting_supported() {
+            return Err(RuntimeError::new(
+                "execution-stack measurement is unavailable on this platform/backend",
+            ));
+        }
+        Ok(Self::new_typed(
+            store,
+            crate::backend::sys::entities::function::ExecutionStackRemaining,
+        ))
+    }
+
