load("//build_defs/quality:sources.bzl", "rust_quality_files", "source_quality_files")
load("//build_defs/languages:rust.bzl", "cargo_binary", "cargo_integration_test", "cargo_library", "cargo_library_test", "cargo_package_env")
load("@rules_rust//rust:defs.bzl", "rust_clippy_test")
load("//build_defs/languages:source.bzl", "cargo_source_package")
load("//build_defs/languages/carriers:defs.bzl", "native_helper_carriers")
load("//build_defs/native/carriers:release-family.bzl", "native_release_checksum_family")
load("//build_defs/native:rust-runtime-test.bzl", "native_rust_runtime_test")

package(default_visibility = ["//visibility:public"])

native_release_checksum_family(product = "oliphaunt-broker")
exports_files(["Cargo.toml", "tools/broker-dependency-license-contract.mts"])
filegroup(name = "carrier_legal_sources", srcs = ["dependency-licenses.json"] + glob(["dependency-license-blobs/*.base64"]))
filegroup(name = "carrier_template_sources", srcs = glob(["packages/*/package.json", "packages/*/README.md", "crates/*/Cargo.toml", "crates/*/build.rs", "crates/*/src/lib.rs", "crates/*/README.md"]))

PATH_DEPS = {"liboliphaunt-native-bindings": "//src/native/rust-bindings:lib"}

cargo_package_env()
cargo_library(path_dependencies = PATH_DEPS)
cargo_binary(name = "broker", source = "src/main.rs", path_dependencies = PATH_DEPS, library = ":lib")
cargo_library_test()
cargo_library_test(name = "binary_test", crate = ":broker")
cargo_integration_test(
    name = "postgres_client_test",
    source = "tests/postgres_client.rs",
    path_dependencies = PATH_DEPS,
    rustc_env = {"CARGO_BIN_EXE_oliphaunt-broker": "$(rootpath :broker)"},
    data = [":broker"],
    tags = ["manual"],
)
rust_clippy_test(name = "clippy_test", targets = [":lib", ":unit_test", ":broker", ":binary_test", ":postgres_client_test"], transitive = False, size = "small")
native_rust_runtime_test(
    name = "postgres_client_runtime_test",
    binary = ":postgres_client_test",
    test_args = ["--ignored", "--test-threads=1", "--nocapture"],
    target_compatible_with = ["@platforms//os:linux", "@platforms//cpu:x86_64"],
    size = "large",
    timeout = "long",
)
cargo_source_package(product = "oliphaunt-broker", qualification = [":unit_test", ":binary_test", ":postgres_client_runtime_test", "//build_defs/languages/installed:consumer_test"])
native_helper_carriers(product = "oliphaunt-broker", binary = ":broker", qualification = ["//build_defs/languages/carriers:installed_sql_test"], path_dependencies = PATH_DEPS)

source_quality_files()

rust_quality_files()
