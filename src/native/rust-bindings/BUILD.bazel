load("//build_defs/quality:sources.bzl", "rust_quality_files")
load("//build_defs/languages:rust.bzl", "cargo_integration_test", "cargo_library", "cargo_library_test", "cargo_package_env")
load("@rules_rust//rust:defs.bzl", "rust_clippy_test")
load("//build_defs/languages:source.bzl", "cargo_source_package")
load("//build_defs/extensions:platforms.bzl", "NATIVE_EXTENSION_COMPATIBLE", "NATIVE_EXTENSION_CONFIGURATION")
load("//build_defs/release:shipping.bzl", "shipping_export", "shipping_package")
load("//build_defs/release:supplier.bzl", "shipping_suppliers")

package(default_visibility = ["//visibility:public"])
exports_files(["Cargo.toml"])

cargo_package_env()
cargo_library()
cargo_library(name = "packaging_lib", features = ["internal-native-packaging"])
cargo_library_test(data = ["//src/test-fixtures:rust_fixtures"], isolated_cache = True)
_INTEGRATION_ROOTS = glob(["tests/*.rs"])
[
    cargo_integration_test(name = source.removeprefix("tests/").removesuffix(".rs") + "_test", source = source, tags = ["manual"])
    for source in _INTEGRATION_ROOTS
]
rust_clippy_test(
    name = "clippy_test",
    targets = [":lib", ":unit_test_binary"] + [":" + source.removeprefix("tests/").removesuffix(".rs") + "_test" for source in _INTEGRATION_ROOTS],
    transitive = False,
    size = "small",
)
cargo_source_package(product = "liboliphaunt-native-bindings", fixtures = "testdata/", qualification = ["//build_defs/languages/installed:consumer_test"])

# This is the existing compiler output incorporated by desktop helpers, not a public carrier.
shipping_suppliers(name = "compiled_suppliers", inputs = [])
shipping_package(
    name = "compiled_shipping",
    owner = "@oliphaunt_metadata//:product_liboliphaunt-native-bindings",
    artifacts = [":lib"],
    ecosystem = "internal",
    package_name = "liboliphaunt-native-bindings",
    configuration = NATIVE_EXTENSION_CONFIGURATION,
    role = "compiled-source",
    suppliers = ":compiled_suppliers",
    target_compatible_with = NATIVE_EXTENSION_COMPATIBLE,
)
shipping_export(
    name = "compiled_shipping_export",
    packages = [":compiled_shipping"],
    qualification = [":unit_test"],
    testonly = True,
    target_compatible_with = NATIVE_EXTENSION_COMPATIBLE,
)

rust_quality_files()
