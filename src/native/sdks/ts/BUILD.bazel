load("//build_defs/quality:sources.bzl", "source_quality_files")
load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@aspect_rules_ts//ts:defs.bzl", "ts_config", "ts_project")
load("@oliphaunt_javascript_metadata//:metadata.bzl", "JAVASCRIPT")
load("@oliphaunt_metadata//:metadata.bzl", "PUBLICATION_CARRIERS")
load("@javascript_packages//:defs.bzl", "PACKAGES", "javascript_type_links")
load("@javascript_compiler_packages//:defs.bzl", "compiler_input_links")
load("@javascript_compiler_packages//:roots.bzl", "COMPILER_INPUTS")
load("//build_defs/extensions:sdk_projections.bzl", "sdk_extension_projections")
load("//build_defs/languages/ts:defs.bzl", "workspace_dependency_package", "workspace_dependency_link", "source_sdk_consumer_test", "source_sdk_publish_files")
load("//build_defs/languages/ts:unit-tests.bzl", "sdk_unit_test")
load("//build_defs/query:defs.bzl", "query_envelope")
load("//build_defs/release:shipping.bzl", "shipping_export", "shipping_package")

package(default_visibility = ["//visibility:public"])

exports_files(["package.json", "release.toml"])
exports_files(["src/native/extension-contract.ts"])

SDK = JAVASCRIPT["@oliphaunt/ts"]
QUERY = JAVASCRIPT["@oliphaunt/ts-query"]

SDK_SRCS = glob(["src/**/*.ts"], exclude = ["src/__tests__/**", "src/extensions.ts", "src/generated/extensions.ts"])

filegroup(name = "native_asset_sources", srcs = SDK_SRCS + [":extension_projections", "package.json"])

javascript_type_links(SDK["types"])
compiler_input_links(COMPILER_INPUTS[SDK["name"]])

workspace_dependency_package(name = "query_package", workspace = SDK, dependency = QUERY["name"], current = "//src/query/ts:shipping_package")

workspace_dependency_link(name = "node_modules/@oliphaunt/ts-query", package = ":query_package", workspace = SDK, dependency = QUERY["name"])

js_library(name = "package_metadata", srcs = ["package.json"])
ts_config(name = "source_config", src = "tsconfig.json")

js_library(
    name = "source_inputs",
    types = SDK_SRCS + [":extension_projections"],
    deps = [":package_metadata"] + [":node_modules/" + name for name in SDK["types"]],
)

sdk_extension_projections(name = "extension_projections", sdk = "ts")

ts_project(
    name = "module",
    srcs = SDK_SRCS + [":extension_projections"],
    tsconfig = "tsconfig.build.json",
    extends = "tsconfig.json",
    declaration = True,
    declaration_map = True,
    out_dir = "lib",
    root_dir = "src",
    transpiler = "tsc",
    supports_workers = 0,
    deps = [":package_metadata", ":node_modules/@oliphaunt/ts-query"] + [":node_modules/" + name for name in SDK["types"]],
)

source_sdk_publish_files(name = "publish_files", manifest = "package.json")

# The build configuration excludes tests; use the conventional source configuration
# for this independently requested typecheck, without constructing native packages.
ts_project(
    name = "source_checks",
    srcs = SDK_SRCS + glob(["src/__tests__/**/*.ts"]) + [":extension_projections"],
    tsconfig = "tsconfig.json",
    no_emit = True,
    declaration = True,
    declaration_map = True,
    out_dir = "lib",
    root_dir = "src",
    supports_workers = 0,
    deps = [":package_metadata", ":node_modules/@oliphaunt/ts-query"] + [":node_modules/" + name for name in SDK["types"]] + [":node_modules/" + name for name in COMPILER_INPUTS[SDK["name"]]],
)

filegroup(name = "publish_manifest", srcs = [":publish_files"], output_group = "manifest")
filegroup(name = "license", srcs = [":publish_files"], output_group = "license")
filegroup(name = "notices", srcs = [":publish_files"], output_group = "notices")

query_envelope(
    name = "npm",
    format = "npm",
    manifest = ":publish_manifest",
    entries = {file: file for file in SDK_SRCS} | {
        ":module": "lib/",
        ":extension_projections": "src/",
        ":publish_manifest": "package.json",
        ":license": "LICENSE",
        ":notices": "THIRD_PARTY_NOTICES.md",
        "README.md": "README.md",
        "ARCHITECTURE.md": "ARCHITECTURE.md",
        "CHANGELOG.md": "CHANGELOG.md",
    },
    out = "oliphaunt-ts.tgz",
)

shipping_package(
    name = "shipping_package",
    owner = "@oliphaunt_metadata//:product_oliphaunt-js",
    artifacts = [":npm"],
    ecosystem = "npm",
    package_name = SDK["name"],
    configuration = "portable",
    role = [carrier["role"] for carrier in PUBLICATION_CARRIERS if carrier["product"] == "oliphaunt-js" and carrier["ecosystem"] == "npm" and carrier["name"] == SDK["name"]][0],
)

shipping_export(name = "shipping_export", packages = [":shipping_package"], qualification = [":consumer_test", "//build_defs/languages/carriers:installed_sql_test", ":unit_test", ":package_policy_test"], testonly = True)

source_sdk_consumer_test(
    name = "consumer_test",
    size = "small",
    archive = ":npm",
    query = ":query_package",
    consumer = "tools/entrypoint-consumer.mts",
    type_packages = {"@javascript_packages//:" + key: key for key in PACKAGES},
    types = SDK["types"],
)

sdk_unit_test(
    name = "unit_test",
    manifest = "package.json",
    sources = glob(["src/**/*.ts"], exclude = ["src/extensions.ts", "src/generated/extensions.ts"]) + glob(["src/**/*.mts", "src/**/*.json"], allow_empty = True) + [":extension_projections"],
    fixtures = ["//src/test-fixtures:rust_fixtures"],
    packages = {":query_package": QUERY["name"]},
    package_manifests = ["//src/native/runtime:packages/" + target + "/package.json" for target in ["linux-x64-gnu", "linux-arm64-gnu", "darwin-arm64", "win32-x64-msvc"]],
    size = "small",
)

source_quality_files()

