load("//build_defs/quality:sources.bzl", "rust_quality_files")
load("//build_defs/languages:rust.bzl", "cargo_doc_test", "cargo_library", "cargo_library_test", "cargo_package_env")
load("@rules_rust//rust:defs.bzl", "rust_clippy_test")
load("//build_defs/languages:source.bzl", "cargo_source_package")

package(default_visibility = ["//visibility:public"])
exports_files(["Cargo.toml"])

cargo_package_env()
cargo_library()
cargo_library_test()
cargo_doc_test(size = "small")
rust_clippy_test(name = "clippy_test", targets = [":lib", ":unit_test"], transitive = False, size = "small")
cargo_source_package(product = "oliphaunt-rust")

rust_quality_files()
