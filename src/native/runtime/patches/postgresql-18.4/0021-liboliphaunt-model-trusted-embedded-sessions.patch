+	bool		trusted_client = (flags & INIT_PG_TRUSTED_CLIENT) != 0;
+#endif
 	char	   *fullpath;
 	char		dbname[NAMEDATALEN];
 	int			nfree = 0;
@@ -855,19 +861,44 @@ InitPostgres(const char *in_dbname, Oid dboid,
 		XactIsoLevel = XACT_READ_COMMITTED;
 	}
 
+#ifdef OLIPHAUNT_EMBEDDED
+	if (trusted_client)
+	{
+		if (bootstrap || IsPostmasterEnvironment || IsUnderPostmaster ||
+			!AmRegularBackendProcess() || MyProcPort == NULL)
+			ereport(FATAL,
+					(errcode(ERRCODE_OBJECT_NOT_IN_PREREQUISITE_STATE),
