+fn clone_registered<T>(
+    registry: &RefCell<HashMap<u64, Rc<RefCell<T>>>>,
+    id: u64,
+) -> Option<Rc<RefCell<T>>> {
+    registry.borrow().get(&id).cloned()
+}
+
+fn remove_registered<T>(
+    registry: &RefCell<HashMap<u64, Rc<RefCell<T>>>>,
+    id: u64,
+) -> Option<Rc<RefCell<T>>> {
+    registry.borrow_mut().remove(&id)
+}
