+static MONOTONIC_EPOCH: Lazy<Instant> = Lazy::new(Instant::now);
+
+fn monotonic_time_ns() -> Result<i64, Errno> {
+    i64::try_from(MONOTONIC_EPOCH.elapsed().as_nanos()).map_err(|_| Errno::Overflow)
+}
