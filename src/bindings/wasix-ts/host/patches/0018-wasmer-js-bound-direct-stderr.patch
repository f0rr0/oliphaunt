index d56c81d..d2f8d00 100644
--- a/src/options.rs
+++ b/src/options.rs
@@ -189,12 +189,13 @@ impl RunOptions {
     pub(crate) fn configure_direct_builder(
         &self,
         builder: &mut WasiEnvBuilder,
+        stderr: Box<dyn virtual_fs::VirtualFile + Send + Sync + 'static>,
     ) -> Result<(), Error> {
         self.configure_common_builder(builder)?;
 
         builder.set_stdin(Box::<virtual_fs::null_file::NullFile>::default());
         builder.set_stdout(Box::<virtual_fs::null_file::NullFile>::default());
-        builder.set_stderr(Box::<virtual_fs::null_file::NullFile>::default());
+        builder.set_stderr(stderr);
 
