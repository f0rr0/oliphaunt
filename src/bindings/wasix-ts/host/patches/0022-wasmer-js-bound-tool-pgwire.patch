+#[derive(Debug)]
+struct BoundedDirection {
+    buffer: VecDeque<u8>,
+    writer_closed: bool,
+    reader_closed: bool,
+    reader_waker: Option<Waker>,
+    writer_waker: Option<Waker>,
+}
+
+impl BoundedDirection {
+    fn new() -> Self {
+        Self {
+            buffer: VecDeque::with_capacity(TOOL_PROTOCOL_CAPACITY_BYTES),
+            writer_closed: false,
+            reader_closed: false,
+            reader_waker: None,
+            writer_waker: None,
+        }
+    }
+}
+
+#[derive(Clone, Debug)]
+struct BoundedWriter {
+    direction: Arc<Mutex<BoundedDirection>>,
+}
+
+impl BoundedWriter {
+    fn close(&mut self) {
+        let waker = if let Ok(mut direction) = self.direction.lock() {
+            direction.writer_closed = true;
+            direction.reader_waker.take()
+        } else {
+            None
+        };
+        if let Some(waker) = waker {
+            waker.wake();
+        }
+    }
+}
+
+impl AsyncWrite for BoundedWriter {
+    fn poll_write(
+        self: Pin<&mut Self>,
+        cx: &mut TaskContext<'_>,
+        input: &[u8],
+    ) -> Poll<io::Result<usize>> {
+        if input.is_empty() {
+            return Poll::Ready(Ok(0));
+        }
+        let mut direction = self
+            .direction
+            .lock()
+            .map_err(|_| io::Error::other("bounded pipe lock poisoned"))?;
+        if direction.reader_closed || direction.writer_closed {
+            return Poll::Ready(Err(io::ErrorKind::BrokenPipe.into()));
+        }
+        let available = TOOL_PROTOCOL_CAPACITY_BYTES - direction.buffer.len();
+        if available == 0 {
+            direction.writer_waker = Some(cx.waker().clone());
+            return Poll::Pending;
+        }
+        let count = available.min(input.len()).min(TOOL_PROTOCOL_CHUNK_BYTES);
+        direction.buffer.extend(&input[..count]);
+        let waker = direction.reader_waker.take();
+        drop(direction);
+        if let Some(waker) = waker {
+            waker.wake();
+        }
+        Poll::Ready(Ok(count))
+    }
+
+    fn poll_flush(self: Pin<&mut Self>, _cx: &mut TaskContext<'_>) -> Poll<io::Result<()>> {
+        Poll::Ready(Ok(()))
+    }
+
+    fn poll_shutdown(mut self: Pin<&mut Self>, _cx: &mut TaskContext<'_>) -> Poll<io::Result<()>> {
+        self.close();
+        Poll::Ready(Ok(()))
+    }
+}
+
+#[derive(Clone, Debug)]
+struct BoundedReader {
+    direction: Arc<Mutex<BoundedDirection>>,
+}
+
+impl BoundedReader {
+    fn close(&mut self) {
+        let waker = if let Ok(mut direction) = self.direction.lock() {
+            direction.reader_closed = true;
+            direction.buffer.clear();
+            direction.writer_waker.take()
+        } else {
+            None
+        };
+        if let Some(waker) = waker {
+            waker.wake();
+        }
+    }
+
+    fn poll_ready(&mut self, cx: &mut TaskContext<'_>) -> Poll<io::Result<usize>> {
+        let mut direction = self
+            .direction
+            .lock()
+            .map_err(|_| io::Error::other("bounded pipe lock poisoned"))?;
+        if direction.reader_closed {
+            return Poll::Ready(Err(io::ErrorKind::BrokenPipe.into()));
+        }
+        if !direction.buffer.is_empty() {
+            return Poll::Ready(Ok(direction.buffer.len().min(TOOL_PROTOCOL_CHUNK_BYTES)));
+        }
+        if direction.writer_closed {
+            return Poll::Ready(Ok(0));
+        }
+        direction.reader_waker = Some(cx.waker().clone());
+        Poll::Pending
+    }
+}
+
+impl AsyncRead for BoundedReader {
+    fn poll_read(
+        self: Pin<&mut Self>,
+        cx: &mut TaskContext<'_>,
+        output: &mut ReadBuf<'_>,
+    ) -> Poll<io::Result<()>> {
+        if output.remaining() == 0 {
+            return Poll::Ready(Ok(()));
+        }
+        let mut direction = self
+            .direction
+            .lock()
+            .map_err(|_| io::Error::other("bounded pipe lock poisoned"))?;
+        if direction.reader_closed {
+            return Poll::Ready(Err(io::ErrorKind::BrokenPipe.into()));
+        }
+        if direction.buffer.is_empty() {
+            if direction.writer_closed {
+                return Poll::Ready(Ok(()));
+            }
+            direction.reader_waker = Some(cx.waker().clone());
+            return Poll::Pending;
+        }
+        let count = output
+            .remaining()
+            .min(direction.buffer.len())
+            .min(TOOL_PROTOCOL_CHUNK_BYTES);
+        let (first, second) = direction.buffer.as_slices();
+        let first_count = first.len().min(count);
+        output.put_slice(&first[..first_count]);
+        if first_count < count {
+            output.put_slice(&second[..count - first_count]);
+        }
+        direction.buffer.drain(..count);
+        let waker = direction.writer_waker.take();
+        drop(direction);
+        if let Some(waker) = waker {
+            waker.wake();
+        }
+        Poll::Ready(Ok(()))
+    }
+}
