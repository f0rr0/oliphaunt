+#[derive(Debug)]
+pub(crate) struct BoundedDuplexFile {
+    reader: BoundedReader,
+    writer: BoundedWriter,
+}
+
+impl BoundedDuplexFile {
+    fn channel() -> (Self, BoundedWriter, BoundedReader) {
+        let to_guest = Arc::new(Mutex::new(BoundedDirection::new()));
+        let from_guest = Arc::new(Mutex::new(BoundedDirection::new()));
+        (
+            Self {
+                reader: BoundedReader {
+                    direction: Arc::clone(&to_guest),
+                },
+                writer: BoundedWriter {
+                    direction: Arc::clone(&from_guest),
+                },
+            },
+            BoundedWriter {
+                direction: to_guest,
+            },
+            BoundedReader {
+                direction: from_guest,
+            },
+        )
+    }
+}
+
+impl Drop for BoundedDuplexFile {
+    fn drop(&mut self) {
+        self.reader.close();
+        self.writer.close();
+    }
+}
+
+impl AsyncRead for BoundedDuplexFile {
+    fn poll_read(
+        mut self: Pin<&mut Self>,
+        cx: &mut TaskContext<'_>,
+        output: &mut ReadBuf<'_>,
+    ) -> Poll<io::Result<()>> {
+        Pin::new(&mut self.reader).poll_read(cx, output)
+    }
+}
+
+impl AsyncWrite for BoundedDuplexFile {
+    fn poll_write(
+        mut self: Pin<&mut Self>,
+        cx: &mut TaskContext<'_>,
+        input: &[u8],
+    ) -> Poll<io::Result<usize>> {
+        Pin::new(&mut self.writer).poll_write(cx, input)
+    }
+
+    fn poll_flush(mut self: Pin<&mut Self>, cx: &mut TaskContext<'_>) -> Poll<io::Result<()>> {
+        Pin::new(&mut self.writer).poll_flush(cx)
+    }
+
+    fn poll_shutdown(mut self: Pin<&mut Self>, cx: &mut TaskContext<'_>) -> Poll<io::Result<()>> {
+        Pin::new(&mut self.writer).poll_shutdown(cx)
+    }
+}
+
+impl AsyncSeek for BoundedDuplexFile {
+    fn start_seek(self: Pin<&mut Self>, _position: SeekFrom) -> io::Result<()> {
+        Ok(())
+    }
+
+    fn poll_complete(self: Pin<&mut Self>, _cx: &mut TaskContext<'_>) -> Poll<io::Result<u64>> {
+        Poll::Ready(Ok(0))
+    }
+}
