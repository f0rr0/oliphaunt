{
  "globs": [
    "README.md",
    "src/docs/**/*.md",
    "src/**/README.md",
    "src/examples/native/react-native-expo/README.md",
    "src/examples/wasix/tauri/README.md"
  ],
  "ignores": ["target/**", "**/node_modules/**", "src/wasix/runtime/assets/build/**"],
  "config": {
    "default": true,
    "MD013": false,
    "MD024": {
      "siblings_only": true
    },
    "MD033": false,
    "MD041": false
  }
}
