+/// Whether this backend can measure the actual native stack pointer.
+/// Capability is not a claim of platform qualification. No shadow/fake-stack
+/// local-variable address is used, including under address sanitizers.
+pub const fn execution_stack_accounting_supported() -> bool {
+    cfg!(all(
+        unix,
+        any(target_arch = "x86_64", target_arch = "aarch64")
+    ))
+}
+
+/// Whether the caller is executing on a Wasm coroutine rather than a host stack.
+#[inline]
+pub fn is_on_wasm_stack() -> bool {
+    YIELDER.with(|cell| cell.get().is_some())
+}
+
+/// Samples free native execution-stack bytes on the active Wasm stack only.
+///
+/// Ordinary host callbacks return `None`; there is deliberately no suspended
+/// snapshot or extra bookkeeping on host transitions. Nested Wasm entries
+/// measure their own stack. Guard pages and excess pooled capacity are excluded.
+/// This is a sample, not a reservation or a linear-memory stack measurement.
+#[inline]
+pub fn remaining_execution_stack() -> Option<usize> {
+    if !execution_stack_accounting_supported() {
+        return None;
+    }
+    let stack = EXECUTION_STACK.with(Cell::get)?;
+    let sp: usize;
+    #[cfg(target_arch = "x86_64")]
+    unsafe {
+        core::arch::asm!("mov {}, rsp", out(reg) sp, options(nomem, nostack, preserves_flags));
+    }
+    #[cfg(target_arch = "aarch64")]
+    unsafe {
+        core::arch::asm!("mov {}, sp", out(reg) sp, options(nomem, nostack, preserves_flags));
+    }
+    #[cfg(not(any(target_arch = "x86_64", target_arch = "aarch64")))]
+    {
+        sp = 0;
+    }
+    stack.remaining(sp)
+}
+
+/// Returns a known sample above the engine's hard reserve, or terminates the
+/// current invocation. Never turns missing accounting into a recoverable zero.
+///
+/// # Safety
+/// Must run on the active Wasm coroutine, with no live Rust destructors between
+/// the caller and the trap boundary. Failure performs a non-local exit.
+#[inline]
+pub unsafe fn checked_execution_stack_remaining() -> usize {
+    match remaining_execution_stack() {
+        Some(remaining) if remaining > super::EXECUTION_STACK_HARD_RESERVE => remaining,
+        remaining => unsafe { execution_stack_fault(remaining.is_none()) },
+    }
+}
+
+#[cold]
+#[inline(never)]
+unsafe fn execution_stack_fault(unavailable: bool) -> ! {
+    if unavailable {
+        // A zero-sized payload allocates no heap memory and captures no trace.
+        unsafe { raise_user_trap(Box::new(super::ExecutionStackUnavailable)) }
+    }
+    // Trace capture and allocation belong on the unconstrained parent stack,
+    // not the nearly exhausted guest stack. Raise only after switching back.
+    let trap = on_host_stack(|| Trap::lib(TrapCode::StackOverflow));
+    unsafe { raise_lib_trap(trap) }
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+struct ExecutionStack {
+    lower: usize,
+    upper: usize,
+}
+
+impl ExecutionStack {
+    fn remaining(self, address: usize) -> Option<usize> {
+        (self.lower..self.upper)
+            .contains(&address)
+            .then(|| address - self.lower)
+    }
+}
