# The conventional browser config maps SDK source outside its package. Keeping
# this stock TypeScript action at the repository root preserves that rootDir.
ts_project(
    name = "browser_example_source_checks",
    srcs = ["//src/examples/wasix/browser:source_files"],
    tsconfig = {"compilerOptions": {
        "rootDir": ".",
        "outDir": ".",
        "typeRoots": [
            "src/examples/wasix/browser/node_modules/@types",
            "src/examples/wasix/browser/node_modules",
        ],
    }},
    extends = "//src/examples/wasix/browser:source_config",
    no_emit = True,
    declaration = True,
    supports_workers = 0,
    deps = ["//src/examples/wasix/browser:source_inputs"],
)

