    patch_strip = 1,
)
single_version_override(
    module_name = "rules_cc_autoconf",
    version = "0.24.0",
    patches = ["//build_defs/native:patches/rules-cc-autoconf-native-process.patch"],
    patch_strip = 1,
)
single_version_override(
    module_name = "rules_android",
    version = "0.6.6",
    patches = ["//build_defs/languages/jvm:aar-import-android-bootclasspath.patch"],
    patch_strip = 1,
)
