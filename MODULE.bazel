# Keep maintained resource/framework/signing implementations; declare licensed
# app-tool bytes in their ordinary tool runfiles.
single_version_override(
    module_name = "rules_apple",
    version = "5.2.0",
    patches = ["//build_defs/apple:declared-app-tools.patch"],
    patch_strip = 1,
)

bazel_dep(name = "rules_swift", version = "4.2.1")
