    name = "native_cargo_metadata",
    roots = [],
)

cargo_crates = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
# Short physical Cargo hub names keep MSVC's relative includes below MAX_PATH;
# use_repo aliases preserve descriptive labels for the configured contexts.
cargo_crates.from_cargo(
    name = "n",
    host_tools = "@rust_host_tools//:BUILD.bazel",
    cargo_lockfile = "@native_cargo_metadata//:Cargo.lock",
    manifests = ["@native_cargo_metadata//:Cargo.toml"],
    skip_cargo_lockfile_overwrite = True,
    supported_platform_triples = [
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu",
        "aarch64-apple-darwin",
        "x86_64-pc-windows-msvc",
        "aarch64-apple-ios",
        "aarch64-apple-ios-sim",
        "aarch64-linux-android",
        "x86_64-linux-android",
    ],
)
use_repo(cargo_crates, cargo_crates = "n")

node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(node_version_from_nvmrc = "@oliphaunt_toolchain_metadata//:node-version")
use_repo(node, "nodejs_toolchains")
register_toolchains("@nodejs_toolchains//:all")

typescript = use_extension("@aspect_rules_ts//ts:extensions.bzl", "typescript")
